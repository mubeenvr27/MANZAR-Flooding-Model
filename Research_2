──────────────────────────────────────────\n# CONFIGURATION\n# ─────────────────────────────────────────────────────────────────────\nVARIANTS_TO_RUN = [\"full\"]   # Run one at a time to save memory\n\n# IMPORTANT: Set which fold to start from (1-indexed)\nSTART_FOLD = 2  # Change this to skip folds (e.g., 2, 3, 4, or 5)\n\nMANIFEST_PATH = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR = \"./data/ml_dataset/features\"\nMASKS_DIR = \"./data/ml_dataset/masks\"\nLOG_DIR = \"./logs_cv\"\nBEST_WEIGHTS_ROOT = \"./cv_best_flood_model_{variant}_fold{fold}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\n\nCV_FOLDS = 5\nCV_SEED = 42\nSEED = 42\nEPOCHS = 150\nBATCH_SIZE = 4          # Reduced from 8 to fit in GPU memory\nACCUM_STEPS = 8         # Increased to maintain effective batch size (4 * 8 = 32)\nNUM_WORKERS = 2\nWEIGHT_DECAY = 1e-3\nETA_MIN = 1e-6\nPATIENCE = 20\nVAL_SMOOTHING = 0.3\nLR = 2e-4\n\nALPHA_BCE = 0.3\nFT_GAMMA = 4 / 3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\nOPT_DROP_START, OPT_DROP_END, OPT_DROP_RAMP = 0.25, 0.05, 60\nTHRESH_SWEEP = [0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70]\nIGNORE_INDEX = -1\n\nVARIANT_LOSS = {\n    \"full\": dict(ft_alpha=0.3, ft_beta=0.7),\n    \"symmetric_loss\": dict(ft_alpha=0.5, ft_beta=0.5),\n}\n\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(level=logging.INFO, format=\"%(asctime)s | %(levelname)s | %(message)s\",\n                     handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"cv.log\")),\n                               logging.StreamHandler()])\nlog = logging.getLogger(\"cv\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_kfold_splits(manifest_path, n_folds, seed, start_fold=1):\n    \"\"\"Create folds but only return those from start_fold onwards\"\"\"\n    df = pd.read_csv(manifest_path)\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    cv_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    log.info(f\"CV pool: {len(cv_df)} official-train patches (Bolivia excluded), {n_folds}-fold\")\n    log.info(f\"Starting from fold {start_fold}\")\n    \n    kf = KFold(n_splits=n_folds, shuffle=True, random_state=seed)\n    all_folds = []\n    for i, (tr, vl) in enumerate(kf.split(cv_df)):\n        fold_num = i + 1\n        if fold_num >= start_fold:  # Only keep folds from start_fold onwards\n            all_folds.append((\n                cv_df.iloc[tr].reset_index(drop=True), \n                cv_df.iloc[vl].reset_index(drop=True), \n                fold_num\n            ))\n    \n    if len(all_folds) == 0:\n        raise ValueError(f\"No folds to run. START_FOLD={start_fold} is greater than CV_FOLDS={n_folds}\")\n    \n    log.info(f\"Will run folds: {[f[2] for f in all_folds]}\")\n    return all_folds\n\n\nclass FloodDataset(Dataset):\n    def __init__(self, df, fd, md, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, fd, md\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, bs, nw, drop):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=drop)\n    return DataLoader(d, batch_size=bs, sampler=s, num_workers=nw, pin_memory=True,\n                       drop_last=True, persistent_workers=False)\n\n\ndef build_val_loader(df, nw):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=nw, pin_memory=True,\n                       persistent_workers=False)\n\n\ndef opt_drop(epoch, variant):\n    if variant in (\"no_opt_dropout\", \"no_optical\"):\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", \n            encoder_weights=\"imagenet\", \n            in_channels=3, \n            classes=32,\n            encoder_depth=5)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", \n            encoder_weights=\"imagenet\", \n            in_channels=7, \n            classes=32,\n            encoder_depth=5)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re, \n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e)}\n\n\ndef train_epoch(model, loader, crit, opt, scaler, device):\n    model.train()\n    rl = 0.0\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n    return rl / len(loader)\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, device):\n    model.eval()\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y)\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bm = 0.0, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics()\n        m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bm = cm[\"f1\"], cm\n    return bm\n\n\ndef train_one_fold(train_df, val_df, variant, fold):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    best_path = BEST_WEIGHTS_ROOT.format(variant=variant, fold=fold)\n    \n    # Clear memory before creating model\n    torch.cuda.empty_cache()\n    gc.collect()\n    \n    # Single GPU model with memory optimization\n    model = DualStreamUNetPP(use_cbam=True).to(device)\n    \n    # Count parameters\n    total_params = sum(p.numel() for p in model.parameters())\n    log.info(f\"  [{variant} fold{fold}] Model parameters: {total_params:,}\")\n    log.info(f\"  [{variant} fold{fold}] Single GPU mode (batch={BATCH_SIZE}, accum={ACCUM_STEPS})\")\n    \n    opt = optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = HybridLoss(ALPHA_BCE, **VARIANT_LOSS[variant], ft_gamma=FT_GAMMA)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    bv, en, sv = 0.0, 0, 0.0\n    pd_prev, tl = None, None\n    \n    for epoch in range(EPOCHS):\n        drop = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, BATCH_SIZE, NUM_WORKERS, drop)\n            pd_prev = drop\n        \n        train_loss = train_epoch(model, tl, crit, opt, scaler, device)\n        vm = val_epoch(model, val_loader, device)\n        sched.step()\n        \n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        \n        log.info(f\"  [{variant} fold{fold}] Ep{epoch+1:>3} TL={train_loss:.4f} VIoU={vi:.4f} Sm={sv:.4f}\")\n        \n        if sv > bv:\n            bv, en = sv, 0\n            torch.save(model.state_dict(), best_path)\n            log.info(f\"  [{variant} fold{fold}] >> Best Sm={bv:.4f} saved\")\n        else:\n            en += 1\n            \n        if en >= PATIENCE:\n            log.info(f\"  [{variant} fold{fold}] Early stop at epoch {epoch+1}\")\n            break\n        \n        # Clear memory periodically\n        if epoch % 10 == 0:\n            torch.cuda.empty_cache()\n    \n    del model\n    torch.cuda.empty_cache()\n    gc.collect()\n    return bv\n\n\ndef main():\n    set_seed(SEED)\n    \n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    num_gpus = torch.cuda.device_count()\n    \n    # Print GPU memory info\n    if torch.cuda.is_available():\n        for i in range(num_gpus):\n            mem_allocated = torch.cuda.memory_allocated(i) / 1024**3\n            mem_reserved = torch.cuda.memory_reserved(i) / 1024**3\n            mem_total = torch.cuda.get_device_properties(i).total_memory / 1024**3\n            log.info(f\"  GPU {i} memory: {mem_allocated:.2f}GB allocated, {mem_reserved:.2f}GB reserved, {mem_total:.2f}GB total\")\n    \n    log.info(\"=\" * 70)\n    log.info(\"CROSS-VALIDATION TRAINING (Memory Optimized - Single GPU)\")\n    log.info(\"=\" * 70)\n    log.info(f\"  Device: {device}\")\n    log.info(f\"  Available GPUs: {num_gpus}\")\n    log.info(f\"  Batch size: {BATCH_SIZE}\")\n    log.info(f\"  Accumulation steps: {ACCUM_STEPS}\")\n    log.info(f\"  Effective batch size: {BATCH_SIZE * ACCUM_STEPS}\")\n    log.info(f\"  Starting from fold: {START_FOLD}\")\n    log.info(\"=\" * 70)\n    \n    # Create folds, starting from START_FOLD\n    folds = make_kfold_splits(MANIFEST_PATH, CV_FOLDS, CV_SEED, START_FOLD)\n    results = {}\n    \n    for variant in VARIANTS_TO_RUN:\n        log.info(f\"\\n{'='*62}\")\n        log.info(f\"  STARTING {variant} CROSS-VALIDATION (folds {START_FOLD}-{CV_FOLDS})\")\n        log.info(f\"{'='*62}\")\n        \n        ious = []\n        fold_numbers = []\n        \n        for train_df, val_df, fold_i in folds:\n            log.info(f\"\\n{'-'*50}\")\n            log.info(f\"  {variant} FOLD {fold_i}/{CV_FOLDS}\")\n            log.info(f\"  Train: {len(train_df)} patches, Val: {len(val_df)} patches\")\n            log.info(f\"{'-'*50}\")\n            \n            iou = train_one_fold(train_df, val_df, variant, fold_i)\n            ious.append(iou)\n            fold_numbers.append(fold_i)\n            log.info(f\"  ✅ FOLD {fold_i} COMPLETE: Smoothed IoU = {iou:.4f}\")\n            \n            # Clear memory between folds\n            torch.cuda.empty_cache()\n            gc.collect()\n        \n        # Calculate statistics for completed folds\n        if ious:\n            mean, std = float(np.mean(ious)), float(np.std(ious))\n            log.info(f\"\\n{'='*62}\")\n            log.info(f\"  {variant} CV RESULTS (Folds {fold_numbers})\")\n            log.info(f\"  Mean Smoothed IoU: {mean:.4f} +/- {std:.4f}\")\n            log.info(f\"  Per-fold results: {dict(zip(fold_numbers, [round(x, 4) for x in ious]))}\")\n            log.info(f\"{'='*62}\")\n            \n            results[variant] = {\n                \"folds_completed\": fold_numbers,\n                \"folds\": [round(x, 4) for x in ious],\n                \"mean\": round(mean, 4),\n                \"std\": round(std, 4),\n                \"n_folds\": len(ious)\n       