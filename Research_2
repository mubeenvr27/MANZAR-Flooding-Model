1,423 | INFO |   [symmetric_loss fold5] Early stop at epoch 120\n2026-09-09 18:13:22,027 | INFO |   ✅ FOLD 5 COMPLETE: Smoothed IoU = 0.7859\n2026-09-09 18:13:22,281 | INFO | \n==============================================================\n2026-09-09 18:13:22,282 | INFO |   symmetric_loss CV RESULTS (Folds [2, 3, 4, 5])\n2026-09-09 18:13:22,283 | INFO |   Mean Smoothed IoU: 0.8006 +/- 0.0509\n2026-09-09 18:13:22,284 | INFO |   Per-fold results: {2: 0.8646, 3: 0.7267, 4: 0.8251, 5: 0.7859}\n2026-09-09 18:13:22,285 | INFO | ==============================================================\n2026-09-09 18:13:22,286 | INFO |   Results saved to: ./logs_cv/cv_symmetric_loss_fold2to5.json\n2026-09-09 18:13:22,287 | INFO | \n✅ Partial cross-validation complete!\n","output_type":"stream"},{"name":"stdout","text":"\n======================================================================\nCROSS-VALIDATION SUMMARY\n======================================================================\n(Folds 2-5 completed)\n======================================================================\nVariant              Mean IoU     Std Dev      Folds\n----------------------------------------------------------------------\nsymmetric_loss       0.8006       0.0509       F2=0.8646, F3=0.7267, F4=0.8251, F5=0.7859\n======================================================================\n\n⚠️  symmetric_loss: Only 4/5 folds completed.\n   Remaining folds: []\n   To continue, set START_FOLD = 6\n","output_type":"stream"}],"execution_count":2},{"cell_type":"markdown","source":"# compute cost report","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# SINGLE CELL — self-contained, no external imports, no checkpoints\n# needed (params/FLOPs/latency depend only on architecture, not trained\n# weights). Covers the variants likely to appear in the final Table I.\n\nimport time\nimport torch\nimport torch.nn as nn\nimport segmentation_models_pytorch as smp\n\nDEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nINPUT_SHAPE = (1, 10, 512, 512)\n\n\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        sar_feat = self.sar_encoder(sar)\n        if self.zero_optical:\n            opt_feat = torch.zeros_like(sar_feat)\n        else:\n            opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n            opt_feat = self.opt_encoder(opt)\n        f = torch.cat([sar_feat, opt_feat], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nMODELS_TO_REPORT = {\n    \"full\": lambda: DualStreamUNetPP(use_cbam=True),\n    \"symmetric_loss\": lambda: DualStreamUNetPP(use_cbam=True),  # same arch as full\n    \"no_opt_dropout\": lambda: DualStreamUNetPP(use_cbam=True),  # same arch as full\n    \"no_cbam\": lambda: DualStreamUNetPP(use_cbam=False),\n    \"no_optical\": lambda: DualStreamUNetPP(use_cbam=True, zero_optical=True),\n    \"single_stream_sar\": lambda: SingleStreamSAR(),\n}\n\n\ndef count_params(model):\n    return sum(p.numel() for p in model.parameters())\n\n\n@torch.no_grad()\ndef measure_flops(model, input_shape=INPUT_SHAPE, device=DEVICE):\n    from torch.profiler import profile, ProfilerActivity\n    model = model.to(device).eval()\n    x = torch.randn(*input_shape, device=device)\n    activities = [ProfilerActivity.CPU]\n    if device == \"cuda\":\n        activities.append(ProfilerActivity.CUDA)\n    with profile(activities=activities, with_flops=True) as prof:\n        model(x)\n    total_flops = sum(evt.flops for evt in prof.key_averages() if evt.flops is not None)\n    return total_flops / 1e9  # GFLOPs for this one forward pass\n\n\n@torch.no_grad()\ndef measure_latency_ms(model, input_shape=INPUT_SHAPE, device=DEVICE, n_warmup=10, n_iters=50):\n    model = model.to(device).eval()\n    x = torch.randn(*input_shape, device=device)\n    for _ in range(n_warmup):\n        model(x)\n    if device == \"cuda\":\n        torch.cuda.synchronize()\n    times = []\n    for _ in range(n_iters):\n        t0 = time.perf_counter()\n        with torch.amp.autocast(device_type=\"cuda\" if device == \"cuda\" else \"cpu\"):\n            model(x)\n        if device == \"cuda\":\n            torch.cuda.synchronize()\n        times.append((time.perf_counter() - t0) * 1000)\n    times.sort()\n    return times[len(times) // 2]  # median\n\n\ndef main():\n    print(f\"{'variant':<20}{'params (M)':<14}{'GFLOPs/patch':<16}{'latency (ms, bs=1)'}\")\n    rows = []\n    for name, builder in MODELS_TO_REPORT.items():\n        model = builder()\n        params_m = count_params(model) / 1e6\n        try:\n            gflops = measure_flops(model)\n        except Exception as e:\n            gflops = float(\"nan\")\n            print(f\"  [warn] FLOPs profiling failed for {name}: {e}\")\n        latency = measure_latency_ms(model)\n        rows.append((name, params_m, gflops, latency))\n        print(f\"{name:<20}{params_m:<14.2f}{gflops:<16.2f}{latency:<.2f}\")\n        del model\n        if DEVICE == \"cuda\":\n            torch.cuda.empty_cache()\n\n    print(\"\\nCopy-paste table row format for the paper:\")\n    for name, params_m, gflops, latency in rows:\n        print(f\"  {name} & {params_m:.1f}M & {gflops:.1f} & {latency:.1f} \\\\\\\\\")\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T19:30:03.083483Z","iopub.execute_input":"2026-09-09T19:30:03.084434Z","iopub.status.idle":"2026-09-09T19:30:56.861841Z","shell.execute_reply.started":"2026-09-09T19:30:03.084398Z","shell.execute_reply":"2026-09-09T19:30:56.860904Z"}},"outputs":[{"name":"stdout","text":"variant             params (M)    GFLOPs/patch    latency (ms, bs=1)\n","output_type":"stream"},{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/torch/profiler/profiler.py:217: UserWarning: Warning: Profiler clears events at the end of each cycle.Only events from the current cycle will be reported.To keep events across cycles, set acc_events=True.\n  _warn_once(\n","output_type":"stream"},{"name":"stdout","text":"full                98.01         935.15          107.04\nsymmetric_loss      98.01         935.15          108.04\nno_opt_dropout      98.01         935.15          109.38\nno_cbam             98.01         935.06          97.31\nno_optical          98.01         471.63          62.45\nsingle_stream_sar   48.99         459.53          48.07\n\nCopy-paste table row format for the paper:\n  full & 98.0M & 935.1 & 107.0 \\\\\n  symmetric_loss & 98.0M & 935.1 & 108.0 \\\\\n  no_opt_dropout & 98.0M & 935.1 & 109.4 \\\\\n  no_cbam & 98.0M & 935.1 & 97.3 \\\\\n  no_optical & 98.0M & 471.6 & 62.4 \\\\\n  single_stream_sar & 49.0M & 459.5 & 48.1 \\\\\n","output_type":"stream"}],"execution_count":2},{"cell_type":"markdown","source":"#  failure case figure ","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# SINGLE CELL — self-contained, no external imports.\n# Auto-selects the worst false-negative and false-positive patches from\n# the official test set (using the `full` checkpoint) and renders a\n# multi-panel figure for each: optical composite, SAR composite, ground\n# truth, prediction, error map (FP=red, FN=blue). Saves PNGs you can\n# drop straight into the paper as the qualitative failure-case figure.\n\nimport os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport segmentation_models_pytorch as smp\nimport matplotlib.pyplot as plt\nfrom torch.utils.data import Dataset, DataLoader\n\nMANIFEST_PATH = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR = \"./data/ml_dataset/features\"\nMASKS_DIR = \"./data/ml_dataset/masks\"\nOFFICIAL_TEST_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_test_data.csv\"\nCHECKPOINT_PATH = \"./ablation_best_flood_model_full.pth\"\nOUTPUT_DIR = \"./figures_failure_cases\"\n\nFIXED_THRESHOLD = 0.50\nIGNORE_INDEX = -1\nN_WORST_FN = 2   # patches with the most missed water (false negatives)\nN_WORST_FP = 1   # patch with the most false-alarm water (false positives)\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\nos.makedirs(OUTPUT_DIR, exist_ok=True)\n\n\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef get_split_df(manifest_path, csv_path):\n    df = pd.read_csv(manifest_path)\n    ids = _parse_official_ids(csv_path)\n    return df[df[\"patch_id\"].isin(ids)].reset_index(drop=True)\n\n\nclass EvalDataset(Dataset):\n    def __init__(self, df, fd, md):\n        self.df, self.fd, self.md = df.reset_index(drop=True), fd, md\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        return x, y, pid\n\n\ndef load_model(path):\n    model = DualStreamUNetPP(use_cbam=True)\n    state = torch.load(path, map_location=DEVICE)\n    state = {k.replace(\"module.\", \"\"): v for k, v in state.items()}\n    model.load_state_dict(state, strict=True)\n    return model.to(DEVICE).eval()\n\n\n@torch.no_grad()\ndef score_all_patches(model, df):\n    \"\"\"Returns list of (pid, fn_count, fp_count, x, y, pred) for every patch.\"\"\"\n    loader = DataLoader(EvalDataset(df, FEATURES_DIR, MASKS_DIR),\n                         batch_size=1, shuffle=False, num_workers=2)\n    results = []\n    for x, y, pids in loader:\n        x_dev = x.to(DEVICE)\n        with torch.amp.autocast(device_type=\"cuda\" if DEVICE.type == \"cuda\" else \"cpu\"):\n            logits = model(x_dev)\n        pred = (torch.sigmoid(logits).squeeze().cpu().numpy() > FIXED_THRESHOLD)\n        y_np = y.squeeze().numpy()\n        valid = y_np != IGNORE_INDEX\n        t = (y_np == 1) & valid\n        fn = int((t & ~pred).sum())\n        fp = int((~t & pred & valid).sum())\n        results.append((pids[0], fn, fp, x.squeeze(0).numpy(), y_np, pred))\n    return results\n\n\ndef render_panel(pid, x, y_true, pred, tag, out_dir=OUTPUT_DIR):\n    \"\"\"x: (10,H,W) feature tensor. Channels: 0 VV,1 VH,2 Blue,3 Green,4 Red,\n    5 NIR,6 NDWI,7 SAR-contrast,8 SWIR1,9 MNDWI.\"\"\"\n    optical_rgb = np.stack([x[4], x[3], x[2]], axis=-1)  # R,G,B\n    optical_rgb = np.clip(optical_rgb * 3.5, 0, 1)  # brighten for visibility\n    sar_composite = np.stack([x[0], x[1], np.zeros_like(x[0])], axis=-1)  # VV=R, VH=G\n    sar_composite = np.clip(sar_composite, 0, 1)\n\n    valid = y_true != IGNORE_INDEX\n    gt = np.where(valid, y_true, 0).astype(float)\n    error_map = np.zeros((*y_true.shape, 3))\n    error_map[(y_true == 1) & valid & ~pred] = [0, 0, 1]     # FN -> blue\n    error_map[(y_true == 0) & valid & pred] = [1, 0, 0]      # FP -> red\n    error_map[(y_true == pred.astype(int)) & valid] = [0.85, 0.85, 0.85]  # correct -> light gray\n\n    fig, axes = plt.subplots(1, 5, figsize=(20, 4))\n    panels = [\n        (optical_rgb, \"Optical (RGB)\"),\n        (sar_composite, \"SAR (VV=R, VH=G)\"),\n        (gt, \"Ground truth (water)\"),\n        (pred.astype(float), \"Prediction\"),\n        (error_map, \"Error map (blue=FN, red=FP)\"),\n    ]\n    for ax, (img, title) in zip(axes, panels):\n        cmap = None if img.ndim == 3 else \"gray\"\n        ax.imshow(img, cmap=cmap)\n        ax.set_title(title, fontsize=10)\n        ax.axis(\"off\")\n    fig.suptitle(f\"{pid} ({tag})\", fontsize=12)\n    plt.tight_layout()\n    out_path = os.path.join(out_dir, f\"{tag}_{pid}.png\")\n    plt.savefig(out_path, dpi=150, bbox_inches=\"tight\")\n    plt.close(fig)\n    print(f\"  Saved: {out_path}\")\n\n\ndef main():\n    test_df = get_split_df(MANIFEST_PATH, OFFICIAL_TEST_CSV)\n    print(f\"Scoring {len(test_df)} official test patches with `full`...\")\n    model = load_model(CHECKPOINT_PATH)\n    results = score_all_patches(model, test_df)\n\n    by_fn = sorted(results, key=lambda r: -r[1])[:N_WORST_FN]\n    by_fp = sorted(results, key=lambda r: -r[2])[:N_WORST_FP]\n\n    print(f\"\\nWorst false-negative patches (most missed water):\")\n    for pid, fn, fp, x, y_true, pred in by_fn:\n        print(f\"  {pid}: FN={fn} px, FP={fp} px\")\n        render_panel(pid, x, y_true, pred, tag=\"worst_FN\")\n\n    print(f\"\\nWorst false-positive patch (most false-alarm water):\")\n    for pid, fn, fp, x, y_true, pred in by_fp:\n        print(f\"  {pid}: FN={fn} px, FP={fp} px\")\n        render_panel(pid, x, y_true, pred, tag=\"worst_FP\")\n\n    print(f\"\\nAll figures saved to {OUTPUT_DIR}/\")\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-09T19:35:39.977437Z","iopub.execute_input":"2026-09-09T19:35:39.978244Z","iopub.status.idle":"2026-09-09T19:35:58.259945Z","shell.execute_reply.started":"2026-09-09T19:35:39.978214Z","shell.execute_reply":"2026-09-09T19:35:58.25918Z"}},"outputs":[{"name":"stdout","text":"Scoring 90 official test patches with `full`...\n\nWorst false-negative patches (most missed water):\n  SEN1_Pakistan_849790: FN=30189 px, FP=10564 px\n  Saved: ./figures_failure_cases/worst_FN_SEN1_Pakistan_849790.png\n  SEN1_Ghana_866994: FN=17487 px, FP=10747 px\n  Saved: ./figures_failure_cases/worst_FN_SEN1_Ghana_866994.png\n\nWorst false-positive patch (most false-alarm water):\n  SEN1_Paraguay_232281: FN=3247 px, FP=17858 px\n  Saved: ./figures_failure_cases/worst_FP_SEN1_Paraguay_232281.png\n\nAll figures saved to ./figures_failure_cases/\n","output_type":"stream"}],"execution_count":3}]}