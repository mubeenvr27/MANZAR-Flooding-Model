{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":18368975},{"sourceType":"kernelVersion","sourceId":340000749}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Install required packages\n!pip install segmentation-models-pytorch rasterio scikit-learn scipy -q\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-04T10:19:52.446851Z","iopub.execute_input":"2026-09-04T10:19:52.447609Z","iopub.status.idle":"2026-09-04T10:19:57.389707Z","shell.execute_reply.started":"2026-09-04T10:19:52.447576Z","shell.execute_reply":"2026-09-04T10:19:57.388694Z"}},"outputs":[{"name":"stdout","text":"\u001b[2K   \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m154.8/154.8 kB\u001b[0m \u001b[31m7.8 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n\u001b[?25h","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"import os, subprocess\n\ndef setup_sen1floods11_pipeline(base_dir=\"./data/sen1floods11\"):\n    os.makedirs(base_dir, exist_ok=True)\n    gs_root = \"gs://sen1floods11/v1.1/data/flood_events/HandLabeled/\"\n    layers  = [\"S1Hand\", \"S2Hand\", \"LabelHand\"]\n    print(f\"--- Downloading Sen1Floods11 HandLabeled to {base_dir} ---\")\n    for layer in layers:\n        os.makedirs(os.path.join(base_dir, layer), exist_ok=True)\n        cmd = f\"gsutil -m cp -r -n {gs_root}{layer} {base_dir}\"\n        try:\n            subprocess.run(cmd, shell=True, check=True)\n            print(f\"  OK  {layer}\")\n        except subprocess.CalledProcessError:\n            print(f\"  FAIL {layer}\")\n    for layer in layers:\n        path  = os.path.join(base_dir, layer)\n        count = len(os.listdir(path)) if os.path.exists(path) else 0\n        print(f\"  {layer}: {count} chips\")\n\nsetup_sen1floods11_pipeline()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T20:58:35.856689Z","iopub.execute_input":"2026-09-01T20:58:35.857184Z","iopub.status.idle":"2026-09-01T20:59:29.411711Z","shell.execute_reply.started":"2026-09-01T20:58:35.857146Z","shell.execute_reply":"2026-09-01T20:59:29.411125Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Step 2 - Preprocessing: Build 10-Channel Feature Tensors\n**New in v7:** Adds SWIR1 (B11) and MNDWI channels.\nMNDWI outperforms NDWI for flood/built-up discrimination (Li et al. 2025).","metadata":{}},{"cell_type":"code","source":"\"\"\"\nFIX 5 — SAR channel calibration bug (root cause of the single_stream_sar\ninstability and, more importantly, a silent bug affecting every variant).\n\nTWO layered bugs, found in sequence:\n\n  1. Original code shared one [-30, 0] dB window between VV and VH.\n     VH backscatter runs lower than VV physically, so a shared window\n     was always going to under-serve VH.\n\n  2. What actually explains the 99.6%-\"invalid\" result from the first\n     attempted fix: `s1_db = 10 * np.log10(np.where(s1 > 0, s1, 1e-7))`\n     assumes S1Hand stores LINEAR power and needs converting to dB. But\n     when the fixed calibration script sampled raw pixel values against\n     the label mask's valid region and still got a collapsed window,\n     the more consistent explanation is that Sen1Floods11's S1Hand\n     rasters already store CALIBRATED GAMMA-0 BACKSCATTER IN DB, not\n     linear power (this is a real, documented quirk of how the official\n     Sen1Floods11 preprocessing exports data). Applying 10*log10() on\n     top of already-log data is a double-log: most real dB values are\n     negative, so `s1 > 0` treats almost the entire valid image as\n     \"invalid\" and floors it to a constant -70, which is exactly the\n     degenerate window you got back.\n\nFix: no log transform. Use the raster's own `nodata` metadata (not a\nguessed value threshold) to find genuinely invalid pixels, plus a broad\nplausibility bound on the dB range to catch stray artifacts, then derive\nseparate VV/VH calibration windows directly from the real dB values.\n\nVerify this against your data before trusting it: pull one raw S1Hand\ntile with rasterio, print `src.nodata` and a histogram of `src.read()`\ndirectly, and confirm the values look like dB (roughly -25 to +10, some\nnegative) rather than linear power (roughly 0 to 1, always positive).\nThat two-minute check costs less than another failed reprocessing pass.\n\nEvery checkpoint trained before this fix is invalid for any claim\ninvolving VV, VH, or SAR-ratio — which is all of them. Everything needs\nretraining on the reprocessed dataset. Update the paper's channel\ndescription (Section IV-A, \"Ch 7 SAR ratio VV/VH\") to \"SAR co/cross-pol\ndB difference\" once this lands — the channel's actual definition changed,\nand Section IV-A's claim that S1Hand needs dB conversion needs revising\ntoo, since the raw data was apparently already in dB.\n\"\"\"\n\nimport os\nimport glob\nimport numpy as np\nimport pandas as pd\nimport rasterio\nfrom tqdm import tqdm\n\nBASE_DIR = \"./data/sen1floods11\"\nOUTPUT_DIR = \"./data/ml_dataset\"\nN_SAMPLE_FOR_CALIBRATION = 60\n\n# Percentiles used to derive the clip window from real data, robust to a\n# handful of extreme outlier pixels (speckle, sensor artifacts) without\n# being as fragile as a hard min/max.\nCALIB_LOW_PCTILE, CALIB_HIGH_PCTILE = 1.0, 99.0\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 1. DERIVE REAL PER-CHANNEL CALIBRATION WINDOWS FROM RAW DATA\n# ─────────────────────────────────────────────────────────────────────\n# Sen1Floods11's S1Hand rasters store ALREADY-CALIBRATED gamma-0\n# backscatter in dB, not linear power. Applying 10*log10() to them (as\n# both the original code and my first \"fix\" did) is a double-log — it\n# silently discards virtually all real signal, since real dB values are\n# mostly negative and a positive-threshold no-data filter treats every\n# negative number as invalid. Use the raster's own `nodata` metadata to\n# find true invalid pixels instead of guessing a value-based threshold.\nPLAUSIBLE_DB_RANGE = (-60.0, 30.0)  # sanity bound only, not a filter\n\n\ndef _valid_mask(band, nodata_value):\n    if nodata_value is not None:\n        mask = band != nodata_value\n    else:\n        mask = np.ones_like(band, dtype=bool)\n    mask &= np.isfinite(band)\n    mask &= (band > PLAUSIBLE_DB_RANGE[0]) & (band < PLAUSIBLE_DB_RANGE[1])\n    return mask\n\n\ndef derive_sar_calibration_windows(base_dir=BASE_DIR, n_sample=N_SAMPLE_FOR_CALIBRATION):\n    s1_files = glob.glob(os.path.join(base_dir, \"S1Hand\", \"*.tif\"))\n    if not s1_files:\n        raise FileNotFoundError(f\"No S1 files in {base_dir}/S1Hand\")\n    rng = np.random.default_rng(42)\n    sample = rng.choice(s1_files, size=min(n_sample, len(s1_files)), replace=False)\n\n    vv_vals, vh_vals = [], []\n    total_px, invalid_px = 0, 0\n    for path in tqdm(sample, desc=\"Sampling raw SAR for calibration\"):\n        with rasterio.open(path) as src:\n            s1 = src.read()  # [2, H, W], already dB — NO log transform here\n            nodata = src.nodata\n\n        vv_mask = _valid_mask(s1[0], nodata)\n        vh_mask = _valid_mask(s1[1], nodata)\n        total_px += s1[0].size\n        invalid_px += (~vv_mask).sum()\n        vv_vals.append(s1[0][vv_mask].ravel())\n        vh_vals.append(s1[1][vh_mask].ravel())\n\n    vv_all = np.concatenate(vv_vals)\n    vh_all = np.concatenate(vh_vals)\n    invalid_pct = 100.0 * invalid_px / total_px\n\n    print(f\"\\nInvalid/no-data pixels excluded (via raster nodata metadata + plausible-dB bound): \"\n          f\"{invalid_pct:.1f}% of sampled pixels\")\n\n    if len(vv_all) < 1000 or len(vh_all) < 1000:\n        raise RuntimeError(\n            f\"Only {len(vv_all)} valid VV / {len(vh_all)} valid VH pixels found — too few to \"\n            f\"derive a reliable window. If invalid_pct is still near 100%, print src.nodata and \"\n            f\"a raw pixel histogram directly before proceeding; do not guess another threshold.\"\n        )\n\n    vv_lo, vv_hi = np.percentile(vv_all, [CALIB_LOW_PCTILE, CALIB_HIGH_PCTILE])\n    vh_lo, vh_hi = np.percentile(vh_all, [CALIB_LOW_PCTILE, CALIB_HIGH_PCTILE])\n\n    if vv_hi - vv_lo < 1.0 or vh_hi - vh_lo < 1.0:\n        raise RuntimeError(\n            f\"Derived window is still degenerate: VV=[{vv_lo:.2f},{vv_hi:.2f}] \"\n            f\"VH=[{vh_lo:.2f},{vh_hi:.2f}]. Do not proceed to reprocessing.\"\n        )\n\n    print(f\"Derived calibration windows (from {len(sample)} sampled tiles, \"\n          f\"{CALIB_LOW_PCTILE}-{CALIB_HIGH_PCTILE} percentile, raw dB, no log transform applied):\")\n    print(f\"  VV: valid-pixel dB range [{vv_all.min():.1f}, {vv_all.max():.1f}], \"\n          f\"using window [{vv_lo:.1f}, {vv_hi:.1f}]\")\n    print(f\"  VH: valid-pixel dB range [{vh_all.min():.1f}, {vh_all.max():.1f}], \"\n          f\"using window [{vh_lo:.1f}, {vh_hi:.1f}]\")\n    print(f\"  VH sits {vv_lo - vh_lo:.1f} dB below VV at the low end.\\n\")\n\n    return {\"vv\": (float(vv_lo), float(vv_hi)), \"vh\": (float(vh_lo), float(vh_hi))}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 2. REPROCESS THE FULL DATASET WITH THE CORRECTED CALIBRATION\n# ─────────────────────────────────────────────────────────────────────\ndef build_sen1floods_tensors_v9(calib_windows, base_dir=BASE_DIR, output_dir=OUTPUT_DIR):\n    \"\"\"\n    10-CHANNEL FEATURE TENSOR (v9 — fixes shared-window VH collapse)\n    ──────────────────────────────────────────────────────────────\n    Ch 0  VV copol      SAR dB, own calibration window -> [0,1]\n    Ch 1  VH crosspol   SAR dB, SEPARATE calibration window -> [0,1]\n    Ch 2  Blue   B02    /10000\n    Ch 3  Green  B03    /10000\n    Ch 4  Red    B04    /10000\n    Ch 5  NIR    B08    /10000\n    Ch 6  NDWI          (Green-NIR)/(Green+NIR)\n    Ch 7  SAR contrast  copol_db - crosspol_db, normalized -> [0,1]\n                         (replaces the old linear VV/VH ratio, which\n                          divided by a near-zero channel by construction)\n    Ch 8  SWIR1  B11    /10000\n    Ch 9  MNDWI         (Green-SWIR1)/(Green+SWIR1)\n    \"\"\"\n    s1_dir, s2_dir, lbl_dir = (os.path.join(base_dir, d) for d in\n                                (\"S1Hand\", \"S2Hand\", \"LabelHand\"))\n    feat_dir = os.path.join(output_dir, \"features\")\n    mask_dir = os.path.join(output_dir, \"masks\")\n    os.makedirs(feat_dir, exist_ok=True)\n    os.makedirs(mask_dir, exist_ok=True)\n\n    vv_lo, vv_hi = calib_windows[\"vv\"]\n    vh_lo, vh_hi = calib_windows[\"vh\"]\n    # dB-difference is naturally bounded on this dataset; ±20 dB covers\n    # the observed spread with headroom. Derived once, not re-guessed\n    # per patch, so the channel's scale is consistent dataset-wide.\n    CONTRAST_RANGE = 20.0\n\n    s1_files = glob.glob(os.path.join(s1_dir, \"*.tif\"))\n    if not s1_files:\n        raise FileNotFoundError(f\"No S1 files in {s1_dir}\")\n\n    manifest = []\n    print(f\"Reprocessing {len(s1_files)} triplets with corrected SAR calibration...\")\n\n    for s1_path in tqdm(s1_files, desc=\"Reprocessing (v9)\"):\n        filename = os.path.basename(s1_path)\n        base_name = filename.replace(\"_S1Hand.tif\", \"\")\n        s2_path = os.path.join(s2_dir, f\"{base_name}_S2Hand.tif\")\n        lbl_path = os.path.join(lbl_dir, f\"{base_name}_LabelHand.tif\")\n        if not (os.path.exists(s2_path) and os.path.exists(lbl_path)):\n            continue\n\n        with rasterio.open(s1_path) as src:\n            s1 = src.read()\n            s1_nodata = src.nodata\n        with rasterio.open(s2_path) as src:\n            s2 = src.read()\n        with rasterio.open(lbl_path) as src:\n            lbl = src.read(1)\n\n        # S1Hand is already dB — no log transform. Invalid pixels\n        # (raster nodata, or outside a plausible dB range) get pinned\n        # to each channel's own low end so they clip to 0 post-\n        # normalization, consistent with those regions typically\n        # coinciding with the label's -1 (ignore) mask.\n        vv_db = np.where(_valid_mask(s1[0], s1_nodata), s1[0], vv_lo)\n        vh_db = np.where(_valid_mask(s1[1], s1_nodata), s1[1], vh_lo)\n\n        # FIXED: separate window per channel, matched to each channel's\n        # actual physical dynamic range.\n        copol = np.clip((vv_db - vv_lo) / (vv_hi - vv_lo), 0, 1)\n        crosspol = np.clip((vh_db - vh_lo) / (vh_hi - vh_lo), 0, 1)\n\n        blue = np.clip(s2[1] / 10000.0, 0, 1)\n        green = np.clip(s2[2] / 10000.0, 0, 1)\n        red = np.clip(s2[3] / 10000.0, 0, 1)\n        nir = np.clip(s2[7] / 10000.0, 0, 1)\n        swir1 = np.clip(s2[11] / 10000.0, 0, 1)\n\n        with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n            ndwi = np.where((green + nir) > 0, (green - nir) / (green + nir), 0.0)\n            mndwi = np.where((green + swir1) > 0, (green - swir1) / (green + swir1), 0.0)\n\n        ndwi = np.nan_to_num(ndwi, nan=0.0, posinf=1.0, neginf=-1.0)\n        mndwi = np.nan_to_num(mndwi, nan=0.0, posinf=1.0, neginf=-1.0)\n\n        # FIXED: dB difference instead of a linear ratio that divides by\n        # a near-zero channel. No division, no blow-up, bounded and\n        # dataset-consistent.\n        contrast_db = vv_db - vh_db\n        sar_r = np.clip((contrast_db + CONTRAST_RANGE) / (2 * CONTRAST_RANGE), 0, 1)\n        sar_r = np.nan_to_num(sar_r, nan=0.5, posinf=1.0, neginf=0.0)\n\n        features = np.stack(\n            [copol, crosspol, blue, green, red, nir, ndwi, sar_r, swir1, mndwi],\n            axis=0).astype(np.float32)\n        mask = lbl.astype(np.int8)\n\n        patch_id = f\"SEN1_{base_name}\"\n        np.save(os.path.join(feat_dir, f\"{patch_id}.npy\"), features)\n        np.save(os.path.join(mask_dir, f\"{patch_id}.npy\"), mask)\n\n        valid_px = np.sum(mask != -1)\n        water_px = np.sum(mask == 1)\n        manifest.append({\n            \"patch_id\": patch_id,\n            \"biome\": base_name.split(\"_\")[0],\n            \"water_ratio\": round(water_px / valid_px, 4) if valid_px > 0 else 0.0,\n            \"valid_pixel_ratio\": round(valid_px / (512 * 512), 4),\n        })\n\n    df = pd.DataFrame(manifest)\n    df.to_csv(os.path.join(output_dir, \"patch_manifest.csv\"), index=False)\n    print(f\"\\n=== Reprocessing complete (v9) ===\")\n    print(f\"  Tensors : {len(df)}\")\n    print(f\"  VV window: [{vv_lo:.1f}, {vv_hi:.1f}] dB\")\n    print(f\"  VH window: [{vh_lo:.1f}, {vh_hi:.1f}] dB  (was incorrectly sharing VV's window)\")\n    print(f\"  Ch7 redefined: dB contrast (VV-VH), not linear ratio\")\n    return df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 3. VERIFY THE FIX — same check as 05_channel_sanity_check.py, inline\n# ─────────────────────────────────────────────────────────────────────\ndef verify_fix(output_dir=OUTPUT_DIR, n_sample=40):\n    \"\"\"Stats restricted to VALID pixels (mask != -1) only — invalid\n    pixels are the majority of most chips and get pinned near 0, so\n    computing stats over the whole array (valid + invalid) understates\n    real signal even when the fix is working correctly. What matters is\n    the distribution where the loss function actually looks.\"\"\"\n    manifest = pd.read_csv(os.path.join(output_dir, \"patch_manifest.csv\"))\n    pids = manifest[\"patch_id\"].sample(n=min(n_sample, len(manifest)), random_state=42)\n    names = [\"VV\", \"VH\", \"Blue\", \"Green\", \"Red\", \"NIR\", \"NDWI\", \"SAR-contrast\", \"SWIR1\", \"MNDWI\"]\n\n    stats = {c: [] for c in range(10)}\n    for pid in pids:\n        arr = np.load(os.path.join(output_dir, \"features\", f\"{pid}.npy\"))\n        mask = np.load(os.path.join(output_dir, \"masks\", f\"{pid}.npy\"))\n        valid = mask != -1\n        if valid.sum() == 0:\n            continue\n        for c in range(10):\n            vals = arr[c][valid]\n            stats[c].append((vals.mean(), vals.std()))\n\n    print(f\"\\n{'ch':<3}{'name':<14}{'mean':<10}{'std':<10}{'status'}  (valid-pixel stats)\")\n    ok = True\n    for c in range(10):\n        means = [s[0] for s in stats[c]]\n        stds = [s[1] for s in stats[c]]\n        # NaN check FIRST, on every channel — a degenerate window\n        # produces NaN via 0/0 division, and that silently sails past\n        # a std-only check (nan compares False to everything, so the\n        # old `s < 0.02` check never caught it).\n        if any(np.isnan(m_) or np.isnan(s_) for m_, s_ in zip(means, stds)):\n            print(f\"{c:<3}{names[c]:<14}{'nan':<10}{'nan':<10}NaN VALUES PRESENT — fix did not take\")\n            ok = False\n            continue\n        m, s = float(np.mean(means)), float(np.mean(stds))\n        status = \"OK\"\n        if c in (1, 7) and s < 0.02:\n            status = \"STILL DEGENERATE — fix did not take\"\n            ok = False\n        print(f\"{c:<3}{names[c]:<14}{m:<10.3f}{s:<10.3f}{status}\")\n\n    print(\"\\nFIX VERIFIED — VH and SAR-contrast now carry real signal over valid pixels.\"\n          if ok else \"\\nFIX DID NOT RESOLVE THE ISSUE — do not proceed to retraining.\")\n    return ok\n\n\nif __name__ == \"__main__\":\n    windows = derive_sar_calibration_windows()\n    build_sen1floods_tensors_v9(windows)\n    verify_fix()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T21:05:21.484241Z","iopub.execute_input":"2026-09-01T21:05:21.484733Z","iopub.status.idle":"2026-09-01T21:05:46.503775Z","shell.execute_reply.started":"2026-09-01T21:05:21.484703Z","shell.execute_reply":"2026-09-01T21:05:46.503049Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# train no opt dropout","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# Standalone single-run training script: NO_OPT_DROPOUT ablation\n# (full dual-stream architecture, optical-dropout curriculum disabled —\n# isolates the curriculum's contribution vs the full model).\n# Depends on: 04_preprocess_fixed.py having been run first (reprocessed,\n# calibration-corrected tensors under ./data/ml_dataset/).\n\nimport os, gc, csv, random, shutil, logging, json\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom sklearn.model_selection import KFold\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG\n# ─────────────────────────────────────────────────────────────────────\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\n# ── Training mode ──────────────────────────────────────────────────\n# \"standard\"   - single run, full model, official split\n# \"ablation\"   - trains all 7 variants with per-variant hyperparams\n# \"crossval\"   - 5-fold CV on official training patches\n# \"cloud_test\" - evaluates SAR-only robustness of saved checkpoints\nTRAINING_MODE    = \"standard\"\nABLATION_VARIANT = \"no_opt_dropout\"\n\nCV_FOLDS = 5\nCV_SEED  = 42\n\n# ── Core hyperparameters (dual-stream / full model) ────────────────\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 8\nACCUM_STEPS      = 4        # effective batch = 32\nNUM_WORKERS      = 4\nLR               = 2e-4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nPATIENCE         = 25\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3      # penalise FP less than FN for full model\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\n# ── SAR-ONLY variant hyperparameter overrides ──────────────────────\n# The default LR+loss settings were tuned for 10-channel input.\n# SAR-only variants (2-3 channels, 5-20% flood pixels) need:\n# - Lower LR to avoid overshooting on sparse signal\n# - Gentler FocalTversky gamma (less aggressive hard-pixel focus)\n# - Higher patience (slower convergence expected)\n# - Balanced FP/FN (symmetric loss) to avoid early collapse\nSAR_ONLY_LR       = 5e-5   # 4x lower than dual-stream\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0    # less aggressive focal\nSAR_ONLY_FT_ALPHA = 0.5    # symmetric FP/FN penalty\nSAR_ONLY_FT_BETA  = 0.5\n\n# Variants that use SAR-only overrides\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\", \"no_optical\"}\n\n# ─────────────────────────────────────────────────────────────────────\n# LOGGING\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[\n        logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n        logging.StreamHandler(),\n    ],\n)\nlog = logging.getLogger(\"manzar_v8\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant=\"full\"):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\"         : \"MANZAR v8\",\n        \"TRAINING_MODE\"   : TRAINING_MODE,\n        \"ABLATION_VARIANT\": variant,\n        \"INPUT_CHANNELS\"  : 10,\n        \"CHANNEL_LAYOUT\"  : \"VV VH Blue Green Red NIR NDWI SARratio SWIR1 MNDWI\",\n        \"EPOCHS\"          : EPOCHS,\n        \"PHYSICAL_BATCH\"  : PHYSICAL_BATCH,\n        \"ACCUM_STEPS\"     : ACCUM_STEPS,\n        \"EFFECTIVE_BATCH\" : PHYSICAL_BATCH * ACCUM_STEPS,\n        \"LR\"              : SAR_ONLY_LR if is_sar else LR,\n        \"WEIGHT_DECAY\"    : WEIGHT_DECAY,\n        \"ETA_MIN\"         : ETA_MIN,\n        \"PATIENCE\"        : SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"VAL_SMOOTHING_EMA\": VAL_SMOOTHING,\n        \"LOSS\"            : \"HybridLoss: 0.7*FocalTversky + 0.3*BCE\",\n        \"FT_ALPHA\"        : SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\"         : SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\"        : round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"OVERSAMPLE_WEIGHT\": OVERSAMPLE_WEIGHT,\n        \"OPT_DROP_START\"  : OPT_DROP_START,\n        \"OPT_DROP_END\"    : OPT_DROP_END,\n        \"OPT_DROP_RAMP\"   : OPT_DROP_RAMP,\n        \"SEED\"            : SEED,\n        \"SPLIT\"           : \"OFFICIAL Sen1Floods11\",\n        \"TRAIN_CSV\"       : OFFICIAL_TRAIN_CSV,\n        \"VAL_CSV\"         : OFFICIAL_VAL_CSV,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f: json.dump(params, f, indent=2)\n    log.info(\"=\"*62)\n    log.info(\"  MANZAR v8 - HYPERPARAMETER TABLE\")\n    log.info(\"=\"*62)\n    for k, v in params.items(): log.info(f\"  {k:<22} : {v}\")\n    log.info(f\"  Saved: {path}\")\n    log.info(\"=\"*62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 1. DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _check_official_csvs():\n    missing = []\n    for p in [OFFICIAL_TRAIN_CSV, OFFICIAL_VAL_CSV]:\n        if not os.path.exists(p): missing.append(p)\n    if missing:\n        raise FileNotFoundError(\n            f\"Official split CSVs not found: {missing}\\n\"\n            \"These are REQUIRED for benchmark-comparable results.\"\n        )\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:,0]:\n        base = str(val).replace(\"S1Hand/\",\"\").replace(\"_S1Hand.tif\",\"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    _check_official_csvs()\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(\n            lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids   = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df  = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df    = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    unmatched = len(df) - len(train_df) - len(val_df)\n\n    log.info(\"=\"*62)\n    log.info(\"  SPLIT: OFFICIAL Sen1Floods11\")\n    log.info(f\"  Train     : {len(train_df)} patches\")\n    log.info(f\"  Val       : {len(val_df)} patches\")\n    log.info(f\"  Test (held): {unmatched} patches (Bolivia event - never touched)\")\n    log.info(f\"  Val biomes: {sorted(val_df['biome'].unique().tolist())}\")\n    log.info(f\"  Val water+: {(val_df['water_ratio']>0.01).sum()}/{len(val_df)}\")\n    log.info(\"=\"*62)\n\n    if len(train_df) == 0:\n        raise RuntimeError(\n            \"Official split matched 0 training patches. \"\n            f\"Check patch_id format.\\n\"\n            f\"  Manifest: {df['patch_id'].tolist()[:3]}\\n\"\n            f\"  CSV     : {list(train_ids)[:3]}\"\n        )\n    return train_df, val_df\n\n\ndef make_kfold_splits(manifest_path, n_folds=5, seed=42):\n    _check_official_csvs()\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(\n            lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    cv_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    log.info(f\"CV pool: {len(cv_df)} official train patches, {n_folds}-fold\")\n    kf    = KFold(n_splits=n_folds, shuffle=True, random_state=seed)\n    folds = []\n    for fold_i,(tr,vl) in enumerate(kf.split(cv_df)):\n        folds.append((cv_df.iloc[tr].reset_index(drop=True),\n                      cv_df.iloc[vl].reset_index(drop=True), fold_i+1))\n    return folds\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 2. DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    \"\"\"\n    Loads 10-channel feature patches and binary masks.\n\n    opt_drop_prob: probability of zeroing out ALL optical channels\n      (channels 2-9: Blue Green Red NIR NDWI SARratio SWIR1 MNDWI).\n      This is the optical-dropout curriculum used during training.\n\n    cloud_sim_mode: if True, ALWAYS zero out optical channels regardless\n      of opt_drop_prob. Used for cloud-resilience evaluation at test time.\n    \"\"\"\n    def __init__(self, df, features_dir, masks_dir, is_train=True,\n                 opt_drop_prob=0.0, cloud_sim_mode=False):\n        self.df  = df\n        self.fd  = features_dir\n        self.md  = masks_dir\n        self.is_train     = is_train\n        self.odp          = opt_drop_prob\n        self.cloud_sim    = cloud_sim_mode\n\n    def __len__(self): return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x   = torch.from_numpy(np.load(os.path.join(self.fd,f\"{pid}.npy\"))).float()\n        y   = torch.from_numpy(np.load(os.path.join(self.md,f\"{pid}.npy\"))).long()\n\n        # Cloud simulation: zero ALL optical channels at inference\n        if self.cloud_sim:\n            x[2:, :, :] = 0.0\n            return x, y\n\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x)\n                y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x)\n                y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2])\n                y = torch.rot90(y, k, [0, 1])\n\n            # Optical dropout curriculum\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n\n            # SAR noise augmentation\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True,\n                     opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s,\n                      num_workers=num_workers, pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers, cloud_sim=False):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False,\n                     cloud_sim_mode=cloud_sim)\n    return DataLoader(d, batch_size=16, shuffle=False,\n                      num_workers=num_workers, pin_memory=True)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 3. ARCHITECTURE  (10-channel input)\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc  = nn.Sequential(\n            nn.Linear(channels, channels//reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels//reduction, channels, bias=False))\n        self.sc  = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True),\n                       x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"\n    Dual-stream UNet++ with optional CBAM gated fusion.\n    SAR stream: VV (ch0), VH (ch1), SAR-ratio (ch7)  -> 3 channels\n    Optical stream: Blue-NIR (ch2-6), SWIR1 (ch8), MNDWI (ch9) -> 7 channels\n    \"\"\"\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam    = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f   = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    \"\"\"SAR-only: VV, VH, and VV/VH ratio (3 channels).\"\"\"\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    \"\"\"SAR-only: VV and VH only (no ratio). Tests ratio contribution.\"\"\"\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant=\"full\"):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    elif variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    elif variant in (\"no_optical\", \"single_stream_sar\"):\n        return SingleStreamSAR()\n    elif variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    elif variant in (\"no_opt_dropout\", \"symmetric_loss\", \"no_swir\"):\n        return DualStreamUNetPP(use_cbam=True)\n    else:\n        raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 4. LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha=FT_ALPHA, beta=FT_BETA, gamma=FT_GAMMA, smooth=1e-6):\n        super().__init__()\n        self.a = alpha\n        self.b = beta\n        self.g = gamma\n        self.s = smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = p[v]\n        t = t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T  = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce=ALPHA_BCE, ft_alpha=FT_ALPHA,\n                 ft_beta=FT_BETA, ft_gamma=FT_GAMMA):\n        super().__init__()\n        self.ft  = FocalTverskyLoss(alpha=ft_alpha, beta=ft_beta, gamma=ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a   = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    \"\"\"\n    Returns loss criterion tuned for the variant.\n    SAR-only variants use symmetric Tversky (alpha=beta=0.5) and\n    gentler focal gamma to avoid gradient starvation on sparse signal.\n    \"\"\"\n    if variant == \"symmetric_loss\":\n        return HybridLoss(alpha_bce=ALPHA_BCE, ft_alpha=0.5, ft_beta=0.5,\n                          ft_gamma=FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        # Symmetric + gentler gamma for SAR-only\n        return HybridLoss(alpha_bce=ALPHA_BCE,\n                          ft_alpha=SAR_ONLY_FT_ALPHA,\n                          ft_beta=SAR_ONLY_FT_BETA,\n                          ft_gamma=SAR_ONLY_FT_GAMMA)\n    return HybridLoss()\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 5. METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self): self.reset()\n\n    def reset(self): self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long()\n        t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\n            \"accuracy\" : (tp + tn) / (tp + tn + fp + fn + e),\n            \"precision\": pr,\n            \"recall\"   : re,\n            \"f1\"       : 2 * pr * re / (pr + re + e),\n            \"iou\"      : tp / (tp + fp + fn + e),\n        }\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 6. TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef opt_drop(epoch, variant):\n    \"\"\"\n    Returns the optical dropout probability for the current epoch.\n    SAR-only variants: always 0 (no optical to drop).\n    no_opt_dropout: always 0 (ablation studies curriculum contribution).\n    Full / other dual-stream variants: linearly ramp from START to END.\n    \"\"\"\n    if variant in SAR_ONLY_VARIANTS or variant == \"no_opt_dropout\":\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\ndef train_epoch(model, loader, crit, opt, scaler, device, ep):\n    model.train()\n    rl = 0.0\n    m  = RunningMetrics()\n    opt.zero_grad()\n    bar = tqdm(loader, desc=f\"Train {ep}\", leave=False, dynamic_ncols=True)\n    for step, (x, y) in enumerate(bar):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss   = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n        bar.set_postfix(loss=f\"{loss.item() * ACCUM_STEPS:.4f}\")\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl    += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap = torch.cat(ap)\n    at = torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics()\n        m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics()\n        m.update(ap, at, 0.5)\n        bm, bt = m.compute(), 0.5\n    bm[\"loss\"]   = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 7. SINGLE TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant=\"full\", suffix=\"\"):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n\n    # Per-variant hyperparameters\n    lr       = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  suffix={suffix or 'none'}\")\n    log.info(f\"  Train={len(train_df)}  Val={len(val_df)}\")\n    log.info(f\"  LR={lr}  Patience={patience}  SAR-only={is_sar}\")\n    log.info(f\"{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=f\"{variant}{suffix}\")\n\n    model = build_model(variant)\n    if torch.cuda.device_count() > 1:\n        model = nn.DataParallel(model)\n    model = model.to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters() if p.requires_grad):,}\")\n\n    opt    = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched  = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit   = get_criterion(variant)\n\n    bv = 0.0\n    sv = 0.0\n    en = 0\n\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n    logf = open(os.path.join(LOG_DIR, f\"log_{variant}{suffix}.csv\"), \"w\", newline=\"\")\n    w = csv.writer(logf)\n    w.writerow([\"epoch\",\"lr\",\"opt_drop\",\"train_loss\",\"train_f1\",\"train_iou\",\n                \"val_loss\",\"val_prec\",\"val_rec\",\"val_f1\",\"val_iou\",\"val_thresh\",\"smooth_iou\"])\n\n    pd_prev = None\n    tl      = None\n    for epoch in range(EPOCHS):\n        lr_cur = opt.param_groups[0][\"lr\"]\n        drop   = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl      = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        tm = train_epoch(model, tl, crit, opt, scaler, device, epoch + 1)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        log.info(\n            f\"  Ep{epoch+1:>3} lr={lr_cur:.1e} TL={tm['loss']:.4f} TF1={tm['f1']:.4f} \"\n            f\"VL={vm['loss']:.4f} VF1={vm['f1']:.4f} VIoU={vi:.4f} \"\n            f\"Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f}\"\n        )\n        w.writerow([epoch+1, lr_cur, drop, tm[\"loss\"], tm[\"f1\"], tm[\"iou\"],\n                    vm[\"loss\"], vm[\"precision\"], vm[\"recall\"], vm[\"f1\"],\n                    vi, vm[\"thresh\"], sv])\n        logf.flush()\n\n        if sv > bv:\n            bv = sv\n            en = 0\n            if os.path.exists(best_path):\n                os.remove(best_path)\n            torch.save(model.state_dict(), best_path)\n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if en >= patience:\n            log.info(f\"  Early stop epoch {epoch + 1}\")\n            break\n\n    logf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 8. ABLATION VARIANTS\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANTS = [\n    # SAR-only baselines (use SAR_ONLY_VARIANTS overrides automatically)\n    #(\"single_stream_sar\", \"Baseline: SAR-only 3ch UNet++ (VV+VH+ratio, no optical, no CBAM)\"),\n    #(\"no_sar_ratio\",      \"SAR VV+VH only (no ratio) - tests ratio channel contribution\"),\n    #(\"no_optical\",        \"SAR stream only (VV+VH+ratio) via dual-stream arch - optical contribution\"),\n    # Dual-stream ablations\n    #(\"symmetric_loss\",    \"Full dual-stream, symmetric Tversky alpha=beta=0.5\"),\n    #(\"no_cbam\",           \"Dual-stream, no CBAM attention gate\"),\n    (\"no_opt_dropout\",    \"Full dual-stream, NO optical dropout curriculum (curriculum contribution)\"),\n    # Full model\n    (\"full\",              \"Full MANZAR v8 - all components enabled\"),\n]\n\n\ndef run_ablation(train_df, val_df):\n    log.info(\"\\n\" + \"=\"*62 + \"\\n  ABLATION STUDY - 7 variants on official split\\n\" + \"=\"*62)\n    results = {}\n    for variant, desc in ABLATION_VARIANTS:\n        log.info(f\"\\n  [{variant}] {desc}\")\n        iou = train_single(train_df, val_df, variant=variant)\n        results[variant] = {\"description\": desc, \"val_iou\": round(iou, 4)}\n        log.info(f\"  RESULT [{variant}]: {iou:.4f}\")\n    log.info(\"\\n\" + \"=\"*62 + \"\\n  ABLATION SUMMARY (ascending val IoU)\")\n    for v, r in sorted(results.items(), key=lambda x: x[1][\"val_iou\"]):\n        log.info(f\"  {v:<22} : {r['val_iou']:.4f} - {r['description'][:45]}\")\n    log.info(\"=\"*62)\n    with open(os.path.join(LOG_DIR, \"ablation_val_results.json\"), \"w\") as f:\n        json.dump(results, f, indent=2)\n    log.info(f\"  Saved: {LOG_DIR}/ablation_val_results.json\")\n    return results\n\n\ndef run_crossval(manifest_path, variant=\"full\"):\n    log.info(f\"\\n{'='*62}\\n  {CV_FOLDS}-FOLD CV  variant={variant}\\n{'='*62}\")\n    folds = make_kfold_splits(manifest_path, CV_FOLDS, CV_SEED)\n    ious  = []\n    for tr, vl, fi in folds:\n        log.info(f\"\\n  FOLD {fi}/{CV_FOLDS}: train={len(tr)} val={len(vl)}\")\n        iou = train_single(tr, vl, variant=variant, suffix=f\"_fold{fi}\")\n        ious.append(iou)\n        log.info(f\"  FOLD {fi}: {iou:.4f}\")\n    mean, std = np.mean(ious), np.std(ious)\n    log.info(f\"\\n  CV RESULT: {mean:.4f} ± {std:.4f}\")\n    log.info(f\"  Per-fold : {[round(x, 4) for x in ious]}\")\n    with open(os.path.join(LOG_DIR, f\"cv_{variant}.json\"), \"w\") as f:\n        json.dump({\"folds\": ious, \"mean\": round(mean, 4), \"std\": round(std, 4)}, f, indent=2)\n    return mean, std\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 9. MAIN\n# ─────────────────────────────────────────────────────────────────────\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache()\n    gc.collect()\n    save_hyperparams(variant=ABLATION_VARIANT)\n\n    if TRAINING_MODE == \"standard\":\n        train_df, val_df = make_official_splits(MANIFEST_PATH)\n        train_single(train_df, val_df, variant=ABLATION_VARIANT)\n\n    elif TRAINING_MODE == \"ablation\":\n        train_df, val_df = make_official_splits(MANIFEST_PATH)\n        run_ablation(train_df, val_df)\n\n    elif TRAINING_MODE == \"crossval\":\n        run_crossval(MANIFEST_PATH, variant=ABLATION_VARIANT)\n\n    else:\n        raise ValueError(f\"Unknown TRAINING_MODE: {TRAINING_MODE!r}\")\n\n\nmain()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T21:06:21.604048Z","iopub.execute_input":"2026-09-01T21:06:21.604439Z","iopub.status.idle":"2026-09-01T22:15:29.239387Z","shell.execute_reply.started":"2026-09-01T21:06:21.604412Z","shell.execute_reply":"2026-09-01T22:15:29.238611Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# train full","metadata":{}},{"cell_type":"code","source":" #!/usr/bin/env python3\n# Standalone single-run training script: FULL model (all components enabled).\n# Depends on: 04_preprocess_fixed.py having been run first (reprocessed,\n# calibration-corrected tensors under ./data/ml_dataset/).\n# Run this on its own, check ./logs/ablation_val_results.json equivalent\n# (here: best val IoU printed at the end) before deciding next steps.\n\nimport os, gc, csv, random, shutil, logging, json\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom sklearn.model_selection import KFold\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG\n# ─────────────────────────────────────────────────────────────────────\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\n# ── Training mode ──────────────────────────────────────────────────\n# \"standard\"   - single run, full model, official split\n# \"ablation\"   - trains all 7 variants with per-variant hyperparams\n# \"crossval\"   - 5-fold CV on official training patches\n# \"cloud_test\" - evaluates SAR-only robustness of saved checkpoints\nTRAINING_MODE    = \"standard\"\nABLATION_VARIANT = \"full\"\n\nCV_FOLDS = 5\nCV_SEED  = 42\n\n# ── Core hyperparameters (dual-stream / full model) ────────────────\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 8\nACCUM_STEPS      = 4        # effective batch = 32\nNUM_WORKERS      = 4\nLR               = 2e-4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nPATIENCE         = 25\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3      # penalise FP less than FN for full model\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\n# ── SAR-ONLY variant hyperparameter overrides ──────────────────────\n# The default LR+loss settings were tuned for 10-channel input.\n# SAR-only variants (2-3 channels, 5-20% flood pixels) need:\n# - Lower LR to avoid overshooting on sparse signal\n# - Gentler FocalTversky gamma (less aggressive hard-pixel focus)\n# - Higher patience (slower convergence expected)\n# - Balanced FP/FN (symmetric loss) to avoid early collapse\nSAR_ONLY_LR       = 5e-5   # 4x lower than dual-stream\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0    # less aggressive focal\nSAR_ONLY_FT_ALPHA = 0.5    # symmetric FP/FN penalty\nSAR_ONLY_FT_BETA  = 0.5\n\n# Variants that use SAR-only overrides\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\", \"no_optical\"}\n\n# ─────────────────────────────────────────────────────────────────────\n# LOGGING\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[\n        logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n        logging.StreamHandler(),\n    ],\n)\nlog = logging.getLogger(\"manzar_v8\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant=\"full\"):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\"         : \"MANZAR v8\",\n        \"TRAINING_MODE\"   : TRAINING_MODE,\n        \"ABLATION_VARIANT\": variant,\n        \"INPUT_CHANNELS\"  : 10,\n        \"CHANNEL_LAYOUT\"  : \"VV VH Blue Green Red NIR NDWI SARratio SWIR1 MNDWI\",\n        \"EPOCHS\"          : EPOCHS,\n        \"PHYSICAL_BATCH\"  : PHYSICAL_BATCH,\n        \"ACCUM_STEPS\"     : ACCUM_STEPS,\n        \"EFFECTIVE_BATCH\" : PHYSICAL_BATCH * ACCUM_STEPS,\n        \"LR\"              : SAR_ONLY_LR if is_sar else LR,\n        \"WEIGHT_DECAY\"    : WEIGHT_DECAY,\n        \"ETA_MIN\"         : ETA_MIN,\n        \"PATIENCE\"        : SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"VAL_SMOOTHING_EMA\": VAL_SMOOTHING,\n        \"LOSS\"            : \"HybridLoss: 0.7*FocalTversky + 0.3*BCE\",\n        \"FT_ALPHA\"        : SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\"         : SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\"        : round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"OVERSAMPLE_WEIGHT\": OVERSAMPLE_WEIGHT,\n        \"OPT_DROP_START\"  : OPT_DROP_START,\n        \"OPT_DROP_END\"    : OPT_DROP_END,\n        \"OPT_DROP_RAMP\"   : OPT_DROP_RAMP,\n        \"SEED\"            : SEED,\n        \"SPLIT\"           : \"OFFICIAL Sen1Floods11\",\n        \"TRAIN_CSV\"       : OFFICIAL_TRAIN_CSV,\n        \"VAL_CSV\"         : OFFICIAL_VAL_CSV,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f: json.dump(params, f, indent=2)\n    log.info(\"=\"*62)\n    log.info(\"  MANZAR v8 - HYPERPARAMETER TABLE\")\n    log.info(\"=\"*62)\n    for k, v in params.items(): log.info(f\"  {k:<22} : {v}\")\n    log.info(f\"  Saved: {path}\")\n    log.info(\"=\"*62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 1. DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _check_official_csvs():\n    missing = []\n    for p in [OFFICIAL_TRAIN_CSV, OFFICIAL_VAL_CSV]:\n        if not os.path.exists(p): missing.append(p)\n    if missing:\n        raise FileNotFoundError(\n            f\"Official split CSVs not found: {missing}\\n\"\n            \"These are REQUIRED for benchmark-comparable results.\"\n        )\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:,0]:\n        base = str(val).replace(\"S1Hand/\",\"\").replace(\"_S1Hand.tif\",\"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    _check_official_csvs()\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(\n            lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids   = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df  = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df    = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    unmatched = len(df) - len(train_df) - len(val_df)\n\n    log.info(\"=\"*62)\n    log.info(\"  SPLIT: OFFICIAL Sen1Floods11\")\n    log.info(f\"  Train     : {len(train_df)} patches\")\n    log.info(f\"  Val       : {len(val_df)} patches\")\n    log.info(f\"  Test (held): {unmatched} patches (Bolivia event - never touched)\")\n    log.info(f\"  Val biomes: {sorted(val_df['biome'].unique().tolist())}\")\n    log.info(f\"  Val water+: {(val_df['water_ratio']>0.01).sum()}/{len(val_df)}\")\n    log.info(\"=\"*62)\n\n    if len(train_df) == 0:\n        raise RuntimeError(\n            \"Official split matched 0 training patches. \"\n            f\"Check patch_id format.\\n\"\n            f\"  Manifest: {df['patch_id'].tolist()[:3]}\\n\"\n            f\"  CSV     : {list(train_ids)[:3]}\"\n        )\n    return train_df, val_df\n\n\ndef make_kfold_splits(manifest_path, n_folds=5, seed=42):\n    _check_official_csvs()\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(\n            lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    cv_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    log.info(f\"CV pool: {len(cv_df)} official train patches, {n_folds}-fold\")\n    kf    = KFold(n_splits=n_folds, shuffle=True, random_state=seed)\n    folds = []\n    for fold_i,(tr,vl) in enumerate(kf.split(cv_df)):\n        folds.append((cv_df.iloc[tr].reset_index(drop=True),\n                      cv_df.iloc[vl].reset_index(drop=True), fold_i+1))\n    return folds\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 2. DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    \"\"\"\n    Loads 10-channel feature patches and binary masks.\n\n    opt_drop_prob: probability of zeroing out ALL optical channels\n      (channels 2-9: Blue Green Red NIR NDWI SARratio SWIR1 MNDWI).\n      This is the optical-dropout curriculum used during training.\n\n    cloud_sim_mode: if True, ALWAYS zero out optical channels regardless\n      of opt_drop_prob. Used for cloud-resilience evaluation at test time.\n    \"\"\"\n    def __init__(self, df, features_dir, masks_dir, is_train=True,\n                 opt_drop_prob=0.0, cloud_sim_mode=False):\n        self.df  = df\n        self.fd  = features_dir\n        self.md  = masks_dir\n        self.is_train     = is_train\n        self.odp          = opt_drop_prob\n        self.cloud_sim    = cloud_sim_mode\n\n    def __len__(self): return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x   = torch.from_numpy(np.load(os.path.join(self.fd,f\"{pid}.npy\"))).float()\n        y   = torch.from_numpy(np.load(os.path.join(self.md,f\"{pid}.npy\"))).long()\n\n        # Cloud simulation: zero ALL optical channels at inference\n        if self.cloud_sim:\n            x[2:, :, :] = 0.0\n            return x, y\n\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x)\n                y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x)\n                y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2])\n                y = torch.rot90(y, k, [0, 1])\n\n            # Optical dropout curriculum\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n\n            # SAR noise augmentation\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True,\n                     opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s,\n                      num_workers=num_workers, pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers, cloud_sim=False):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False,\n                     cloud_sim_mode=cloud_sim)\n    return DataLoader(d, batch_size=16, shuffle=False,\n                      num_workers=num_workers, pin_memory=True)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 3. ARCHITECTURE  (10-channel input)\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc  = nn.Sequential(\n            nn.Linear(channels, channels//reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels//reduction, channels, bias=False))\n        self.sc  = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True),\n                       x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"\n    Dual-stream UNet++ with optional CBAM gated fusion.\n    SAR stream: VV (ch0), VH (ch1), SAR-ratio (ch7)  -> 3 channels\n    Optical stream: Blue-NIR (ch2-6), SWIR1 (ch8), MNDWI (ch9) -> 7 channels\n    \"\"\"\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam    = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f   = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    \"\"\"SAR-only: VV, VH, and VV/VH ratio (3 channels).\"\"\"\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    \"\"\"SAR-only: VV and VH only (no ratio). Tests ratio contribution.\"\"\"\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\",\n            in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant=\"full\"):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    elif variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    elif variant in (\"no_optical\", \"single_stream_sar\"):\n        return SingleStreamSAR()\n    elif variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    elif variant in (\"no_opt_dropout\", \"symmetric_loss\", \"no_swir\"):\n        return DualStreamUNetPP(use_cbam=True)\n    else:\n        raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 4. LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha=FT_ALPHA, beta=FT_BETA, gamma=FT_GAMMA, smooth=1e-6):\n        super().__init__()\n        self.a = alpha\n        self.b = beta\n        self.g = gamma\n        self.s = smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = p[v]\n        t = t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T  = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce=ALPHA_BCE, ft_alpha=FT_ALPHA,\n                 ft_beta=FT_BETA, ft_gamma=FT_GAMMA):\n        super().__init__()\n        self.ft  = FocalTverskyLoss(alpha=ft_alpha, beta=ft_beta, gamma=ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a   = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    \"\"\"\n    Returns loss criterion tuned for the variant.\n    SAR-only variants use symmetric Tversky (alpha=beta=0.5) and\n    gentler focal gamma to avoid gradient starvation on sparse signal.\n    \"\"\"\n    if variant == \"symmetric_loss\":\n        return HybridLoss(alpha_bce=ALPHA_BCE, ft_alpha=0.5, ft_beta=0.5,\n                          ft_gamma=FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        # Symmetric + gentler gamma for SAR-only\n        return HybridLoss(alpha_bce=ALPHA_BCE,\n                          ft_alpha=SAR_ONLY_FT_ALPHA,\n                          ft_beta=SAR_ONLY_FT_BETA,\n                          ft_gamma=SAR_ONLY_FT_GAMMA)\n    return HybridLoss()\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 5. METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self): self.reset()\n\n    def reset(self): self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long()\n        t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\n            \"accuracy\" : (tp + tn) / (tp + tn + fp + fn + e),\n            \"precision\": pr,\n            \"recall\"   : re,\n            \"f1\"       : 2 * pr * re / (pr + re + e),\n            \"iou\"      : tp / (tp + fp + fn + e),\n        }\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 6. TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef opt_drop(epoch, variant):\n    \"\"\"\n    Returns the optical dropout probability for the current epoch.\n    SAR-only variants: always 0 (no optical to drop).\n    no_opt_dropout: always 0 (ablation studies curriculum contribution).\n    Full / other dual-stream variants: linearly ramp from START to END.\n    \"\"\"\n    if variant in SAR_ONLY_VARIANTS or variant == \"no_opt_dropout\":\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\ndef train_epoch(model, loader, crit, opt, scaler, device, ep):\n    model.train()\n    rl = 0.0\n    m  = RunningMetrics()\n    opt.zero_grad()\n    bar = tqdm(loader, desc=f\"Train {ep}\", leave=False, dynamic_ncols=True)\n    for step, (x, y) in enumerate(bar):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss   = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n        bar.set_postfix(loss=f\"{loss.item() * ACCUM_STEPS:.4f}\")\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl    += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap = torch.cat(ap)\n    at = torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics()\n        m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics()\n        m.update(ap, at, 0.5)\n        bm, bt = m.compute(), 0.5\n    bm[\"loss\"]   = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 7. SINGLE TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant=\"full\", suffix=\"\"):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n\n    # Per-variant hyperparameters\n    lr       = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  suffix={suffix or 'none'}\")\n    log.info(f\"  Train={len(train_df)}  Val={len(val_df)}\")\n    log.info(f\"  LR={lr}  Patience={patience}  SAR-only={is_sar}\")\n    log.info(f\"{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=f\"{variant}{suffix}\")\n\n    model = build_model(variant)\n    if torch.cuda.device_count() > 1:\n        model = nn.DataParallel(model)\n    model = model.to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters() if p.requires_grad):,}\")\n\n    opt    = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched  = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit   = get_criterion(variant)\n\n    bv = 0.0\n    sv = 0.0\n    en = 0\n\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n    logf = open(os.path.join(LOG_DIR, f\"log_{variant}{suffix}.csv\"), \"w\", newline=\"\")\n    w = csv.writer(logf)\n    w.writerow([\"epoch\",\"lr\",\"opt_drop\",\"train_loss\",\"train_f1\",\"train_iou\",\n                \"val_loss\",\"val_prec\",\"val_rec\",\"val_f1\",\"val_iou\",\"val_thresh\",\"smooth_iou\"])\n\n    pd_prev = None\n    tl      = None\n    for epoch in range(EPOCHS):\n        lr_cur = opt.param_groups[0][\"lr\"]\n        drop   = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl      = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        tm = train_epoch(model, tl, crit, opt, scaler, device, epoch + 1)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        log.info(\n            f\"  Ep{epoch+1:>3} lr={lr_cur:.1e} TL={tm['loss']:.4f} TF1={tm['f1']:.4f} \"\n            f\"VL={vm['loss']:.4f} VF1={vm['f1']:.4f} VIoU={vi:.4f} \"\n            f\"Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f}\"\n        )\n        w.writerow([epoch+1, lr_cur, drop, tm[\"loss\"], tm[\"f1\"], tm[\"iou\"],\n                    vm[\"loss\"], vm[\"precision\"], vm[\"recall\"], vm[\"f1\"],\n                    vi, vm[\"thresh\"], sv])\n        logf.flush()\n\n        if sv > bv:\n            bv = sv\n            en = 0\n            if os.path.exists(best_path):\n                os.remove(best_path)\n            torch.save(model.state_dict(), best_path)\n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if en >= patience:\n            log.info(f\"  Early stop epoch {epoch + 1}\")\n            break\n\n    logf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 8. ABLATION VARIANTS\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANTS = [\n    # SAR-only baselines (use SAR_ONLY_VARIANTS overrides automatically)\n    #(\"single_stream_sar\", \"Baseline: SAR-only 3ch UNet++ (VV+VH+ratio, no optical, no CBAM)\"),\n    #(\"no_sar_ratio\",      \"SAR VV+VH only (no ratio) - tests ratio channel contribution\"),\n    #(\"no_optical\",        \"SAR stream only (VV+VH+ratio) via dual-stream arch - optical contribution\"),\n    # Dual-stream ablations\n    #(\"symmetric_loss\",    \"Full dual-stream, symmetric Tversky alpha=beta=0.5\"),\n    #(\"no_cbam\",           \"Dual-stream, no CBAM attention gate\"),\n    (\"no_opt_dropout\",    \"Full dual-stream, NO optical dropout curriculum (curriculum contribution)\"),\n    # Full model\n    (\"full\",              \"Full MANZAR v8 - all components enabled\"),\n]\n\n\ndef run_ablation(train_df, val_df):\n    log.info(\"\\n\" + \"=\"*62 + \"\\n  ABLATION STUDY - 7 variants on official split\\n\" + \"=\"*62)\n    results = {}\n    for variant, desc in ABLATION_VARIANTS:\n        log.info(f\"\\n  [{variant}] {desc}\")\n        iou = train_single(train_df, val_df, variant=variant)\n        results[variant] = {\"description\": desc, \"val_iou\": round(iou, 4)}\n        log.info(f\"  RESULT [{variant}]: {iou:.4f}\")\n    log.info(\"\\n\" + \"=\"*62 + \"\\n  ABLATION SUMMARY (ascending val IoU)\")\n    for v, r in sorted(results.items(), key=lambda x: x[1][\"val_iou\"]):\n        log.info(f\"  {v:<22} : {r['val_iou']:.4f} - {r['description'][:45]}\")\n    log.info(\"=\"*62)\n    with open(os.path.join(LOG_DIR, \"ablation_val_results.json\"), \"w\") as f:\n        json.dump(results, f, indent=2)\n    log.info(f\"  Saved: {LOG_DIR}/ablation_val_results.json\")\n    return results\n\n\ndef run_crossval(manifest_path, variant=\"full\"):\n    log.info(f\"\\n{'='*62}\\n  {CV_FOLDS}-FOLD CV  variant={variant}\\n{'='*62}\")\n    folds = make_kfold_splits(manifest_path, CV_FOLDS, CV_SEED)\n    ious  = []\n    for tr, vl, fi in folds:\n        log.info(f\"\\n  FOLD {fi}/{CV_FOLDS}: train={len(tr)} val={len(vl)}\")\n        iou = train_single(tr, vl, variant=variant, suffix=f\"_fold{fi}\")\n        ious.append(iou)\n        log.info(f\"  FOLD {fi}: {iou:.4f}\")\n    mean, std = np.mean(ious), np.std(ious)\n    log.info(f\"\\n  CV RESULT: {mean:.4f} ± {std:.4f}\")\n    log.info(f\"  Per-fold : {[round(x, 4) for x in ious]}\")\n    with open(os.path.join(LOG_DIR, f\"cv_{variant}.json\"), \"w\") as f:\n        json.dump({\"folds\": ious, \"mean\": round(mean, 4), \"std\": round(std, 4)}, f, indent=2)\n    return mean, std\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 9. MAIN\n# ─────────────────────────────────────────────────────────────────────\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache()\n    gc.collect()\n    save_hyperparams(variant=ABLATION_VARIANT)\n\n    if TRAINING_MODE == \"standard\":\n        train_df, val_df = make_official_splits(MANIFEST_PATH)\n        train_single(train_df, val_df, variant=ABLATION_VARIANT)\n\n    elif TRAINING_MODE == \"ablation\":\n        train_df, val_df = make_official_splits(MANIFEST_PATH)\n        run_ablation(train_df, val_df)\n\n    elif TRAINING_MODE == \"crossval\":\n        run_crossval(MANIFEST_PATH, variant=ABLATION_VARIANT)\n\n    else:\n        raise ValueError(f\"Unknown TRAINING_MODE: {TRAINING_MODE!r}\")\n\n\nmain()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-01T22:18:51.74727Z","iopub.execute_input":"2026-09-01T22:18:51.747739Z","iopub.status.idle":"2026-09-02T00:08:40.536897Z","shell.execute_reply.started":"2026-09-01T22:18:51.747703Z","shell.execute_reply":"2026-09-02T00:08:40.535926Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# eval test and bolivia fixed threshold","metadata":{}},{"cell_type":"code","source":"\"\"\"\nEvaluate `full` and `no_opt_dropout` on the ACTUAL official non-Bolivia\ntest set (90 patches) and the Bolivia hold-out (15 patches), at a FIXED\n0.50 threshold, using global pixel IoU (aggregated TP/FP/FN across every\npixel). This is the paper's stated protocol (Section III) — the val-split\nsmoothed/threshold-swept numbers from training are NOT this number.\n\nSelf-contained: no imports from the other numbered scripts, since you're\nrunning in a fresh notebook. Model class matches your training script\nexactly (plain DualStreamUNetPP, no zero_optical flag needed since\nneither `full` nor `no_opt_dropout` uses it).\n\nRun this after both checkpoints exist:\n  ./ablation_best_flood_model_full.pth\n  ./ablation_best_flood_model_no_opt_dropout.pth\n\"\"\"\n\nimport os\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader\n\nMANIFEST_PATH = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR = \"./data/ml_dataset/features\"\nMASKS_DIR = \"./data/ml_dataset/masks\"\n\nOFFICIAL_TEST_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_test_data.csv\"\nOFFICIAL_BOLIVIA_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_bolivia_data.csv\"\n\nCHECKPOINTS = {\n    \"full\": \"./ablation_best_flood_model_full.pth\",\n    \"no_opt_dropout\": \"./ablation_best_flood_model_no_opt_dropout.pth\",\n}\n\nFIXED_THRESHOLD = 0.50  # matches paper Section III, NOT the training sweep\nIGNORE_INDEX = -1\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\n# Numbers from the pre-fix paper draft, for direct side-by-side comparison.\nOLD_TABLE_I = {\n    (\"full\", \"official_test\"): 0.816,\n    (\"full\", \"bolivia\"): 0.801,\n    (\"no_opt_dropout\", \"official_test\"): 0.830,\n    (\"no_opt_dropout\", \"bolivia\"): 0.785,\n}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# MODEL (matches your training script exactly)\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA\n# ─────────────────────────────────────────────────────────────────────\nclass EvalDataset(Dataset):\n    def __init__(self, df, fd, md):\n        self.df, self.fd, self.md = df.reset_index(drop=True), fd, md\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        return x, y, pid\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef get_split_df(manifest_path, csv_path):\n    df = pd.read_csv(manifest_path)\n    ids = _parse_official_ids(csv_path)\n    split_df = df[df[\"patch_id\"].isin(ids)].reset_index(drop=True)\n    if len(split_df) == 0:\n        raise RuntimeError(f\"0 patches matched from {csv_path} — check patch_id format / CSV path\")\n    return split_df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# GLOBAL PIXEL IoU AT FIXED THRESHOLD\n# ─────────────────────────────────────────────────────────────────────\n@torch.no_grad()\ndef evaluate_global_fixed_threshold(model, df, features_dir, masks_dir,\n                                     threshold=FIXED_THRESHOLD, batch_size=8):\n    loader = DataLoader(EvalDataset(df, features_dir, masks_dir),\n                         batch_size=batch_size, shuffle=False,\n                         num_workers=4, pin_memory=True)\n    tp = fp = fn = tn = 0\n    for x, y, _ in loader:\n        x = x.to(DEVICE, non_blocking=True)\n        with torch.amp.autocast(device_type=\"cuda\" if DEVICE.type == \"cuda\" else \"cpu\"):\n            logits = model(x)\n        probs = torch.sigmoid(logits).squeeze(1).float().cpu()\n        p = probs.reshape(-1)\n        t = y.reshape(-1)\n        valid = t != IGNORE_INDEX\n        pb = (p[valid] > threshold)\n        tb = t[valid].bool()\n        tp += (pb & tb).sum().item()\n        fp += (pb & ~tb).sum().item()\n        fn += (~pb & tb).sum().item()\n        tn += (~pb & ~tb).sum().item()\n\n    eps = 1e-8\n    iou = tp / (tp + fp + fn + eps)\n    precision = tp / (tp + fp + eps)\n    recall = tp / (tp + fn + eps)\n    f1 = 2 * precision * recall / (precision + recall + eps)\n    return {\"iou\": iou, \"precision\": precision, \"recall\": recall, \"f1\": f1,\n            \"tp\": tp, \"fp\": fp, \"fn\": fn}\n\n\ndef load_model(weights_path):\n    model = DualStreamUNetPP(use_cbam=True)\n    state = torch.load(weights_path, map_location=DEVICE)\n    state = {k.replace(\"module.\", \"\"): v for k, v in state.items()}\n    missing, unexpected = model.load_state_dict(state, strict=False)\n    if missing:\n        print(f\"  [warn] missing keys: {missing[:3]}{'...' if len(missing) > 3 else ''}\")\n    if unexpected:\n        print(f\"  [warn] unexpected keys: {unexpected[:3]}{'...' if len(unexpected) > 3 else ''}\")\n    return model.to(DEVICE).eval()\n\n\ndef main():\n    test_df = get_split_df(MANIFEST_PATH, OFFICIAL_TEST_CSV)\n    bolivia_df = get_split_df(MANIFEST_PATH, OFFICIAL_BOLIVIA_CSV)\n    print(f\"Official test: {len(test_df)} patches | Bolivia: {len(bolivia_df)} patches\")\n    if len(test_df) != 90 or len(bolivia_df) != 15:\n        print(f\"  [note] expected 90/15 per the paper's stated protocol — got \"\n              f\"{len(test_df)}/{len(bolivia_df)}. Worth understanding why before trusting \"\n              f\"the numbers below (reprocessing may have dropped/gained patches).\")\n\n    results = []\n    for variant, path in CHECKPOINTS.items():\n        if not os.path.exists(path):\n            print(f\"  [skip] {variant}: {path} not found\")\n            continue\n        print(f\"\\n=== {variant} ===\")\n        model = load_model(path)\n\n        for split_name, df in ((\"official_test\", test_df), (\"bolivia\", bolivia_df)):\n            r = evaluate_global_fixed_threshold(model, df, FEATURES_DIR, MASKS_DIR)\n            old = OLD_TABLE_I.get((variant, split_name))\n            delta = r[\"iou\"] - old if old is not None else None\n            delta_str = f\"  (old: {old:.3f}, delta: {delta:+.3f})\" if old is not None else \"\"\n            print(f\"  [{split_name}] global IoU (thr={FIXED_THRESHOLD}) = {r['iou']:.4f}  \"\n                  f\"P={r['precision']:.4f}  R={r['recall']:.4f}  F1={r['f1']:.4f}{delta_str}\")\n            results.append({\"variant\": variant, \"split\": split_name, **r,\n                             \"old_iou\": old, \"delta_vs_old\": delta})\n\n        del model\n        torch.cuda.empty_cache()\n\n    df_out = pd.DataFrame(results)\n    df_out.to_csv(\"./corrected_headline_results.csv\", index=False)\n    print(f\"\\nSaved: ./corrected_headline_results.csv\")\n    return df_out\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T00:27:06.197136Z","iopub.execute_input":"2026-09-02T00:27:06.201438Z","iopub.status.idle":"2026-09-02T00:27:44.056526Z","shell.execute_reply.started":"2026-09-02T00:27:06.201398Z","shell.execute_reply":"2026-09-02T00:27:44.055655Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## significance and robustness corrected","metadata":{}},{"cell_type":"code","source":"\"\"\"\nTwo things, using the checkpoints you already have — no retraining:\n\n1. Is full's new ~0.03 IoU lead over no_opt_dropout (both splits) real,\n   or still inside noise? Patch-level paired bootstrap, same method as\n   before, now on the corrected checkpoints.\n\n2. Does the cloud-robustness story from before still hold? Re-run the\n   normal-vs-cloud-sim comparison (global pixel IoU, both splits) now\n   that VH/SAR-ratio actually carry signal — the old \"no_opt_dropout\n   floods everything under cloud cover\" result was measured on broken\n   input, so it needs re-checking, not assuming it still holds.\n\nSelf-contained, same model/data code as the eval script.\n\"\"\"\n\nimport os\nimport json\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader\n\nMANIFEST_PATH = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR = \"./data/ml_dataset/features\"\nMASKS_DIR = \"./data/ml_dataset/masks\"\n\nOFFICIAL_TEST_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_test_data.csv\"\nOFFICIAL_BOLIVIA_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_bolivia_data.csv\"\n\nCHECKPOINTS = {\n    \"full\": \"./ablation_best_flood_model_full.pth\",\n    \"no_opt_dropout\": \"./ablation_best_flood_model_no_opt_dropout.pth\",\n}\n\nFIXED_THRESHOLD = 0.50\nIGNORE_INDEX = -1\nN_BOOT = 10000\nRNG_SEED = 42\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# MODEL / DATA (same as 07)\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass EvalDataset(Dataset):\n    def __init__(self, df, fd, md, cloud_sim=False):\n        self.df, self.fd, self.md = df.reset_index(drop=True), fd, md\n        self.cloud_sim = cloud_sim\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.cloud_sim:\n            x[2:, :, :] = 0.0\n        return x, y, pid\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef get_split_df(manifest_path, csv_path):\n    df = pd.read_csv(manifest_path)\n    ids = _parse_official_ids(csv_path)\n    return df[df[\"patch_id\"].isin(ids)].reset_index(drop=True)\n\n\ndef load_model(weights_path):\n    model = DualStreamUNetPP(use_cbam=True)\n    state = torch.load(weights_path, map_location=DEVICE)\n    state = {k.replace(\"module.\", \"\"): v for k, v in state.items()}\n    model.load_state_dict(state, strict=False)\n    return model.to(DEVICE).eval()\n\n\n# ─────────────────────────────────────────────────────────────────────\n# PER-PATCH CONFUSION COUNTS (shared by both significance + robustness)\n# ─────────────────────────────────────────────────────────────────────\n@torch.no_grad()\ndef get_per_patch_confusion(model, df, cloud_sim=False, threshold=FIXED_THRESHOLD, batch_size=8):\n    ds = EvalDataset(df, FEATURES_DIR, MASKS_DIR, cloud_sim=cloud_sim)\n    loader = DataLoader(ds, batch_size=batch_size, shuffle=False, num_workers=4, pin_memory=True)\n    out = {}\n    for x, y, pids in loader:\n        x = x.to(DEVICE, non_blocking=True)\n        with torch.amp.autocast(device_type=\"cuda\" if DEVICE.type == \"cuda\" else \"cpu\"):\n            logits = model(x)\n        probs = torch.sigmoid(logits).squeeze(1).float().cpu()\n        for i, pid in enumerate(pids):\n            p = probs[i].reshape(-1)\n            t = y[i].reshape(-1)\n            valid = t != IGNORE_INDEX\n            pb = (p[valid] > threshold)\n            tb = t[valid].bool()\n            tp = (pb & tb).sum().item()\n            fp = (pb & ~tb).sum().item()\n            fn = (~pb & tb).sum().item()\n            tn = (~pb & ~tb).sum().item()\n            out[pid] = (tp, fp, fn, tn)\n    return out\n\n\ndef _global_from_counts(counts, ids):\n    tp = fp = fn = tn = 0\n    for pid in ids:\n        c = counts[pid]\n        tp += c[0]; fp += c[1]; fn += c[2]; tn += c[3]\n    eps = 1e-8\n    iou = tp / (tp + fp + fn + eps)\n    precision = tp / (tp + fp + eps)\n    recall = tp / (tp + fn + eps)\n    return {\"iou\": iou, \"precision\": precision, \"recall\": recall,\n            \"tp\": tp, \"fp\": fp, \"fn\": fn, \"tn\": tn}\n\n\ndef _global_iou_only(counts, ids):\n    tp = fp = fn = 0\n    for pid in ids:\n        c = counts[pid]\n        tp += c[0]; fp += c[1]; fn += c[2]\n    return tp / (tp + fp + fn + 1e-8)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# 1. SIGNIFICANCE: paired bootstrap on full vs no_opt_dropout\n# ─────────────────────────────────────────────────────────────────────\ndef paired_bootstrap(counts_a, counts_b, n_boot=N_BOOT, seed=RNG_SEED):\n    ids = sorted(set(counts_a) & set(counts_b))\n    rng = np.random.default_rng(seed)\n    point_a = _global_iou_only(counts_a, ids)\n    point_b = _global_iou_only(counts_b, ids)\n    diff = point_a - point_b\n\n    diffs = np.empty(n_boot)\n    for b in range(n_boot):\n        sample = rng.choice(ids, size=len(ids), replace=True)\n        diffs[b] = _global_iou_only(counts_a, sample) - _global_iou_only(counts_b, sample)\n\n    ci_lo, ci_hi = np.percentile(diffs, [2.5, 97.5])\n    p = 2 * min((diffs <= 0).mean(), (diffs >= 0).mean())\n    p = min(p, 1.0)\n    return {\"n_patches\": len(ids), \"iou_a\": round(point_a, 4), \"iou_b\": round(point_b, 4),\n            \"diff\": round(diff, 4), \"ci95_lo\": round(ci_lo, 4), \"ci95_hi\": round(ci_hi, 4),\n            \"p_value\": round(p, 4), \"significant\": bool(p < 0.05)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# MAIN\n# ─────────────────────────────────────────────────────────────────────\ndef main():\n    test_df = get_split_df(MANIFEST_PATH, OFFICIAL_TEST_CSV)\n    bolivia_df = get_split_df(MANIFEST_PATH, OFFICIAL_BOLIVIA_CSV)\n    splits = {\"official_test\": test_df, \"bolivia\": bolivia_df}\n\n    normal_counts = {}   # (variant, split) -> per-patch confusion\n    cloud_counts = {}\n    for variant, path in CHECKPOINTS.items():\n        print(f\"\\nScoring {variant} (normal + cloud-sim, both splits)...\")\n        model = load_model(path)\n        for split_name, df in splits.items():\n            normal_counts[(variant, split_name)] = get_per_patch_confusion(model, df, cloud_sim=False)\n            cloud_counts[(variant, split_name)] = get_per_patch_confusion(model, df, cloud_sim=True)\n        del model\n        torch.cuda.empty_cache()\n\n    # --- 1. Significance: full vs no_opt_dropout, each split ---\n    print(f\"\\n{'='*62}\\n  SIGNIFICANCE — full vs no_opt_dropout ({N_BOOT} bootstrap resamples)\\n{'='*62}\")\n    sig_results = []\n    for split_name in splits:\n        r = paired_bootstrap(normal_counts[(\"full\", split_name)],\n                              normal_counts[(\"no_opt_dropout\", split_name)])\n        r[\"split\"] = split_name\n        sig_results.append(r)\n        verdict = \"SIGNIFICANT\" if r[\"significant\"] else \"not significant\"\n        print(f\"  [{split_name}] full={r['iou_a']:.4f} vs no_opt_dropout={r['iou_b']:.4f}  \"\n              f\"diff={r['diff']:+.4f}  95% CI=[{r['ci95_lo']:+.4f}, {r['ci95_hi']:+.4f}]  \"\n              f\"p={r['p_value']:.4f}  -> {verdict}\")\n\n    # --- 2. Cloud robustness, re-checked on corrected checkpoints ---\n    print(f\"\\n{'='*62}\\n  CLOUD ROBUSTNESS (corrected data + corrected checkpoints)\\n{'='*62}\")\n    robustness_results = []\n    for variant in CHECKPOINTS:\n        for split_name in splits:\n            ids = sorted(normal_counts[(variant, split_name)].keys())\n            normal = _global_from_counts(normal_counts[(variant, split_name)], ids)\n            cloud = _global_from_counts(cloud_counts[(variant, split_name)], ids)\n            degradation_pct = 100.0 * (normal[\"iou\"] - cloud[\"iou\"]) / max(normal[\"iou\"], 1e-8)\n            failure_mode = (\n                \"floods_everything\" if cloud[\"recall\"] > 0.9 and cloud[\"precision\"] < 0.3\n                else \"detects_nothing\" if cloud[\"recall\"] < 0.1\n                else \"partial_degradation\")\n            row = {\"variant\": variant, \"split\": split_name,\n                   \"normal_iou\": round(normal[\"iou\"], 4), \"cloud_iou\": round(cloud[\"iou\"], 4),\n                   \"cloud_precision\": round(cloud[\"precision\"], 4),\n                   \"cloud_recall\": round(cloud[\"recall\"], 4),\n                   \"degradation_pct\": round(degradation_pct, 1), \"failure_mode\": failure_mode}\n            robustness_results.append(row)\n            print(f\"  [{variant} / {split_name}] normal={row['normal_iou']:.4f}  \"\n                  f\"cloud={row['cloud_iou']:.4f}  ({row['degradation_pct']:.1f}% drop, {failure_mode})\")\n\n    with open(\"./significance_results_corrected.json\", \"w\") as f:\n        json.dump(sig_results, f, indent=2)\n    with open(\"./cloud_robustness_corrected.json\", \"w\") as f:\n        json.dump(robustness_results, f, indent=2)\n    print(f\"\\nSaved: significance_results_corrected.json, cloud_robustness_corrected.json\")\n\n    return sig_results, robustness_results\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T00:31:46.171271Z","iopub.execute_input":"2026-09-02T00:31:46.171637Z","iopub.status.idle":"2026-09-02T00:32:55.605076Z","shell.execute_reply.started":"2026-09-02T00:31:46.171604Z","shell.execute_reply":"2026-09-02T00:32:55.604031Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## single_stream_sar","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# Standalone single-run training script — PATCHED for the remaining\n# ablation variants (single_stream_sar, no_sar_ratio, no_optical,\n# no_cbam, symmetric_loss).\n#\n# Two fixes applied vs. the script you ran for full/no_opt_dropout:\n#   1. SAR_ONLY_VARIANTS no longer includes \"no_optical\" — it's a\n#      full-capacity DualStreamUNetPP now, not a small SAR-only model,\n#      so it should NOT get the 4x-lower LR / gentler loss meant for\n#      3-channel models.\n#   2. build_model()'s no_optical branch builds DualStreamUNetPP with\n#      the optical branch zeroed, instead of aliasing SingleStreamSAR.\n# Plus: per-epoch diagnostics (gradient norm, output saturation) merged\n# in from 04, active for every run — cheap, and it's what would have\n# caught single_stream_sar's instability at epoch 10 instead of epoch 85.\n#\n# CHANGE ABLATION_VARIANT BELOW AND RE-RUN FOR EACH OF THE 5 VARIANTS:\n#   \"single_stream_sar\", \"no_sar_ratio\", \"no_optical\", \"no_cbam\", \"symmetric_loss\"\n\nimport os, gc, csv, random, logging, json\n\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG — change this line for each run\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANT = \"single_stream_sar\"  # <-- CHANGE THIS EACH RUN\n\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 8\nACCUM_STEPS      = 4\nNUM_WORKERS      = 4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\nLR               = 2e-4\nPATIENCE         = 25\n\nSAR_ONLY_LR       = 5e-5\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0\nSAR_ONLY_FT_ALPHA = 0.5\nSAR_ONLY_FT_BETA  = 0.5\n\n# FIX #1: no_optical removed — it's full-capacity now, not SAR-only.\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\"}\n\n# ── Diagnostics (merged from 04) ────────────────────────────────────\nDIAG_CHECK_EPOCH = 10\nCOLLAPSE_RECALL_FLOOR = 0.02\nCOLLAPSE_PRED_WATER_CEIL = 0.90\nSATURATION_WARN = 0.98\nAUTO_STOP_ON_COLLAPSE = True   # set False if you want to let a run continue anyway\n\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n              logging.StreamHandler()],\n)\nlog = logging.getLogger(\"manzar_v9\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\": \"MANZAR v9 (calibration-fixed data, dispatch-fixed ablation)\",\n        \"ABLATION_VARIANT\": variant,\n        \"LR\": SAR_ONLY_LR if is_sar else LR,\n        \"PATIENCE\": SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"FT_ALPHA\": SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\": SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\": round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"SEED\": SEED,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f:\n        json.dump(params, f, indent=2)\n    log.info(\"=\" * 62)\n    for k, v in params.items():\n        log.info(f\"  {k:<22} : {v}\")\n    log.info(\"=\" * 62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    log.info(f\"Train: {len(train_df)}  Val: {len(val_df)}\")\n    if len(train_df) == 0:\n        raise RuntimeError(\"0 training patches matched — check patch_id format\")\n    return train_df, val_df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, features_dir, masks_dir\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s, num_workers=num_workers,\n                       pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=num_workers, pin_memory=True)\n\n\ndef opt_drop(epoch, variant):\n    # no_optical's optical input is already always zero; dropping it is\n    # a no-op, so it takes the no-curriculum path like no_opt_dropout.\n    if variant in SAR_ONLY_VARIANTS or variant in (\"no_opt_dropout\", \"no_optical\"):\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# ARCHITECTURE\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"FIX #2: added zero_optical. When True, this is the corrected\n    no_optical ablation — same architecture/param count as `full`, but\n    the optical branch sees zeros. Distinct from SingleStreamSAR, which\n    never has an optical encoder at all.\"\"\"\n\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        if self.zero_optical:\n            opt = torch.zeros_like(opt)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    if variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    if variant == \"no_optical\":\n        # FIX #2: was SingleStreamSAR() — now full-capacity, optical zeroed.\n        return DualStreamUNetPP(use_cbam=True, zero_optical=True)\n    if variant == \"single_stream_sar\":\n        return SingleStreamSAR()\n    if variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    if variant in (\"no_opt_dropout\", \"symmetric_loss\"):\n        return DualStreamUNetPP(use_cbam=True)\n    raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    if variant == \"symmetric_loss\":\n        return HybridLoss(ALPHA_BCE, 0.5, 0.5, FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        return HybridLoss(ALPHA_BCE, SAR_ONLY_FT_ALPHA, SAR_ONLY_FT_BETA, SAR_ONLY_FT_GAMMA)\n    # no_optical falls through to here now — full's loss, matching its\n    # full capacity.\n    return HybridLoss(ALPHA_BCE, FT_ALPHA, FT_BETA, FT_GAMMA)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re,\n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e),\n                \"pred_water_ratio\": (tp + fp) / (tp + tn + fp + fn + e)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DIAGNOSTICS (merged from 04)\n# ─────────────────────────────────────────────────────────────────────\nclass EpochDiagnostics:\n    def __init__(self):\n        self.grad_norms, self.sat_fracs = [], []\n\n    def log_step(self, model, logits):\n        total_sq = 0.0\n        for p in model.parameters():\n            if p.grad is not None:\n                total_sq += p.grad.detach().data.norm(2).item() ** 2\n        self.grad_norms.append(total_sq ** 0.5)\n        with torch.no_grad():\n            probs = torch.sigmoid(logits.detach())\n            self.sat_fracs.append(((probs < 0.01) | (probs > 0.99)).float().mean().item())\n\n    def summary(self):\n        return {\n            \"grad_norm_mean\": float(np.mean(self.grad_norms)) if self.grad_norms else 0.0,\n            \"saturation_mean\": float(np.mean(self.sat_fracs)) if self.sat_fracs else 0.0,\n        }\n\n\ndef check_collapse(val_metrics, diag_summary, epoch, variant):\n    flags = []\n    if val_metrics[\"recall\"] < COLLAPSE_RECALL_FLOOR:\n        flags.append(f\"recall={val_metrics['recall']:.4f} (predicts almost nothing)\")\n    if val_metrics[\"pred_water_ratio\"] > COLLAPSE_PRED_WATER_CEIL:\n        flags.append(f\"pred_water_ratio={val_metrics['pred_water_ratio']:.4f} (predicts almost everything)\")\n    if diag_summary[\"saturation_mean\"] > SATURATION_WARN:\n        flags.append(f\"saturation={diag_summary['saturation_mean']:.4f} (gradients likely dead)\")\n    if flags:\n        log.warning(f\"  [{variant}] ep{epoch+1} COLLAPSE SIGNS: {'; '.join(flags)}\")\n        return True\n    return False\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef train_epoch(model, loader, crit, opt, scaler, device, diag):\n    model.train()\n    rl = 0.0\n    m = RunningMetrics()\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            diag.log_step(model, logits)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics(); m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics(); m.update(ap, at, 0.5); bm, bt = m.compute(), 0.5\n    bm[\"loss\"] = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n    lr = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  is_sar_only_hparams={is_sar}\\n  LR={lr}  Patience={patience}\\n{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=variant)\n    model = build_model(variant).to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters()):,}\")\n\n    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = get_criterion(variant)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    diag_path = os.path.join(LOG_DIR, f\"diagnostics_{variant}.csv\")\n    diagf = open(diag_path, \"w\", newline=\"\")\n    dw = csv.writer(diagf)\n    dw.writerow([\"epoch\", \"grad_norm_mean\", \"saturation_mean\", \"val_recall\",\n                 \"val_iou\", \"val_pred_water_ratio\", \"collapse_flag\", \"smooth_iou\"])\n\n    bv, en = 0.0, 0\n    sv = 0.0\n    pd_prev, tl = None, None\n    consecutive_flags = 0\n\n    for epoch in range(EPOCHS):\n        drop = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        diag = EpochDiagnostics()\n        tm = train_epoch(model, tl, crit, opt, scaler, device, diag)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n        diag_summary = diag.summary()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        collapsed = check_collapse(vm, diag_summary, epoch, variant)\n        consecutive_flags = consecutive_flags + 1 if collapsed else 0\n\n        log.info(\n            f\"  [{variant}] Ep{epoch+1:>3} TL={tm['loss']:.4f} VF1={vm['f1']:.4f} \"\n            f\"VIoU={vi:.4f} Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f} \"\n            f\"gradN={diag_summary['grad_norm_mean']:.3f} sat={diag_summary['saturation_mean']:.3f}\"\n        )\n        dw.writerow([epoch+1, diag_summary[\"grad_norm_mean\"], diag_summary[\"saturation_mean\"],\n                     vm[\"recall\"], vi, vm[\"pred_water_ratio\"], collapsed, sv])\n        diagf.flush()\n\n        if sv > bv:\n            bv, en = sv, 0\n            torch.save(model.state_dict(), best_path)\n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if epoch + 1 >= DIAG_CHECK_EPOCH and AUTO_STOP_ON_COLLAPSE and consecutive_flags >= 3:\n            log.error(\n                f\"  [{variant}] STOPPING EARLY at epoch {epoch+1}: collapse signs persisted \"\n                f\"{consecutive_flags} consecutive epochs. This variant needs investigation, \"\n                f\"not more training time. Diagnostics: {diag_path}\"\n            )\n            break\n\n        if en >= patience:\n            log.info(f\"  [{variant}] Early stop at epoch {epoch+1}\")\n            break\n\n    diagf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache(); gc.collect()\n    save_hyperparams(ABLATION_VARIANT)\n    train_df, val_df = make_official_splits(MANIFEST_PATH)\n    train_single(train_df, val_df, ABLATION_VARIANT)\n\n\nmain()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T16:14:55.843565Z","iopub.execute_input":"2026-09-02T16:14:55.844291Z","iopub.status.idle":"2026-09-02T17:56:00.313498Z","shell.execute_reply.started":"2026-09-02T16:14:55.84425Z","shell.execute_reply":"2026-09-02T17:56:00.312749Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## No_Sar_ratio","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# Standalone single-run training script — PATCHED for the remaining\n# ablation variants (single_stream_sar, no_sar_ratio, no_optical,\n# no_cbam, symmetric_loss).\n#\n# Two fixes applied vs. the script you ran for full/no_opt_dropout:\n#   1. SAR_ONLY_VARIANTS no longer includes \"no_optical\" — it's a\n#      full-capacity DualStreamUNetPP now, not a small SAR-only model,\n#      so it should NOT get the 4x-lower LR / gentler loss meant for\n#      3-channel models.\n#   2. build_model()'s no_optical branch builds DualStreamUNetPP with\n#      the optical branch zeroed, instead of aliasing SingleStreamSAR.\n# Plus: per-epoch diagnostics (gradient norm, output saturation) merged\n# in from 04, active for every run — cheap, and it's what would have\n# caught single_stream_sar's instability at epoch 10 instead of epoch 85.\n#\n# CHANGE ABLATION_VARIANT BELOW AND RE-RUN FOR EACH OF THE 5 VARIANTS:\n#   \"single_stream_sar\", \"no_sar_ratio\", \"no_optical\", \"no_cbam\", \"symmetric_loss\"\n\nimport os, gc, csv, random, logging, json\n\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG — change this line for each run\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANT = \"no_sar_ratio\"  # <-- CHANGE THIS EACH RUN\n\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 8\nACCUM_STEPS      = 4\nNUM_WORKERS      = 4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\nLR               = 2e-4\nPATIENCE         = 25\n\nSAR_ONLY_LR       = 5e-5\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0\nSAR_ONLY_FT_ALPHA = 0.5\nSAR_ONLY_FT_BETA  = 0.5\n\n# FIX #1: no_optical removed — it's full-capacity now, not SAR-only.\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\"}\n\n# ── Diagnostics (merged from 04) ────────────────────────────────────\nDIAG_CHECK_EPOCH = 10\nCOLLAPSE_RECALL_FLOOR = 0.02\nCOLLAPSE_PRED_WATER_CEIL = 0.90\nSATURATION_WARN = 0.98\nAUTO_STOP_ON_COLLAPSE = True   # set False if you want to let a run continue anyway\n\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n              logging.StreamHandler()],\n)\nlog = logging.getLogger(\"manzar_v9\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\": \"MANZAR v9 (calibration-fixed data, dispatch-fixed ablation)\",\n        \"ABLATION_VARIANT\": variant,\n        \"LR\": SAR_ONLY_LR if is_sar else LR,\n        \"PATIENCE\": SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"FT_ALPHA\": SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\": SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\": round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"SEED\": SEED,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f:\n        json.dump(params, f, indent=2)\n    log.info(\"=\" * 62)\n    for k, v in params.items():\n        log.info(f\"  {k:<22} : {v}\")\n    log.info(\"=\" * 62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    log.info(f\"Train: {len(train_df)}  Val: {len(val_df)}\")\n    if len(train_df) == 0:\n        raise RuntimeError(\"0 training patches matched — check patch_id format\")\n    return train_df, val_df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, features_dir, masks_dir\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s, num_workers=num_workers,\n                       pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=num_workers, pin_memory=True)\n\n\ndef opt_drop(epoch, variant):\n    # no_optical's optical input is already always zero; dropping it is\n    # a no-op, so it takes the no-curriculum path like no_opt_dropout.\n    if variant in SAR_ONLY_VARIANTS or variant in (\"no_opt_dropout\", \"no_optical\"):\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# ARCHITECTURE\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"FIX #2: added zero_optical. When True, this is the corrected\n    no_optical ablation — same architecture/param count as `full`, but\n    the optical branch sees zeros. Distinct from SingleStreamSAR, which\n    never has an optical encoder at all.\"\"\"\n\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        if self.zero_optical:\n            opt = torch.zeros_like(opt)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    if variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    if variant == \"no_optical\":\n        # FIX #2: was SingleStreamSAR() — now full-capacity, optical zeroed.\n        return DualStreamUNetPP(use_cbam=True, zero_optical=True)\n    if variant == \"single_stream_sar\":\n        return SingleStreamSAR()\n    if variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    if variant in (\"no_opt_dropout\", \"symmetric_loss\"):\n        return DualStreamUNetPP(use_cbam=True)\n    raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    if variant == \"symmetric_loss\":\n        return HybridLoss(ALPHA_BCE, 0.5, 0.5, FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        return HybridLoss(ALPHA_BCE, SAR_ONLY_FT_ALPHA, SAR_ONLY_FT_BETA, SAR_ONLY_FT_GAMMA)\n    # no_optical falls through to here now — full's loss, matching its\n    # full capacity.\n    return HybridLoss(ALPHA_BCE, FT_ALPHA, FT_BETA, FT_GAMMA)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re,\n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e),\n                \"pred_water_ratio\": (tp + fp) / (tp + tn + fp + fn + e)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DIAGNOSTICS (merged from 04)\n# ─────────────────────────────────────────────────────────────────────\nclass EpochDiagnostics:\n    def __init__(self):\n        self.grad_norms, self.sat_fracs = [], []\n\n    def log_step(self, model, logits):\n        total_sq = 0.0\n        for p in model.parameters():\n            if p.grad is not None:\n                total_sq += p.grad.detach().data.norm(2).item() ** 2\n        self.grad_norms.append(total_sq ** 0.5)\n        with torch.no_grad():\n            probs = torch.sigmoid(logits.detach())\n            self.sat_fracs.append(((probs < 0.01) | (probs > 0.99)).float().mean().item())\n\n    def summary(self):\n        return {\n            \"grad_norm_mean\": float(np.mean(self.grad_norms)) if self.grad_norms else 0.0,\n            \"saturation_mean\": float(np.mean(self.sat_fracs)) if self.sat_fracs else 0.0,\n        }\n\n\ndef check_collapse(val_metrics, diag_summary, epoch, variant):\n    flags = []\n    if val_metrics[\"recall\"] < COLLAPSE_RECALL_FLOOR:\n        flags.append(f\"recall={val_metrics['recall']:.4f} (predicts almost nothing)\")\n    if val_metrics[\"pred_water_ratio\"] > COLLAPSE_PRED_WATER_CEIL:\n        flags.append(f\"pred_water_ratio={val_metrics['pred_water_ratio']:.4f} (predicts almost everything)\")\n    if diag_summary[\"saturation_mean\"] > SATURATION_WARN:\n        flags.append(f\"saturation={diag_summary['saturation_mean']:.4f} (gradients likely dead)\")\n    if flags:\n        log.warning(f\"  [{variant}] ep{epoch+1} COLLAPSE SIGNS: {'; '.join(flags)}\")\n        return True\n    return False\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef train_epoch(model, loader, crit, opt, scaler, device, diag):\n    model.train()\n    rl = 0.0\n    m = RunningMetrics()\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            diag.log_step(model, logits)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics(); m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics(); m.update(ap, at, 0.5); bm, bt = m.compute(), 0.5\n    bm[\"loss\"] = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n    lr = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  is_sar_only_hparams={is_sar}\\n  LR={lr}  Patience={patience}\\n{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=variant)\n    model = build_model(variant).to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters()):,}\")\n\n    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = get_criterion(variant)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    diag_path = os.path.join(LOG_DIR, f\"diagnostics_{variant}.csv\")\n    diagf = open(diag_path, \"w\", newline=\"\")\n    dw = csv.writer(diagf)\n    dw.writerow([\"epoch\", \"grad_norm_mean\", \"saturation_mean\", \"val_recall\",\n                 \"val_iou\", \"val_pred_water_ratio\", \"collapse_flag\", \"smooth_iou\"])\n\n    bv, en = 0.0, 0\n    sv = 0.0\n    pd_prev, tl = None, None\n    consecutive_flags = 0\n\n    for epoch in range(EPOCHS):\n        drop = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        diag = EpochDiagnostics()\n        tm = train_epoch(model, tl, crit, opt, scaler, device, diag)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n        diag_summary = diag.summary()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        collapsed = check_collapse(vm, diag_summary, epoch, variant)\n        consecutive_flags = consecutive_flags + 1 if collapsed else 0\n\n        log.info(\n            f\"  [{variant}] Ep{epoch+1:>3} TL={tm['loss']:.4f} VF1={vm['f1']:.4f} \"\n            f\"VIoU={vi:.4f} Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f} \"\n            f\"gradN={diag_summary['grad_norm_mean']:.3f} sat={diag_summary['saturation_mean']:.3f}\"\n        )\n        dw.writerow([epoch+1, diag_summary[\"grad_norm_mean\"], diag_summary[\"saturation_mean\"],\n                     vm[\"recall\"], vi, vm[\"pred_water_ratio\"], collapsed, sv])\n        diagf.flush()\n\n        if sv > bv:\n            bv, en = sv, 0\n            torch.save(model.state_dict(), best_path)\n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if epoch + 1 >= DIAG_CHECK_EPOCH and AUTO_STOP_ON_COLLAPSE and consecutive_flags >= 3:\n            log.error(\n                f\"  [{variant}] STOPPING EARLY at epoch {epoch+1}: collapse signs persisted \"\n                f\"{consecutive_flags} consecutive epochs. This variant needs investigation, \"\n                f\"not more training time. Diagnostics: {diag_path}\"\n            )\n            break\n\n        if en >= patience:\n            log.info(f\"  [{variant}] Early stop at epoch {epoch+1}\")\n            break\n\n    diagf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache(); gc.collect()\n    save_hyperparams(ABLATION_VARIANT)\n    train_df, val_df = make_official_splits(MANIFEST_PATH)\n    train_single(train_df, val_df, ABLATION_VARIANT)\n\n\nmain()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T18:09:02.029052Z","iopub.execute_input":"2026-09-02T18:09:02.029368Z","iopub.status.idle":"2026-09-02T19:50:27.631091Z","shell.execute_reply.started":"2026-09-02T18:09:02.029339Z","shell.execute_reply":"2026-09-02T19:50:27.630352Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## no_optical","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# Standalone single-run training script — PATCHED for the remaining\n# ablation variants (single_stream_sar, no_sar_ratio, no_optical,\n# no_cbam, symmetric_loss).\n#\n# Added Multi-GPU support (nn.DataParallel) to fix CUDA OOM on Kaggle T4s.\n\nimport os\n# Set this before importing torch to mitigate Kaggle memory fragmentation\nos.environ[\"PYTORCH_ALLOC_CONF\"] = \"expandable_segments:True\"\n\nimport gc, csv, random, logging, json\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG — change this line for each run\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANT = \"no_optical\"  # <-- CHANGE THIS EACH RUN\n\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 4\nACCUM_STEPS      = 8\nNUM_WORKERS      = 4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\nLR               = 2e-4\nPATIENCE         = 25\n\nSAR_ONLY_LR       = 5e-5\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0\nSAR_ONLY_FT_ALPHA = 0.5\nSAR_ONLY_FT_BETA  = 0.5\n\n# FIX #1: no_optical removed — it's full-capacity now, not SAR-only.\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\"}\n\n# ── Diagnostics (merged from 04) ────────────────────────────────────\nDIAG_CHECK_EPOCH = 10\nCOLLAPSE_RECALL_FLOOR = 0.02\nCOLLAPSE_PRED_WATER_CEIL = 0.90\nSATURATION_WARN = 0.98\nAUTO_STOP_ON_COLLAPSE = True   # set False if you want to let a run continue anyway\n\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n              logging.StreamHandler()],\n)\nlog = logging.getLogger(\"manzar_v9\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\": \"MANZAR v9 (calibration-fixed data, dispatch-fixed ablation)\",\n        \"ABLATION_VARIANT\": variant,\n        \"LR\": SAR_ONLY_LR if is_sar else LR,\n        \"PATIENCE\": SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"FT_ALPHA\": SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\": SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\": round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"SEED\": SEED,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f:\n        json.dump(params, f, indent=2)\n    log.info(\"=\" * 62)\n    for k, v in params.items():\n        log.info(f\"  {k:<22} : {v}\")\n    log.info(\"=\" * 62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    log.info(f\"Train: {len(train_df)}  Val: {len(val_df)}\")\n    if len(train_df) == 0:\n        raise RuntimeError(\"0 training patches matched — check patch_id format\")\n    return train_df, val_df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, features_dir, masks_dir\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s, num_workers=num_workers,\n                       pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=num_workers, pin_memory=True)\n\n\ndef opt_drop(epoch, variant):\n    # no_optical's optical input is already always zero; dropping it is\n    # a no-op, so it takes the no-curriculum path like no_opt_dropout.\n    if variant in SAR_ONLY_VARIANTS or variant in (\"no_opt_dropout\", \"no_optical\"):\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# ARCHITECTURE\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"FIX #2: added zero_optical. When True, this is the corrected\n    no_optical ablation — same architecture/param count as `full`, but\n    the optical branch sees zeros. Distinct from SingleStreamSAR, which\n    never has an optical encoder at all.\"\"\"\n\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        if self.zero_optical:\n            opt = torch.zeros_like(opt)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    if variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    if variant == \"no_optical\":\n        # FIX #2: was SingleStreamSAR() — now full-capacity, optical zeroed.\n        return DualStreamUNetPP(use_cbam=True, zero_optical=True)\n    if variant == \"single_stream_sar\":\n        return SingleStreamSAR()\n    if variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    if variant in (\"no_opt_dropout\", \"symmetric_loss\"):\n        return DualStreamUNetPP(use_cbam=True)\n    raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    if variant == \"symmetric_loss\":\n        return HybridLoss(ALPHA_BCE, 0.5, 0.5, FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        return HybridLoss(ALPHA_BCE, SAR_ONLY_FT_ALPHA, SAR_ONLY_FT_BETA, SAR_ONLY_FT_GAMMA)\n    # no_optical falls through to here now — full's loss, matching its\n    # full capacity.\n    return HybridLoss(ALPHA_BCE, FT_ALPHA, FT_BETA, FT_GAMMA)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re,\n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e),\n                \"pred_water_ratio\": (tp + fp) / (tp + tn + fp + fn + e)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DIAGNOSTICS (merged from 04)\n# ─────────────────────────────────────────────────────────────────────\nclass EpochDiagnostics:\n    def __init__(self):\n        self.grad_norms, self.sat_fracs = [], []\n\n    def log_step(self, model, logits):\n        total_sq = 0.0\n        for p in model.parameters():\n            if p.grad is not None:\n                total_sq += p.grad.detach().data.norm(2).item() ** 2\n        self.grad_norms.append(total_sq ** 0.5)\n        with torch.no_grad():\n            probs = torch.sigmoid(logits.detach())\n            self.sat_fracs.append(((probs < 0.01) | (probs > 0.99)).float().mean().item())\n\n    def summary(self):\n        return {\n            \"grad_norm_mean\": float(np.mean(self.grad_norms)) if self.grad_norms else 0.0,\n            \"saturation_mean\": float(np.mean(self.sat_fracs)) if self.sat_fracs else 0.0,\n        }\n\n\ndef check_collapse(val_metrics, diag_summary, epoch, variant):\n    flags = []\n    if val_metrics[\"recall\"] < COLLAPSE_RECALL_FLOOR:\n        flags.append(f\"recall={val_metrics['recall']:.4f} (predicts almost nothing)\")\n    if val_metrics[\"pred_water_ratio\"] > COLLAPSE_PRED_WATER_CEIL:\n        flags.append(f\"pred_water_ratio={val_metrics['pred_water_ratio']:.4f} (predicts almost everything)\")\n    if diag_summary[\"saturation_mean\"] > SATURATION_WARN:\n        flags.append(f\"saturation={diag_summary['saturation_mean']:.4f} (gradients likely dead)\")\n    if flags:\n        log.warning(f\"  [{variant}] ep{epoch+1} COLLAPSE SIGNS: {'; '.join(flags)}\")\n        return True\n    return False\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef train_epoch(model, loader, crit, opt, scaler, device, diag):\n    model.train()\n    rl = 0.0\n    m = RunningMetrics()\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            diag.log_step(model, logits)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics(); m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics(); m.update(ap, at, 0.5); bm, bt = m.compute(), 0.5\n    bm[\"loss\"] = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n    lr = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  is_sar_only_hparams={is_sar}\\n  LR={lr}  Patience={patience}\\n{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=variant)\n    \n    # Generate model architecture\n    model = build_model(variant)\n    \n    # Distribute model across GPUs if multiple exist\n    if torch.cuda.device_count() > 1:\n        log.info(f\"  Distributing physical batch across {torch.cuda.device_count()} GPUs\")\n        model = nn.DataParallel(model)\n        \n    model = model.to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters()):,}\")\n\n    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = get_criterion(variant)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    diag_path = os.path.join(LOG_DIR, f\"diagnostics_{variant}.csv\")\n    diagf = open(diag_path, \"w\", newline=\"\")\n    dw = csv.writer(diagf)\n    dw.writerow([\"epoch\", \"grad_norm_mean\", \"saturation_mean\", \"val_recall\",\n                 \"val_iou\", \"val_pred_water_ratio\", \"collapse_flag\", \"smooth_iou\"])\n\n    bv, en = 0.0, 0\n    sv = 0.0\n    pd_prev, tl = None, None\n    consecutive_flags = 0\n\n    for epoch in range(EPOCHS):\n        drop = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        diag = EpochDiagnostics()\n        tm = train_epoch(model, tl, crit, opt, scaler, device, diag)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n        diag_summary = diag.summary()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        collapsed = check_collapse(vm, diag_summary, epoch, variant)\n        consecutive_flags = consecutive_flags + 1 if collapsed else 0\n\n        log.info(\n            f\"  [{variant}] Ep{epoch+1:>3} TL={tm['loss']:.4f} VF1={vm['f1']:.4f} \"\n            f\"VIoU={vi:.4f} Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f} \"\n            f\"gradN={diag_summary['grad_norm_mean']:.3f} sat={diag_summary['saturation_mean']:.3f}\"\n        )\n        dw.writerow([epoch+1, diag_summary[\"grad_norm_mean\"], diag_summary[\"saturation_mean\"],\n                     vm[\"recall\"], vi, vm[\"pred_water_ratio\"], collapsed, sv])\n        diagf.flush()\n\n        if sv > bv:\n            bv, en = sv, 0\n            \n            # Strip 'module.' prefix before saving if wrapped in DataParallel\n            state_dict = model.module.state_dict() if isinstance(model, nn.DataParallel) else model.state_dict()\n            torch.save(state_dict, best_path)\n            \n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if epoch + 1 >= DIAG_CHECK_EPOCH and AUTO_STOP_ON_COLLAPSE and consecutive_flags >= 3:\n            log.error(\n                f\"  [{variant}] STOPPING EARLY at epoch {epoch+1}: collapse signs persisted \"\n                f\"{consecutive_flags} consecutive epochs. This variant needs investigation, \"\n                f\"not more training time. Diagnostics: {diag_path}\"\n            )\n            break\n\n        if en >= patience:\n            log.info(f\"  [{variant}] Early stop at epoch {epoch+1}\")\n            break\n\n    diagf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache(); gc.collect()\n    save_hyperparams(ABLATION_VARIANT)\n    train_df, val_df = make_official_splits(MANIFEST_PATH)\n    train_single(train_df, val_df, ABLATION_VARIANT)\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T20:46:46.883155Z","iopub.execute_input":"2026-09-02T20:46:46.884123Z","iopub.status.idle":"2026-09-02T21:39:26.030745Z","shell.execute_reply.started":"2026-09-02T20:46:46.884087Z","shell.execute_reply":"2026-09-02T21:39:26.029906Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## no_cbam","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# Standalone single-run training script — PATCHED for the remaining\n# ablation variants (single_stream_sar, no_sar_ratio, no_optical,\n# no_cbam, symmetric_loss).\n#\n# Added Multi-GPU support (nn.DataParallel) to fix CUDA OOM on Kaggle T4s.\n\nimport os\n# Set this before importing torch to mitigate Kaggle memory fragmentation\nos.environ[\"PYTORCH_ALLOC_CONF\"] = \"expandable_segments:True\"\n\nimport gc, csv, random, logging, json\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG — change this line for each run\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANT = \"no_cbam\"  # <-- CHANGE THIS EACH RUN\n\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 4\nACCUM_STEPS      = 8\nNUM_WORKERS      = 4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\nLR               = 2e-4\nPATIENCE         = 25\n\nSAR_ONLY_LR       = 5e-5\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0\nSAR_ONLY_FT_ALPHA = 0.5\nSAR_ONLY_FT_BETA  = 0.5\n\n# FIX #1: no_optical removed — it's full-capacity now, not SAR-only.\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\"}\n\n# ── Diagnostics (merged from 04) ────────────────────────────────────\nDIAG_CHECK_EPOCH = 10\nCOLLAPSE_RECALL_FLOOR = 0.02\nCOLLAPSE_PRED_WATER_CEIL = 0.90\nSATURATION_WARN = 0.98\nAUTO_STOP_ON_COLLAPSE = True   # set False if you want to let a run continue anyway\n\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n              logging.StreamHandler()],\n)\nlog = logging.getLogger(\"manzar_v9\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\": \"MANZAR v9 (calibration-fixed data, dispatch-fixed ablation)\",\n        \"ABLATION_VARIANT\": variant,\n        \"LR\": SAR_ONLY_LR if is_sar else LR,\n        \"PATIENCE\": SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"FT_ALPHA\": SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\": SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\": round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"SEED\": SEED,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f:\n        json.dump(params, f, indent=2)\n    log.info(\"=\" * 62)\n    for k, v in params.items():\n        log.info(f\"  {k:<22} : {v}\")\n    log.info(\"=\" * 62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    log.info(f\"Train: {len(train_df)}  Val: {len(val_df)}\")\n    if len(train_df) == 0:\n        raise RuntimeError(\"0 training patches matched — check patch_id format\")\n    return train_df, val_df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, features_dir, masks_dir\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s, num_workers=num_workers,\n                       pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=num_workers, pin_memory=True)\n\n\ndef opt_drop(epoch, variant):\n    # no_optical's optical input is already always zero; dropping it is\n    # a no-op, so it takes the no-curriculum path like no_opt_dropout.\n    if variant in SAR_ONLY_VARIANTS or variant in (\"no_opt_dropout\", \"no_optical\"):\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# ARCHITECTURE\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"FIX #2: added zero_optical. When True, this is the corrected\n    no_optical ablation — same architecture/param count as `full`, but\n    the optical branch sees zeros. Distinct from SingleStreamSAR, which\n    never has an optical encoder at all.\"\"\"\n\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        if self.zero_optical:\n            opt = torch.zeros_like(opt)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    if variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    if variant == \"no_optical\":\n        # FIX #2: was SingleStreamSAR() — now full-capacity, optical zeroed.\n        return DualStreamUNetPP(use_cbam=True, zero_optical=True)\n    if variant == \"single_stream_sar\":\n        return SingleStreamSAR()\n    if variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    if variant in (\"no_opt_dropout\", \"symmetric_loss\"):\n        return DualStreamUNetPP(use_cbam=True)\n    raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    if variant == \"symmetric_loss\":\n        return HybridLoss(ALPHA_BCE, 0.5, 0.5, FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        return HybridLoss(ALPHA_BCE, SAR_ONLY_FT_ALPHA, SAR_ONLY_FT_BETA, SAR_ONLY_FT_GAMMA)\n    # no_optical falls through to here now — full's loss, matching its\n    # full capacity.\n    return HybridLoss(ALPHA_BCE, FT_ALPHA, FT_BETA, FT_GAMMA)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re,\n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e),\n                \"pred_water_ratio\": (tp + fp) / (tp + tn + fp + fn + e)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DIAGNOSTICS (merged from 04)\n# ─────────────────────────────────────────────────────────────────────\nclass EpochDiagnostics:\n    def __init__(self):\n        self.grad_norms, self.sat_fracs = [], []\n\n    def log_step(self, model, logits):\n        total_sq = 0.0\n        for p in model.parameters():\n            if p.grad is not None:\n                total_sq += p.grad.detach().data.norm(2).item() ** 2\n        self.grad_norms.append(total_sq ** 0.5)\n        with torch.no_grad():\n            probs = torch.sigmoid(logits.detach())\n            self.sat_fracs.append(((probs < 0.01) | (probs > 0.99)).float().mean().item())\n\n    def summary(self):\n        return {\n            \"grad_norm_mean\": float(np.mean(self.grad_norms)) if self.grad_norms else 0.0,\n            \"saturation_mean\": float(np.mean(self.sat_fracs)) if self.sat_fracs else 0.0,\n        }\n\n\ndef check_collapse(val_metrics, diag_summary, epoch, variant):\n    flags = []\n    if val_metrics[\"recall\"] < COLLAPSE_RECALL_FLOOR:\n        flags.append(f\"recall={val_metrics['recall']:.4f} (predicts almost nothing)\")\n    if val_metrics[\"pred_water_ratio\"] > COLLAPSE_PRED_WATER_CEIL:\n        flags.append(f\"pred_water_ratio={val_metrics['pred_water_ratio']:.4f} (predicts almost everything)\")\n    if diag_summary[\"saturation_mean\"] > SATURATION_WARN:\n        flags.append(f\"saturation={diag_summary['saturation_mean']:.4f} (gradients likely dead)\")\n    if flags:\n        log.warning(f\"  [{variant}] ep{epoch+1} COLLAPSE SIGNS: {'; '.join(flags)}\")\n        return True\n    return False\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef train_epoch(model, loader, crit, opt, scaler, device, diag):\n    model.train()\n    rl = 0.0\n    m = RunningMetrics()\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            diag.log_step(model, logits)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics(); m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics(); m.update(ap, at, 0.5); bm, bt = m.compute(), 0.5\n    bm[\"loss\"] = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n    lr = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  is_sar_only_hparams={is_sar}\\n  LR={lr}  Patience={patience}\\n{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=variant)\n    \n    # Generate model architecture\n    model = build_model(variant)\n    \n    # Distribute model across GPUs if multiple exist\n    if torch.cuda.device_count() > 1:\n        log.info(f\"  Distributing physical batch across {torch.cuda.device_count()} GPUs\")\n        model = nn.DataParallel(model)\n        \n    model = model.to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters()):,}\")\n\n    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = get_criterion(variant)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    diag_path = os.path.join(LOG_DIR, f\"diagnostics_{variant}.csv\")\n    diagf = open(diag_path, \"w\", newline=\"\")\n    dw = csv.writer(diagf)\n    dw.writerow([\"epoch\", \"grad_norm_mean\", \"saturation_mean\", \"val_recall\",\n                 \"val_iou\", \"val_pred_water_ratio\", \"collapse_flag\", \"smooth_iou\"])\n\n    bv, en = 0.0, 0\n    sv = 0.0\n    pd_prev, tl = None, None\n    consecutive_flags = 0\n\n    for epoch in range(EPOCHS):\n        drop = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        diag = EpochDiagnostics()\n        tm = train_epoch(model, tl, crit, opt, scaler, device, diag)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n        diag_summary = diag.summary()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        collapsed = check_collapse(vm, diag_summary, epoch, variant)\n        consecutive_flags = consecutive_flags + 1 if collapsed else 0\n\n        log.info(\n            f\"  [{variant}] Ep{epoch+1:>3} TL={tm['loss']:.4f} VF1={vm['f1']:.4f} \"\n            f\"VIoU={vi:.4f} Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f} \"\n            f\"gradN={diag_summary['grad_norm_mean']:.3f} sat={diag_summary['saturation_mean']:.3f}\"\n        )\n        dw.writerow([epoch+1, diag_summary[\"grad_norm_mean\"], diag_summary[\"saturation_mean\"],\n                     vm[\"recall\"], vi, vm[\"pred_water_ratio\"], collapsed, sv])\n        diagf.flush()\n\n        if sv > bv:\n            bv, en = sv, 0\n            \n            # Strip 'module.' prefix before saving if wrapped in DataParallel\n            state_dict = model.module.state_dict() if isinstance(model, nn.DataParallel) else model.state_dict()\n            torch.save(state_dict, best_path)\n            \n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if epoch + 1 >= DIAG_CHECK_EPOCH and AUTO_STOP_ON_COLLAPSE and consecutive_flags >= 3:\n            log.error(\n                f\"  [{variant}] STOPPING EARLY at epoch {epoch+1}: collapse signs persisted \"\n                f\"{consecutive_flags} consecutive epochs. This variant needs investigation, \"\n                f\"not more training time. Diagnostics: {diag_path}\"\n            )\n            break\n\n        if en >= patience:\n            log.info(f\"  [{variant}] Early stop at epoch {epoch+1}\")\n            break\n\n    diagf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache(); gc.collect()\n    save_hyperparams(ABLATION_VARIANT)\n    train_df, val_df = make_official_splits(MANIFEST_PATH)\n    train_single(train_df, val_df, ABLATION_VARIANT)\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-02T21:45:12.830551Z","iopub.execute_input":"2026-09-02T21:45:12.831357Z","iopub.status.idle":"2026-09-02T23:43:36.483162Z","shell.execute_reply.started":"2026-09-02T21:45:12.831319Z","shell.execute_reply":"2026-09-02T23:43:36.482258Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### fix no optical batchnorm collapse","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# Single-cell script: retrain no_optical with fix #6 applied\n# (skips opt_encoder entirely instead of feeding it a constant-zero\n# tensor, avoiding the BatchNorm-on-degenerate-input collapse).\n# Includes multi-GPU DataParallel support to match your environment.\n\nimport os, gc, csv, random, logging, json\n\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANT = \"no_optical\"\n\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 8\nACCUM_STEPS      = 4\nNUM_WORKERS      = 4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\nLR               = 2e-4\nPATIENCE         = 25\n\nSAR_ONLY_LR       = 5e-5\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0\nSAR_ONLY_FT_ALPHA = 0.5\nSAR_ONLY_FT_BETA  = 0.5\n\n# no_optical is NOT in here — it's full-capacity, uses full's hyperparams.\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\"}\n\nDIAG_CHECK_EPOCH = 10\nCOLLAPSE_RECALL_FLOOR = 0.02\nCOLLAPSE_PRED_WATER_CEIL = 0.90\nSATURATION_WARN = 0.98\nAUTO_STOP_ON_COLLAPSE = True\n\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n              logging.StreamHandler()],\n)\nlog = logging.getLogger(\"manzar_v9_fix6\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\": \"MANZAR v9 + fix6 (no_optical BatchNorm collapse fix)\",\n        \"ABLATION_VARIANT\": variant,\n        \"LR\": SAR_ONLY_LR if is_sar else LR,\n        \"PATIENCE\": SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"FT_ALPHA\": SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\": SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\": round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"SEED\": SEED,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f:\n        json.dump(params, f, indent=2)\n    log.info(\"=\" * 62)\n    for k, v in params.items():\n        log.info(f\"  {k:<22} : {v}\")\n    log.info(\"=\" * 62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    log.info(f\"Train: {len(train_df)}  Val: {len(val_df)}\")\n    if len(train_df) == 0:\n        raise RuntimeError(\"0 training patches matched — check patch_id format\")\n    return train_df, val_df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, features_dir, masks_dir\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s, num_workers=num_workers,\n                       pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=num_workers, pin_memory=True)\n\n\ndef opt_drop(epoch, variant):\n    if variant in SAR_ONLY_VARIANTS or variant in (\"no_opt_dropout\", \"no_optical\"):\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# ARCHITECTURE — FIX #6 APPLIED HERE\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"FIX #6: zero_optical now SKIPS opt_encoder entirely instead of\n    running a constant-zero tensor through it (which was numerically\n    degenerate for opt_encoder's BatchNorm layers and caused periodic\n    \"predicts everything\" collapse). Substitutes a literal zero FEATURE\n    tensor of the right shape instead. opt_encoder still exists (kept\n    for param-count parity with `full`) but is never called in this\n    mode, so it never receives gradients — correct, since there's\n    nothing to learn from a constant input.\"\"\"\n\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        sar_feat = self.sar_encoder(sar)\n\n        if self.zero_optical:\n            # FIX #6: zero FEATURES, not zero input through BatchNorm.\n            opt_feat = torch.zeros_like(sar_feat)\n        else:\n            opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n            opt_feat = self.opt_encoder(opt)\n\n        f = torch.cat([sar_feat, opt_feat], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    if variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    if variant == \"no_optical\":\n        return DualStreamUNetPP(use_cbam=True, zero_optical=True)  # FIX #6 applied\n    if variant == \"single_stream_sar\":\n        return SingleStreamSAR()\n    if variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    if variant in (\"no_opt_dropout\", \"symmetric_loss\"):\n        return DualStreamUNetPP(use_cbam=True)\n    raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    if variant == \"symmetric_loss\":\n        return HybridLoss(ALPHA_BCE, 0.5, 0.5, FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        return HybridLoss(ALPHA_BCE, SAR_ONLY_FT_ALPHA, SAR_ONLY_FT_BETA, SAR_ONLY_FT_GAMMA)\n    return HybridLoss(ALPHA_BCE, FT_ALPHA, FT_BETA, FT_GAMMA)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re,\n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e),\n                \"pred_water_ratio\": (tp + fp) / (tp + tn + fp + fn + e)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DIAGNOSTICS\n# ─────────────────────────────────────────────────────────────────────\nclass EpochDiagnostics:\n    def __init__(self):\n        self.grad_norms, self.sat_fracs = [], []\n\n    def log_step(self, model, logits):\n        total_sq = 0.0\n        for p in model.parameters():\n            if p.grad is not None:\n                total_sq += p.grad.detach().data.norm(2).item() ** 2\n        self.grad_norms.append(total_sq ** 0.5)\n        with torch.no_grad():\n            probs = torch.sigmoid(logits.detach())\n            self.sat_fracs.append(((probs < 0.01) | (probs > 0.99)).float().mean().item())\n\n    def summary(self):\n        return {\n            \"grad_norm_mean\": float(np.mean(self.grad_norms)) if self.grad_norms else 0.0,\n            \"saturation_mean\": float(np.mean(self.sat_fracs)) if self.sat_fracs else 0.0,\n        }\n\n\ndef check_collapse(val_metrics, diag_summary, epoch, variant):\n    flags = []\n    if val_metrics[\"recall\"] < COLLAPSE_RECALL_FLOOR:\n        flags.append(f\"recall={val_metrics['recall']:.4f} (predicts almost nothing)\")\n    if val_metrics[\"pred_water_ratio\"] > COLLAPSE_PRED_WATER_CEIL:\n        flags.append(f\"pred_water_ratio={val_metrics['pred_water_ratio']:.4f} (predicts almost everything)\")\n    if diag_summary[\"saturation_mean\"] > SATURATION_WARN:\n        flags.append(f\"saturation={diag_summary['saturation_mean']:.4f} (gradients likely dead)\")\n    if flags:\n        log.warning(f\"  [{variant}] ep{epoch+1} COLLAPSE SIGNS: {'; '.join(flags)}\")\n        return True\n    return False\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef train_epoch(model, loader, crit, opt, scaler, device, diag):\n    model.train()\n    rl = 0.0\n    m = RunningMetrics()\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            diag.log_step(model, logits)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics(); m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics(); m.update(ap, at, 0.5); bm, bt = m.compute(), 0.5\n    bm[\"loss\"] = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n    lr = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  is_sar_only_hparams={is_sar}\\n  LR={lr}  Patience={patience}\\n{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=variant)\n    model = build_model(variant)\n    if torch.cuda.device_count() > 1:\n        log.info(f\"  Distributing physical batch across {torch.cuda.device_count()} GPUs\")\n        model = nn.DataParallel(model)\n    model = model.to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters()):,}\")\n\n    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = get_criterion(variant)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    diag_path = os.path.join(LOG_DIR, f\"diagnostics_{variant}.csv\")\n    diagf = open(diag_path, \"w\", newline=\"\")\n    dw = csv.writer(diagf)\n    dw.writerow([\"epoch\", \"grad_norm_mean\", \"saturation_mean\", \"val_recall\",\n                 \"val_iou\", \"val_pred_water_ratio\", \"collapse_flag\", \"smooth_iou\"])\n\n    bv, en = 0.0, 0\n    sv = 0.0\n    pd_prev, tl = None, None\n    consecutive_flags = 0\n\n    for epoch in range(EPOCHS):\n        opt_drop_prob = opt_drop(epoch, variant)\n        if tl is None or abs(opt_drop_prob - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, opt_drop_prob)\n            pd_prev = opt_drop_prob\n\n        diag = EpochDiagnostics()\n        tm = train_epoch(model, tl, crit, opt, scaler, device, diag)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n        diag_summary = diag.summary()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        collapsed = check_collapse(vm, diag_summary, epoch, variant)\n        consecutive_flags = consecutive_flags + 1 if collapsed else 0\n\n        log.info(\n            f\"  [{variant}] Ep{epoch+1:>3} TL={tm['loss']:.4f} VF1={vm['f1']:.4f} \"\n            f\"VIoU={vi:.4f} Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={opt_drop_prob:.2f} \"\n            f\"gradN={diag_summary['grad_norm_mean']:.3f} sat={diag_summary['saturation_mean']:.3f}\"\n        )\n        dw.writerow([epoch+1, diag_summary[\"grad_norm_mean\"], diag_summary[\"saturation_mean\"],\n                     vm[\"recall\"], vi, vm[\"pred_water_ratio\"], collapsed, sv])\n        diagf.flush()\n\n        if sv > bv:\n            bv, en = sv, 0\n            state = model.module.state_dict() if isinstance(model, nn.DataParallel) else model.state_dict()\n            torch.save(state, best_path)\n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if epoch + 1 >= DIAG_CHECK_EPOCH and AUTO_STOP_ON_COLLAPSE and consecutive_flags >= 3:\n            log.error(\n                f\"  [{variant}] STOPPING EARLY at epoch {epoch+1}: collapse signs persisted \"\n                f\"{consecutive_flags} consecutive epochs. Diagnostics: {diag_path}\"\n            )\n            break\n\n        if en >= patience:\n            log.info(f\"  [{variant}] Early stop at epoch {epoch+1}\")\n            break\n\n    diagf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache(); gc.collect()\n    save_hyperparams(ABLATION_VARIANT)\n    train_df, val_df = make_official_splits(MANIFEST_PATH)\n    train_single(train_df, val_df, ABLATION_VARIANT)\n\n\nmain()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T14:05:00.882363Z","iopub.execute_input":"2026-09-03T14:05:00.882796Z","iopub.status.idle":"2026-09-03T15:02:10.133438Z","shell.execute_reply.started":"2026-09-03T14:05:00.882758Z","shell.execute_reply":"2026-09-03T15:02:10.132408Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Symetric_loss","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# Standalone single-run training script — PATCHED for the remaining\n# ablation variants (single_stream_sar, no_sar_ratio, no_optical,\n# no_cbam, symmetric_loss).\n#\n# Added Multi-GPU support (nn.DataParallel) to fix CUDA OOM on Kaggle T4s.\n\nimport os\n# Set this before importing torch to mitigate Kaggle memory fragmentation\nos.environ[\"PYTORCH_ALLOC_CONF\"] = \"expandable_segments:True\"\n\nimport gc, csv, random, logging, json\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\n# ─────────────────────────────────────────────────────────────────────\n# CONFIG — change this line for each run\n# ─────────────────────────────────────────────────────────────────────\nABLATION_VARIANT = \"symmetric_loss\"  # <-- CHANGE THIS EACH RUN\n\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 4\nACCUM_STEPS      = 8\nNUM_WORKERS      = 4\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nVAL_SMOOTHING    = 0.3\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.3\nFT_BETA          = 0.7\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30,0.35,0.40,0.45,0.50,0.55,0.60,0.65,0.70]\nIGNORE_INDEX     = -1\n\nLR               = 2e-4\nPATIENCE         = 25\n\nSAR_ONLY_LR       = 5e-5\nSAR_ONLY_PATIENCE = 50\nSAR_ONLY_FT_GAMMA = 1.0\nSAR_ONLY_FT_ALPHA = 0.5\nSAR_ONLY_FT_BETA  = 0.5\n\n# FIX #1: no_optical removed — it's full-capacity now, not SAR-only.\nSAR_ONLY_VARIANTS = {\"single_stream_sar\", \"no_sar_ratio\"}\n\n# ── Diagnostics (merged from 04) ────────────────────────────────────\nDIAG_CHECK_EPOCH = 10\nCOLLAPSE_RECALL_FLOOR = 0.02\nCOLLAPSE_PRED_WATER_CEIL = 0.90\nSATURATION_WARN = 0.98\nAUTO_STOP_ON_COLLAPSE = True   # set False if you want to let a run continue anyway\n\n# ─────────────────────────────────────────────────────────────────────\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n              logging.StreamHandler()],\n)\nlog = logging.getLogger(\"manzar_v9\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef save_hyperparams(variant):\n    is_sar = variant in SAR_ONLY_VARIANTS\n    params = {\n        \"version\": \"MANZAR v9 (calibration-fixed data, dispatch-fixed ablation)\",\n        \"ABLATION_VARIANT\": variant,\n        \"LR\": SAR_ONLY_LR if is_sar else LR,\n        \"PATIENCE\": SAR_ONLY_PATIENCE if is_sar else PATIENCE,\n        \"FT_ALPHA\": SAR_ONLY_FT_ALPHA if is_sar else FT_ALPHA,\n        \"FT_BETA\": SAR_ONLY_FT_BETA if is_sar else FT_BETA,\n        \"FT_GAMMA\": round(SAR_ONLY_FT_GAMMA if is_sar else FT_GAMMA, 4),\n        \"SAR_ONLY_VARIANT\": is_sar,\n        \"SEED\": SEED,\n    }\n    path = os.path.join(LOG_DIR, f\"hyperparams_{variant}.json\")\n    with open(path, \"w\") as f:\n        json.dump(params, f, indent=2)\n    log.info(\"=\" * 62)\n    for k, v in params.items():\n        log.info(f\"  {k:<22} : {v}\")\n    log.info(\"=\" * 62)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA SPLIT\n# ─────────────────────────────────────────────────────────────────────\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    df = pd.read_csv(manifest_path)\n    if \"biome\" not in df.columns:\n        df[\"biome\"] = df[\"patch_id\"].apply(lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    log.info(f\"Train: {len(train_df)}  Val: {len(val_df)}\")\n    if len(train_df) == 0:\n        raise RuntimeError(\"0 training patches matched — check patch_id format\")\n    return train_df, val_df\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATASET\n# ─────────────────────────────────────────────────────────────────────\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, features_dir, masks_dir\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s, num_workers=num_workers,\n                       pin_memory=True, drop_last=True)\n\n\ndef build_val_loader(df, num_workers):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=num_workers, pin_memory=True)\n\n\ndef opt_drop(epoch, variant):\n    # no_optical's optical input is already always zero; dropping it is\n    # a no-op, so it takes the no-curriculum path like no_opt_dropout.\n    if variant in SAR_ONLY_VARIANTS or variant in (\"no_opt_dropout\", \"no_optical\"):\n        return 0.0\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# ARCHITECTURE\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"FIX #2: added zero_optical. When True, this is the corrected\n    no_optical ablation — same architecture/param count as `full`, but\n    the optical branch sees zeros. Distinct from SingleStreamSAR, which\n    never has an optical encoder at all.\"\"\"\n\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        if self.zero_optical:\n            opt = torch.zeros_like(opt)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant):\n    if variant == \"full\":\n        return DualStreamUNetPP(use_cbam=True)\n    if variant == \"no_cbam\":\n        return DualStreamUNetPP(use_cbam=False)\n    if variant == \"no_optical\":\n        # FIX #2: was SingleStreamSAR() — now full-capacity, optical zeroed.\n        return DualStreamUNetPP(use_cbam=True, zero_optical=True)\n    if variant == \"single_stream_sar\":\n        return SingleStreamSAR()\n    if variant == \"no_sar_ratio\":\n        return SingleStreamSAR2ch()\n    if variant in (\"no_opt_dropout\", \"symmetric_loss\"):\n        return DualStreamUNetPP(use_cbam=True)\n    raise ValueError(f\"Unknown variant: {variant!r}\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# LOSS\n# ─────────────────────────────────────────────────────────────────────\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\ndef get_criterion(variant):\n    if variant == \"symmetric_loss\":\n        return HybridLoss(ALPHA_BCE, 0.5, 0.5, FT_GAMMA)\n    if variant in SAR_ONLY_VARIANTS:\n        return HybridLoss(ALPHA_BCE, SAR_ONLY_FT_ALPHA, SAR_ONLY_FT_BETA, SAR_ONLY_FT_GAMMA)\n    # no_optical falls through to here now — full's loss, matching its\n    # full capacity.\n    return HybridLoss(ALPHA_BCE, FT_ALPHA, FT_BETA, FT_GAMMA)\n\n\n# ─────────────────────────────────────────────────────────────────────\n# METRICS\n# ─────────────────────────────────────────────────────────────────────\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re,\n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e),\n                \"pred_water_ratio\": (tp + fp) / (tp + tn + fp + fn + e)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DIAGNOSTICS (merged from 04)\n# ─────────────────────────────────────────────────────────────────────\nclass EpochDiagnostics:\n    def __init__(self):\n        self.grad_norms, self.sat_fracs = [], []\n\n    def log_step(self, model, logits):\n        total_sq = 0.0\n        for p in model.parameters():\n            if p.grad is not None:\n                total_sq += p.grad.detach().data.norm(2).item() ** 2\n        self.grad_norms.append(total_sq ** 0.5)\n        with torch.no_grad():\n            probs = torch.sigmoid(logits.detach())\n            self.sat_fracs.append(((probs < 0.01) | (probs > 0.99)).float().mean().item())\n\n    def summary(self):\n        return {\n            \"grad_norm_mean\": float(np.mean(self.grad_norms)) if self.grad_norms else 0.0,\n            \"saturation_mean\": float(np.mean(self.sat_fracs)) if self.sat_fracs else 0.0,\n        }\n\n\ndef check_collapse(val_metrics, diag_summary, epoch, variant):\n    flags = []\n    if val_metrics[\"recall\"] < COLLAPSE_RECALL_FLOOR:\n        flags.append(f\"recall={val_metrics['recall']:.4f} (predicts almost nothing)\")\n    if val_metrics[\"pred_water_ratio\"] > COLLAPSE_PRED_WATER_CEIL:\n        flags.append(f\"pred_water_ratio={val_metrics['pred_water_ratio']:.4f} (predicts almost everything)\")\n    if diag_summary[\"saturation_mean\"] > SATURATION_WARN:\n        flags.append(f\"saturation={diag_summary['saturation_mean']:.4f} (gradients likely dead)\")\n    if flags:\n        log.warning(f\"  [{variant}] ep{epoch+1} COLLAPSE SIGNS: {'; '.join(flags)}\")\n        return True\n    return False\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAIN / VAL LOOPS\n# ─────────────────────────────────────────────────────────────────────\ndef train_epoch(model, loader, crit, opt, scaler, device, diag):\n    model.train()\n    rl = 0.0\n    m = RunningMetrics()\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / ACCUM_STEPS\n        scaler.scale(loss).backward()\n        if (step + 1) % ACCUM_STEPS == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            diag.log_step(model, logits)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * ACCUM_STEPS\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        m = RunningMetrics(); m.update(ap, at, t)\n        cm = m.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        m = RunningMetrics(); m.update(ap, at, 0.5); bm, bt = m.compute(), 0.5\n    bm[\"loss\"] = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\n# ─────────────────────────────────────────────────────────────────────\n# TRAINING RUN\n# ─────────────────────────────────────────────────────────────────────\ndef train_single(train_df, val_df, variant):\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    is_sar = variant in SAR_ONLY_VARIANTS\n    lr = SAR_ONLY_LR if is_sar else LR\n    patience = SAR_ONLY_PATIENCE if is_sar else PATIENCE\n\n    log.info(f\"\\n{'='*62}\\n  RUN  variant={variant}  is_sar_only_hparams={is_sar}\\n  LR={lr}  Patience={patience}\\n{'='*62}\")\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=variant)\n    \n    # Generate model architecture\n    model = build_model(variant)\n    \n    # Distribute model across GPUs if multiple exist\n    if torch.cuda.device_count() > 1:\n        log.info(f\"  Distributing physical batch across {torch.cuda.device_count()} GPUs\")\n        model = nn.DataParallel(model)\n        \n    model = model.to(device)\n    log.info(f\"  Params: {sum(p.numel() for p in model.parameters()):,}\")\n\n    opt = optim.AdamW(model.parameters(), lr=lr, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = get_criterion(variant)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    diag_path = os.path.join(LOG_DIR, f\"diagnostics_{variant}.csv\")\n    diagf = open(diag_path, \"w\", newline=\"\")\n    dw = csv.writer(diagf)\n    dw.writerow([\"epoch\", \"grad_norm_mean\", \"saturation_mean\", \"val_recall\",\n                 \"val_iou\", \"val_pred_water_ratio\", \"collapse_flag\", \"smooth_iou\"])\n\n    bv, en = 0.0, 0\n    sv = 0.0\n    pd_prev, tl = None, None\n    consecutive_flags = 0\n\n    for epoch in range(EPOCHS):\n        drop = opt_drop(epoch, variant)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        diag = EpochDiagnostics()\n        tm = train_epoch(model, tl, crit, opt, scaler, device, diag)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n        diag_summary = diag.summary()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        collapsed = check_collapse(vm, diag_summary, epoch, variant)\n        consecutive_flags = consecutive_flags + 1 if collapsed else 0\n\n        log.info(\n            f\"  [{variant}] Ep{epoch+1:>3} TL={tm['loss']:.4f} VF1={vm['f1']:.4f} \"\n            f\"VIoU={vi:.4f} Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f} \"\n            f\"gradN={diag_summary['grad_norm_mean']:.3f} sat={diag_summary['saturation_mean']:.3f}\"\n        )\n        dw.writerow([epoch+1, diag_summary[\"grad_norm_mean\"], diag_summary[\"saturation_mean\"],\n                     vm[\"recall\"], vi, vm[\"pred_water_ratio\"], collapsed, sv])\n        diagf.flush()\n\n        if sv > bv:\n            bv, en = sv, 0\n            \n            # Strip 'module.' prefix before saving if wrapped in DataParallel\n            state_dict = model.module.state_dict() if isinstance(model, nn.DataParallel) else model.state_dict()\n            torch.save(state_dict, best_path)\n            \n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if epoch + 1 >= DIAG_CHECK_EPOCH and AUTO_STOP_ON_COLLAPSE and consecutive_flags >= 3:\n            log.error(\n                f\"  [{variant}] STOPPING EARLY at epoch {epoch+1}: collapse signs persisted \"\n                f\"{consecutive_flags} consecutive epochs. This variant needs investigation, \"\n                f\"not more training time. Diagnostics: {diag_path}\"\n            )\n            break\n\n        if en >= patience:\n            log.info(f\"  [{variant}] Early stop at epoch {epoch+1}\")\n            break\n\n    diagf.close()\n    log.info(f\"  DONE  variant={variant}  best_sm_iou={bv:.4f}\")\n    return bv\n\n\ndef main():\n    set_seed(SEED)\n    os.makedirs(LOG_DIR, exist_ok=True)\n    torch.cuda.empty_cache(); gc.collect()\n    save_hyperparams(ABLATION_VARIANT)\n    train_df, val_df = make_official_splits(MANIFEST_PATH)\n    train_single(train_df, val_df, ABLATION_VARIANT)\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T17:27:32.086674Z","iopub.execute_input":"2026-09-03T17:27:32.087166Z","iopub.status.idle":"2026-09-03T18:44:32.728634Z","shell.execute_reply.started":"2026-09-03T17:27:32.087131Z","shell.execute_reply":"2026-09-03T18:44:32.727564Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Statistical significance testing","metadata":{}},{"cell_type":"code","source":"#!/usr/bin/env python3\n# SINGLE CELL — everything needed is defined here, no imports from any\n# other numbered script. Run this only after symmetric_loss has been\n# retrained to completion (11_retrain_symmetric_loss.py) — running it\n# against the old 7-epoch symmetric_loss checkpoint will just produce a\n# different kind of wrong number, not a fixed one.\n#\n# Covers: fixed-threshold (0.50) global pixel IoU on official test +\n# Bolivia for all 6 variants; patch-level bootstrap significance for the\n# ablation table comparisons that matter; cloud-robustness re-check for\n# the 4 variants that actually have a real optical stream to drop\n# (full, no_opt_dropout, no_cbam, symmetric_loss — not the SAR-only\n# variants, which have no optical to begin with).\n\nimport os\nimport json\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader\n\nMANIFEST_PATH = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR = \"./data/ml_dataset/features\"\nMASKS_DIR = \"./data/ml_dataset/masks\"\n\nOFFICIAL_TEST_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_test_data.csv\"\nOFFICIAL_BOLIVIA_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_bolivia_data.csv\"\n\nCHECKPOINTS = {\n    \"full\": \"./ablation_best_flood_model_full.pth\",\n    \"no_opt_dropout\": \"./ablation_best_flood_model_no_opt_dropout.pth\",\n    \"no_cbam\": \"./ablation_best_flood_model_no_cbam.pth\",\n    \"symmetric_loss\": \"./ablation_best_flood_model_symmetric_loss.pth\",\n    \"no_optical\": \"./ablation_best_flood_model_no_optical.pth\",\n    \"single_stream_sar\": \"./ablation_best_flood_model_single_stream_sar.pth\",\n    \"no_sar_ratio\": \"./ablation_best_flood_model_no_sar_ratio.pth\",\n}\n\n# Architecture family per variant — determines which model class to build.\nVARIANT_ARCH = {\n    \"full\": (\"dual\", dict(use_cbam=True, zero_optical=False)),\n    \"no_opt_dropout\": (\"dual\", dict(use_cbam=True, zero_optical=False)),\n    \"no_cbam\": (\"dual\", dict(use_cbam=False, zero_optical=False)),\n    \"symmetric_loss\": (\"dual\", dict(use_cbam=True, zero_optical=False)),\n    \"no_optical\": (\"dual\", dict(use_cbam=True, zero_optical=True)),\n    \"single_stream_sar\": (\"sar3\", {}),\n    \"no_sar_ratio\": (\"sar2\", {}),\n}\n\n# Variants with a real optical stream worth cloud-testing.\nCLOUD_TEST_VARIANTS = {\"full\", \"no_opt_dropout\", \"no_cbam\", \"symmetric_loss\"}\n\n# Ablation-table comparisons worth a significance test.\nCOMPARISONS = [\n    (\"full\", \"no_opt_dropout\", \"official_test\"),\n    (\"full\", \"no_opt_dropout\", \"bolivia\"),\n    (\"no_cbam\", \"full\", \"official_test\"),\n    (\"symmetric_loss\", \"full\", \"official_test\"),\n    (\"no_optical\", \"single_stream_sar\", \"official_test\"),\n]\n\nFIXED_THRESHOLD = 0.50\nIGNORE_INDEX = -1\nN_BOOT = 10000\nRNG_SEED = 42\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\n\n# ─────────────────────────────────────────────────────────────────────\n# MODEL CLASSES (all self-contained)\n# ─────────────────────────────────────────────────────────────────────\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True, zero_optical=False):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.zero_optical = zero_optical\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        sar_feat = self.sar_encoder(sar)\n        if self.zero_optical:\n            opt_feat = torch.zeros_like(sar_feat)\n        else:\n            opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n            opt_feat = self.opt_encoder(opt)\n        f = torch.cat([sar_feat, opt_feat], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass SingleStreamSAR(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=1)\n\n    def forward(self, x):\n        return self.enc(torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1))\n\n\nclass SingleStreamSAR2ch(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.enc = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None, in_channels=2, classes=1)\n\n    def forward(self, x):\n        return self.enc(x[:, 0:2, :, :])\n\n\ndef build_model(variant):\n    arch, kwargs = VARIANT_ARCH[variant]\n    if arch == \"dual\":\n        return DualStreamUNetPP(**kwargs)\n    if arch == \"sar3\":\n        return SingleStreamSAR()\n    if arch == \"sar2\":\n        return SingleStreamSAR2ch()\n    raise ValueError(variant)\n\n\ndef load_model(variant, weights_path):\n    model = build_model(variant)\n    state = torch.load(weights_path, map_location=DEVICE)\n    state = {k.replace(\"module.\", \"\"): v for k, v in state.items()}\n    missing, unexpected = model.load_state_dict(state, strict=True)  # STRICT — fail loud on mismatch\n    return model.to(DEVICE).eval()\n\n\n# ─────────────────────────────────────────────────────────────────────\n# DATA\n# ─────────────────────────────────────────────────────────────────────\nclass EvalDataset(Dataset):\n    def __init__(self, df, fd, md, cloud_sim=False):\n        self.df, self.fd, self.md = df.reset_index(drop=True), fd, md\n        self.cloud_sim = cloud_sim\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.cloud_sim:\n            x[2:, :, :] = 0.0\n        return x, y, pid\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef get_split_df(manifest_path, csv_path):\n    df = pd.read_csv(manifest_path)\n    ids = _parse_official_ids(csv_path)\n    return df[df[\"patch_id\"].isin(ids)].reset_index(drop=True)\n\n\n@torch.no_grad()\ndef get_per_patch_confusion(model, df, cloud_sim=False, threshold=FIXED_THRESHOLD, batch_size=8):\n    ds = EvalDataset(df, FEATURES_DIR, MASKS_DIR, cloud_sim=cloud_sim)\n    loader = DataLoader(ds, batch_size=batch_size, shuffle=False, num_workers=2, pin_memory=True)\n    out = {}\n    for x, y, pids in loader:\n        x = x.to(DEVICE, non_blocking=True)\n        with torch.amp.autocast(device_type=\"cuda\" if DEVICE.type == \"cuda\" else \"cpu\"):\n            logits = model(x)\n        probs = torch.sigmoid(logits).squeeze(1).float().cpu()\n        for i, pid in enumerate(pids):\n            p = probs[i].reshape(-1)\n            t = y[i].reshape(-1)\n            valid = t != IGNORE_INDEX\n            pb = (p[valid] > threshold)\n            tb = t[valid].bool()\n            out[pid] = ((pb & tb).sum().item(), (pb & ~tb).sum().item(),\n                        (~pb & tb).sum().item(), (~pb & ~tb).sum().item())\n    return out\n\n\ndef _global_from_counts(counts, ids):\n    tp = fp = fn = tn = 0\n    for pid in ids:\n        c = counts[pid]\n        tp += c[0]; fp += c[1]; fn += c[2]; tn += c[3]\n    eps = 1e-8\n    return {\"iou\": tp / (tp + fp + fn + eps), \"precision\": tp / (tp + fp + eps),\n            \"recall\": tp / (tp + fn + eps), \"tp\": tp, \"fp\": fp, \"fn\": fn, \"tn\": tn}\n\n\ndef _global_iou_only(counts, ids):\n    tp = fp = fn = 0\n    for pid in ids:\n        c = counts[pid]\n        tp += c[0]; fp += c[1]; fn += c[2]\n    return tp / (tp + fp + fn + 1e-8)\n\n\ndef paired_bootstrap(counts_a, counts_b, n_boot=N_BOOT, seed=RNG_SEED):\n    ids = sorted(set(counts_a) & set(counts_b))\n    rng = np.random.default_rng(seed)\n    point_a = _global_iou_only(counts_a, ids)\n    point_b = _global_iou_only(counts_b, ids)\n    diff = point_a - point_b\n    diffs = np.empty(n_boot)\n    for b in range(n_boot):\n        sample = rng.choice(ids, size=len(ids), replace=True)\n        diffs[b] = _global_iou_only(counts_a, sample) - _global_iou_only(counts_b, sample)\n    ci_lo, ci_hi = np.percentile(diffs, [2.5, 97.5])\n    p = min(2 * min((diffs <= 0).mean(), (diffs >= 0).mean()), 1.0)\n    return {\"n_patches\": len(ids), \"iou_a\": round(point_a, 4), \"iou_b\": round(point_b, 4),\n            \"diff\": round(diff, 4), \"ci95_lo\": round(ci_lo, 4), \"ci95_hi\": round(ci_hi, 4),\n            \"p_value\": round(p, 4), \"significant\": bool(p < 0.05)}\n\n\n# ─────────────────────────────────────────────────────────────────────\n# MAIN\n# ─────────────────────────────────────────────────────────────────────\ndef main():\n    print(\"=\" * 70)\n    print(\"CHECKPOINT VALIDATION\")\n    print(\"=\" * 70)\n    available = {}\n    for variant, path in CHECKPOINTS.items():\n        exists = os.path.exists(path)\n        print(f\"  {variant:<20} {'EXISTS' if exists else 'MISSING'}  {path}\")\n        if exists:\n            available[variant] = path\n    if not available:\n        print(\"No checkpoints found — check paths before continuing.\")\n        return\n\n    test_df = get_split_df(MANIFEST_PATH, OFFICIAL_TEST_CSV)\n    bolivia_df = get_split_df(MANIFEST_PATH, OFFICIAL_BOLIVIA_CSV)\n    print(f\"\\nOfficial test: {len(test_df)} patches | Bolivia: {len(bolivia_df)} patches\")\n    splits = {\"official_test\": test_df, \"bolivia\": bolivia_df}\n\n    normal_counts, cloud_counts = {}, {}\n    headline_rows = []\n\n    print(\"\\n\" + \"=\" * 70)\n    print(\"SCORING (fixed threshold 0.50, global pixel IoU)\")\n    print(\"=\" * 70)\n    for variant, path in available.items():\n        print(f\"\\n--- {variant} ---\")\n        try:\n            model = load_model(variant, path)\n        except Exception as e:\n            print(f\"  [ERROR] strict load failed — architecture/checkpoint mismatch: {e}\")\n            print(f\"  Skipping {variant}. Fix VARIANT_ARCH or the checkpoint before retrying.\")\n            continue\n\n        for split_name, df in splits.items():\n            normal_counts[(variant, split_name)] = get_per_patch_confusion(model, df, cloud_sim=False)\n            r = _global_from_counts(normal_counts[(variant, split_name)],\n                                     list(normal_counts[(variant, split_name)].keys()))\n            print(f\"  [{split_name}] IoU={r['iou']:.4f}  P={r['precision']:.4f}  R={r['recall']:.4f}\")\n            headline_rows.append({\"variant\": variant, \"split\": split_name, **r})\n\n            if variant in CLOUD_TEST_VARIANTS:\n                cloud_counts[(variant, split_name)] = get_per_patch_confusion(model, df, cloud_sim=True)\n\n        del model\n        torch.cuda.empty_cache()\n\n    pd.DataFrame(headline_rows).to_csv(\"./final_headline_results.csv\", index=False)\n    print(f\"\\nSaved: final_headline_results.csv\")\n\n    # --- Significance ---\n    print(\"\\n\" + \"=\" * 70)\n    print(f\"BOOTSTRAP SIGNIFICANCE ({N_BOOT} resamples)\")\n    print(\"=\" * 70)\n    sig_results = []\n    for a, b, split in COMPARISONS:\n        if (a, split) not in normal_counts or (b, split) not in normal_counts:\n            print(f\"\\n  [skip] {a} vs {b} on {split} — checkpoint missing\")\n            continue\n        r = paired_bootstrap(normal_counts[(a, split)], normal_counts[(b, split)])\n        r.update({\"variant_a\": a, \"variant_b\": b, \"split\": split})\n        sig_results.append(r)\n        verdict = \"SIGNIFICANT\" if r[\"significant\"] else \"not significant\"\n        print(f\"\\n  {a} vs {b} on {split}\")\n        print(f\"    IoU: {r['iou_a']:.4f} vs {r['iou_b']:.4f}  diff={r['diff']:+.4f}  \"\n              f\"95% CI=[{r['ci95_lo']:+.4f}, {r['ci95_hi']:+.4f}]  p={r['p_value']:.4f}  -> {verdict}\")\n\n    with open(\"./final_significance_results.json\", \"w\") as f:\n        json.dump(sig_results, f, indent=2)\n    print(f\"\\nSaved: final_significance_results.json\")\n\n    # --- Cloud robustness ---\n    print(\"\\n\" + \"=\" * 70)\n    print(\"CLOUD ROBUSTNESS (variants with a real optical stream)\")\n    print(\"=\" * 70)\n    robustness_rows = []\n    for variant in CLOUD_TEST_VARIANTS:\n        if variant not in available:\n            continue\n        for split_name in splits:\n            if (variant, split_name) not in cloud_counts:\n                continue\n            ids = sorted(normal_counts[(variant, split_name)].keys())\n            normal = _global_from_counts(normal_counts[(variant, split_name)], ids)\n            cloud = _global_from_counts(cloud_counts[(variant, split_name)], ids)\n            deg = 100.0 * (normal[\"iou\"] - cloud[\"iou\"]) / max(normal[\"iou\"], 1e-8)\n            mode = (\"floods_everything\" if cloud[\"recall\"] > 0.9 and cloud[\"precision\"] < 0.3\n                    else \"detects_nothing\" if cloud[\"recall\"] < 0.1\n                    else \"partial_degradation\")\n            row = {\"variant\": variant, \"split\": split_name, \"normal_iou\": round(normal[\"iou\"], 4),\n                   \"cloud_iou\": round(cloud[\"iou\"], 4), \"degradation_pct\": round(deg, 1), \"mode\": mode}\n            robustness_rows.append(row)\n            print(f\"  [{variant}/{split_name}] normal={row['normal_iou']:.4f} cloud={row['cloud_iou']:.4f} \"\n                  f\"({row['degradation_pct']:.1f}% drop, {mode})\")\n\n    with open(\"./final_cloud_robustness.json\", \"w\") as f:\n        json.dump(robustness_rows, f, indent=2)\n    print(f\"\\nSaved: final_cloud_robustness.json\")\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-04T10:20:01.686608Z","iopub.execute_input":"2026-09-04T10:20:01.68738Z","iopub.status.idle":"2026-09-04T10:22:12.394609Z","shell.execute_reply.started":"2026-09-04T10:20:01.687326Z","shell.execute_reply":"2026-09-04T10:22:12.393786Z"}},"outputs":[{"name":"stdout","text":"======================================================================\nCHECKPOINT VALIDATION\n======================================================================\n  full                 EXISTS  ./ablation_best_flood_model_full.pth\n  no_opt_dropout       EXISTS  ./ablation_best_flood_model_no_opt_dropout.pth\n  no_cbam              EXISTS  ./ablation_best_flood_model_no_cbam.pth\n  symmetric_loss       EXISTS  ./ablation_best_flood_model_symmetric_loss.pth\n  no_optical           EXISTS  ./ablation_best_flood_model_no_optical.pth\n  single_stream_sar    EXISTS  ./ablation_best_flood_model_single_stream_sar.pth\n  no_sar_ratio         EXISTS  ./ablation_best_flood_model_no_sar_ratio.pth\n\nOfficial test: 90 patches | Bolivia: 15 patches\n\n======================================================================\nSCORING (fixed threshold 0.50, global pixel IoU)\n======================================================================\n\n--- full ---\n  [official_test] IoU=0.8450  P=0.8948  R=0.9382\n  [bolivia] IoU=0.8213  P=0.8837  R=0.9208\n\n--- no_opt_dropout ---\n  [official_test] IoU=0.8136  P=0.8475  R=0.9531\n  [bolivia] IoU=0.7901  P=0.8273  R=0.9463\n\n--- no_cbam ---\n  [official_test] IoU=0.8306  P=0.8642  R=0.9553\n  [bolivia] IoU=0.7965  P=0.8347  R=0.9457\n\n--- symmetric_loss ---\n  [official_test] IoU=0.8183  P=0.8520  R=0.9538\n  [bolivia] IoU=0.7879  P=0.8220  R=0.9499\n\n--- no_optical ---\n  [official_test] IoU=0.6698  P=0.7859  R=0.8193\n  [bolivia] IoU=0.6547  P=0.7915  R=0.7911\n\n--- single_stream_sar ---\n  [official_test] IoU=0.6828  P=0.7971  R=0.8264\n  [bolivia] IoU=0.6118  P=0.7118  R=0.8132\n\n--- no_sar_ratio ---\n  [official_test] IoU=0.6882  P=0.8184  R=0.8122\n  [bolivia] IoU=0.6423  P=0.7547  R=0.8117\n\nSaved: final_headline_results.csv\n\n======================================================================\nBOOTSTRAP SIGNIFICANCE (10000 resamples)\n======================================================================\n\n  full vs no_opt_dropout on official_test\n    IoU: 0.8450 vs 0.8136  diff=+0.0314  95% CI=[+0.0180, +0.0463]  p=0.0000  -> SIGNIFICANT\n\n  full vs no_opt_dropout on bolivia\n    IoU: 0.8213 vs 0.7901  diff=+0.0312  95% CI=[+0.0084, +0.0599]  p=0.0090  -> SIGNIFICANT\n\n  no_cbam vs full on official_test\n    IoU: 0.8306 vs 0.8450  diff=-0.0144  95% CI=[-0.0279, -0.0022]  p=0.0220  -> SIGNIFICANT\n\n  symmetric_loss vs full on official_test\n    IoU: 0.8183 vs 0.8450  diff=-0.0267  95% CI=[-0.0501, -0.0080]  p=0.0038  -> SIGNIFICANT\n\n  no_optical vs single_stream_sar on official_test\n    IoU: 0.6698 vs 0.6828  diff=-0.0130  95% CI=[-0.0363, +0.0088]  p=0.2518  -> not significant\n\nSaved: final_significance_results.json\n\n======================================================================\nCLOUD ROBUSTNESS (variants with a real optical stream)\n======================================================================\n  [symmetric_loss/official_test] normal=0.8183 cloud=0.6476 (20.9% drop, partial_degradation)\n  [symmetric_loss/bolivia] normal=0.7879 cloud=0.7037 (10.7% drop, partial_degradation)\n  [full/official_test] normal=0.8450 cloud=0.3976 (53.0% drop, partial_degradation)\n  [full/bolivia] normal=0.8213 cloud=0.5930 (27.8% drop, partial_degradation)\n  [no_opt_dropout/official_test] normal=0.8136 cloud=0.1251 (84.6% drop, floods_everything)\n  [no_opt_dropout/bolivia] normal=0.7901 cloud=0.1586 (79.9% drop, floods_everything)\n  [no_cbam/official_test] normal=0.8306 cloud=0.1302 (84.3% drop, floods_everything)\n  [no_cbam/bolivia] normal=0.7965 cloud=0.1701 (78.6% drop, floods_everything)\n\nSaved: final_cloud_robustness.json\n","output_type":"stream"}],"execution_count":2},{"cell_type":"code","source":"#!/usr/bin/env python3\n# SINGLE CELL — Multi-GPU version for Kaggle\n# Retrains symmetric_loss from scratch with multi-GPU support\n\nimport os\n# Set this to mitigate Kaggle memory fragmentation\nos.environ[\"PYTORCH_ALLOC_CONF\"] = \"expandable_segments:True\"\n\nimport gc, csv, random, logging, json\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport torchvision.transforms.functional as TF\nimport segmentation_models_pytorch as smp\nfrom torch.utils.data import Dataset, DataLoader, WeightedRandomSampler\nfrom tqdm import tqdm\n\nABLATION_VARIANT = \"symmetric_loss\"\n\nMANIFEST_PATH      = \"./data/ml_dataset/patch_manifest.csv\"\nFEATURES_DIR       = \"./data/ml_dataset/features\"\nMASKS_DIR          = \"./data/ml_dataset/masks\"\nLOG_DIR            = \"./logs\"\nBEST_WEIGHTS_ROOT  = \"./ablation_best_flood_model_{variant}.pth\"\n\nOFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\nOFFICIAL_VAL_CSV   = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n\nSEED             = 42\nEPOCHS           = 250\nPHYSICAL_BATCH   = 7          # Reduced for multi-GPU (effective batch = physical_batch * num_gpus)\nACCUM_STEPS      = 5          # Increased accumulation to maintain effective batch size\nNUM_WORKERS      = 4          # Can increase with multi-GPU\nWEIGHT_DECAY     = 1e-3\nETA_MIN          = 1e-6\nVAL_SMOOTHING    = 0.3\nPATIENCE         = 25\nLR               = 2e-4\n\nALPHA_BCE        = 0.3\nFT_ALPHA         = 0.5        # symmetric_loss: alpha=beta=0.5\nFT_BETA          = 0.5\nFT_GAMMA         = 4/3\n\nOVERSAMPLE_THRESH = 0.05\nOVERSAMPLE_WEIGHT = 2.0\n\nOPT_DROP_START   = 0.25\nOPT_DROP_END     = 0.05\nOPT_DROP_RAMP    = 60\n\nTHRESH_SWEEP     = [0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70]\nIGNORE_INDEX     = -1\n\nos.makedirs(LOG_DIR, exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\"%(asctime)s | %(levelname)s | %(message)s\",\n    handlers=[logging.FileHandler(os.path.join(LOG_DIR, \"train.log\")),\n              logging.StreamHandler()],\n)\nlog = logging.getLogger(\"manzar_v9_symloss_multi_gpu\")\n\n\ndef set_seed(s):\n    random.seed(s); np.random.seed(s)\n    torch.manual_seed(s); torch.cuda.manual_seed_all(s)\n\n\ndef _parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef make_official_splits(manifest_path):\n    df = pd.read_csv(manifest_path)\n    train_ids = _parse_official_ids(OFFICIAL_TRAIN_CSV)\n    val_ids = _parse_official_ids(OFFICIAL_VAL_CSV)\n    train_df = df[df[\"patch_id\"].isin(train_ids)].reset_index(drop=True)\n    val_df = df[df[\"patch_id\"].isin(val_ids)].reset_index(drop=True)\n    log.info(f\"Train: {len(train_df)}  Val: {len(val_df)}\")\n    return train_df, val_df\n\n\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir, is_train=True, opt_drop_prob=0.0):\n        self.df, self.fd, self.md = df, features_dir, masks_dir\n        self.is_train, self.odp = is_train, opt_drop_prob\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.is_train:\n            if random.random() > 0.5:\n                x = TF.hflip(x); y = TF.hflip(y.unsqueeze(0)).squeeze(0)\n            if random.random() > 0.5:\n                x = TF.vflip(x); y = TF.vflip(y.unsqueeze(0)).squeeze(0)\n            k = random.choice([0, 1, 2, 3])\n            if k > 0:\n                x = torch.rot90(x, k, [1, 2]); y = torch.rot90(y, k, [0, 1])\n            if random.random() < self.odp:\n                x[2:, :, :] = 0.0\n            if random.random() < 0.30:\n                x[:2] = (x[:2] + torch.randn_like(x[:2]) * 0.02).clamp(0, 1)\n        return x, y\n\n\ndef build_train_loader(df, batch_size, num_workers, opt_drop_prob):\n    w = np.where(df[\"water_ratio\"] > OVERSAMPLE_THRESH, OVERSAMPLE_WEIGHT, 1.0)\n    s = WeightedRandomSampler(w, num_samples=len(w), replacement=True)\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=True, opt_drop_prob=opt_drop_prob)\n    return DataLoader(d, batch_size=batch_size, sampler=s, num_workers=num_workers,\n                       pin_memory=True, drop_last=True, persistent_workers=False)\n\n\ndef build_val_loader(df, num_workers):\n    d = FloodDataset(df, FEATURES_DIR, MASKS_DIR, is_train=False)\n    return DataLoader(d, batch_size=16, shuffle=False, num_workers=num_workers,\n                       pin_memory=True, persistent_workers=False)\n\n\ndef opt_drop(epoch):\n    if epoch >= OPT_DROP_RAMP:\n        return OPT_DROP_END\n    return OPT_DROP_START + (epoch / OPT_DROP_RAMP) * (OPT_DROP_END - OPT_DROP_START)\n\n\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False))\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=\"imagenet\", in_channels=7, classes=32)\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1))\n\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\n\nclass FocalTverskyLoss(nn.Module):\n    def __init__(self, alpha, beta, gamma, smooth=1e-6):\n        super().__init__()\n        self.a, self.b, self.g, self.s = alpha, beta, gamma, smooth\n\n    def forward(self, logits, targets):\n        p = torch.sigmoid(logits).view(-1)\n        t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p, t = p[v], t[v].float()\n        TP = (p * t).sum()\n        FP = ((1 - t) * p).sum()\n        FN = (t * (1 - p)).sum()\n        T = (TP + self.s) / (TP + self.a * FP + self.b * FN + self.s)\n        return (1 - T) ** self.g\n\n\nclass HybridLoss(nn.Module):\n    def __init__(self, alpha_bce, ft_alpha, ft_beta, ft_gamma):\n        super().__init__()\n        self.ft = FocalTverskyLoss(ft_alpha, ft_beta, ft_gamma)\n        self.bce = nn.BCEWithLogitsLoss(reduction=\"none\")\n        self.a = alpha_bce\n\n    def forward(self, logits, targets):\n        fl = self.ft(logits, targets)\n        vm = (targets != IGNORE_INDEX).float()\n        bm = self.bce(logits.squeeze(1), targets.float().clamp(0, 1))\n        bl = (bm * vm).sum() / (vm.sum() + 1e-8)\n        return (1 - self.a) * fl + self.a * bl\n\n\nclass RunningMetrics:\n    def __init__(self):\n        self.reset()\n\n    def reset(self):\n        self.TP = self.TN = self.FP = self.FN = 0\n\n    def update(self, probs, targets, threshold=0.5):\n        p = probs.view(-1); t = targets.view(-1)\n        v = t != IGNORE_INDEX\n        p = (p[v] > threshold).long(); t = t[v].long()\n        self.TP += ((p == 1) & (t == 1)).sum().item()\n        self.TN += ((p == 0) & (t == 0)).sum().item()\n        self.FP += ((p == 1) & (t == 0)).sum().item()\n        self.FN += ((p == 0) & (t == 1)).sum().item()\n\n    def compute(self):\n        e = 1e-8\n        tp, tn, fp, fn = self.TP, self.TN, self.FP, self.FN\n        pr = tp / (tp + fp + e)\n        re = tp / (tp + fn + e)\n        return {\"precision\": pr, \"recall\": re,\n                \"f1\": 2 * pr * re / (pr + re + e),\n                \"iou\": tp / (tp + fp + fn + e)}\n\n\ndef train_epoch(model, loader, crit, opt, scaler, device, accum_steps):\n    model.train()\n    rl = 0.0\n    m = RunningMetrics()\n    opt.zero_grad()\n    for step, (x, y) in enumerate(tqdm(loader, desc=\"Train\", leave=False, dynamic_ncols=True)):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            loss = crit(logits, y) / accum_steps\n        scaler.scale(loss).backward()\n        if (step + 1) % accum_steps == 0 or (step + 1) == len(loader):\n            scaler.unscale_(opt)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n            scaler.step(opt)\n            scaler.update()\n            opt.zero_grad()\n        rl += loss.item() * accum_steps\n        with torch.no_grad():\n            m.update(torch.sigmoid(logits.detach()).squeeze(1).cpu(), y.cpu())\n    r = m.compute()\n    r[\"loss\"] = rl / len(loader)\n    return r\n\n\n@torch.no_grad()\ndef val_epoch(model, loader, crit, device):\n    model.eval()\n    rl = 0.0\n    ap, at = [], []\n    for x, y in tqdm(loader, desc=\"Val\", leave=False, dynamic_ncols=True):\n        x = x.to(device, non_blocking=True)\n        y = y.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            rl += crit(logits, y).item()\n        ap.append(torch.sigmoid(logits).squeeze(1).cpu())\n        at.append(y.cpu())\n    ap, at = torch.cat(ap), torch.cat(at)\n    bf, bt, bm = 0.0, 0.5, None\n    for t in THRESH_SWEEP:\n        mm = RunningMetrics()\n        mm.update(ap, at, t)\n        cm = mm.compute()\n        if cm[\"f1\"] > bf:\n            bf, bt, bm = cm[\"f1\"], t, cm\n    if bm is None:\n        mm = RunningMetrics()\n        mm.update(ap, at, 0.5)\n        bm, bt = mm.compute(), 0.5\n    bm[\"loss\"] = rl / len(loader)\n    bm[\"thresh\"] = bt\n    return bm\n\n\ndef main():\n    set_seed(SEED)\n    torch.cuda.empty_cache()\n    gc.collect()\n    \n    # Detect available GPUs\n    num_gpus = torch.cuda.device_count()\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    \n    log.info(f\"=\" * 70)\n    log.info(f\"Multi-GPU Training Configuration\")\n    log.info(f\"  Device: {device}\")\n    log.info(f\"  Available GPUs: {num_gpus}\")\n    if num_gpus > 0:\n        for i in range(num_gpus):\n            log.info(f\"  GPU {i}: {torch.cuda.get_device_name(i)}\")\n            log.info(f\"    Memory: {torch.cuda.get_device_properties(i).total_memory / 1024**3:.1f} GB\")\n    log.info(f\"=\" * 70)\n    \n    # Adjust batch size based on number of GPUs\n    effective_batch = PHYSICAL_BATCH * max(1, num_gpus)\n    log.info(f\"  Physical batch per GPU: {PHYSICAL_BATCH}\")\n    log.info(f\"  Number of GPUs: {max(1, num_gpus)}\")\n    log.info(f\"  Effective batch size: {effective_batch}\")\n    log.info(f\"  Accumulation steps: {ACCUM_STEPS}\")\n    log.info(f\"  Effective total batch: {effective_batch * ACCUM_STEPS}\")\n    log.info(f\"=\" * 70)\n    \n    train_df, val_df = make_official_splits(MANIFEST_PATH)\n\n    best_path = BEST_WEIGHTS_ROOT.format(variant=ABLATION_VARIANT)\n    model = DualStreamUNetPP(use_cbam=True)\n    \n    # Wrap model with DataParallel if multiple GPUs available\n    if num_gpus > 1:\n        log.info(f\"  Using DataParallel with {num_gpus} GPUs\")\n        model = nn.DataParallel(model)\n    \n    model = model.to(device)\n    log.info(f\"  Total parameters: {sum(p.numel() for p in model.parameters()):,}\")\n\n    opt = optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n    sched = optim.lr_scheduler.CosineAnnealingLR(opt, T_max=EPOCHS, eta_min=ETA_MIN)\n    scaler = torch.amp.GradScaler(\"cuda\")\n    crit = HybridLoss(ALPHA_BCE, FT_ALPHA, FT_BETA, FT_GAMMA)\n    val_loader = build_val_loader(val_df, NUM_WORKERS)\n\n    bv, en, sv = 0.0, 0, 0.0\n    pd_prev, tl = None, None\n\n    for epoch in range(EPOCHS):\n        drop = opt_drop(epoch)\n        if tl is None or abs(drop - (pd_prev or 999)) > 0.01:\n            tl = build_train_loader(train_df, PHYSICAL_BATCH, NUM_WORKERS, drop)\n            pd_prev = drop\n\n        tm = train_epoch(model, tl, crit, opt, scaler, device, ACCUM_STEPS)\n        vm = val_epoch(model, val_loader, crit, device)\n        sched.step()\n\n        vi = vm[\"iou\"]\n        sv = vi if sv == 0.0 else (1 - VAL_SMOOTHING) * sv + VAL_SMOOTHING * vi\n        \n        # Get model state dict (handle DataParallel wrapper)\n        state_dict = model.module.state_dict() if isinstance(model, nn.DataParallel) else model.state_dict()\n        \n        log.info(f\"  [symmetric_loss] Ep{epoch+1:>3} TL={tm['loss']:.4f} VF1={vm['f1']:.4f} \"\n                  f\"VIoU={vi:.4f} Sm={sv:.4f} Thr={vm['thresh']:.2f} Drop={drop:.2f}\")\n\n        if sv > bv:\n            bv, en = sv, 0\n            torch.save(state_dict, best_path)\n            log.info(f\"  >> Best Sm={bv:.4f} (raw={vi:.4f}) saved -> {best_path}\")\n        else:\n            en += 1\n\n        if en >= PATIENCE:\n            log.info(f\"  Early stop at epoch {epoch+1}\")\n            break\n\n    log.info(f\"DONE  variant=symmetric_loss  best_sm_iou={bv:.4f}\")\n\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-03T23:53:39.