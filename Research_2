"}],"execution_count":2},{"cell_type":"markdown","source":"## Statistical significance testing","metadata":{}},{"cell_type":"code","source":"# ============================================================================\n# STATISTICAL SIGNIFICANCE TESTING (Fix 3 of 3)\n# Patch-level paired bootstrap for ablation study comparisons\n# ============================================================================\n# This addresses: \"No statistical test has yet been run to establish whether\n# any of the ablation gaps in Table II are distinguishable from noise\"\n#\n# Method: Patch-level paired bootstrap with global pixel IoU aggregation\n# ============================================================================\n\nimport os\nimport json\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image\nfrom typing import Dict, List, Tuple\nfrom importlib import import_module\n\n# ============================================================================\n# Setup and imports from Fix 1 and Fix 2\n# ============================================================================\n\n# Try to import from fix modules, but define fallbacks if not available\ntry:\n    _fix01 = import_module(\"01_fix_ablation_dispatch_and_compute_cost\")\n    build_model = _fix01.build_model\n    print(\"✅ Loaded build_model from fix 01\")\nexcept ImportError:\n    print(\"⚠️  fix 01 module not found, using placeholder build_model\")\n    def build_model(variant, encoder_weights=None):\n        \"\"\"Placeholder build_model - replace with actual model building\"\"\"\n        class PlaceholderModel(nn.Module):\n            def __init__(self):\n                super().__init__()\n                self.conv = nn.Conv2d(3, 1, 3, padding=1)\n            def forward(self, x):\n                return self.conv(x[:, :3, :, :])\n        return PlaceholderModel()\n\ntry:\n    _fix02 = import_module(\"02_unified_cloud_robustness_eval\")\n    DEVICE = _fix02.DEVICE\n    print(\"✅ Loaded DEVICE from fix 02\")\nexcept:\n    DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    print(f\"⚠️  Using default DEVICE: {DEVICE}\")\n\n# Constants\nIGNORE_INDEX = -1\nRNG_SEED = 42\n\nprint(\"=\" * 80)\n\n\n# ============================================================================\n# 1. DATASET AND DATA LOADING (from Fix 2)\n# ============================================================================\n\nclass EvalFloodDataset(Dataset):\n    \"\"\"Dataset for evaluating flood segmentation models.\"\"\"\n    \n    def __init__(self, df, features_dir, masks_dir, cloud_sim=False):\n        self.df = df.reset_index(drop=True)\n        self.fd = features_dir\n        self.md = masks_dir\n        self.cloud_sim = cloud_sim\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        if self.cloud_sim:\n            x[2:, :, :] = 0.0  # zero every optical channel (2..9)\n        return x, y, pid\n\n\ndef _parse_official_ids(csv_path):\n    \"\"\"Parse official split CSV to extract patch IDs.\"\"\"\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\n\ndef get_split_df(manifest_path, csv_path):\n    \"\"\"Get DataFrame for a specific split.\"\"\"\n    df = pd.read_csv(manifest_path)\n    ids = _parse_official_ids(csv_path)\n    split_df = df[df[\"patch_id\"].isin(ids)].reset_index(drop=True)\n    if len(split_df) == 0:\n        raise RuntimeError(f\"0 patches matched from {csv_path}\")\n    return split_df\n\n\n# ============================================================================\n# 2. MODEL LOADING (from Fix 2)\n# ============================================================================\n\ndef load_checkpoint(weights_path, variant, device=DEVICE):\n    \"\"\"Load a model checkpoint with key remapping.\"\"\"\n    if not os.path.exists(weights_path):\n        raise FileNotFoundError(f\"Checkpoint not found: {weights_path}\")\n    \n    model = build_model(variant, encoder_weights=None)\n    raw = torch.load(weights_path, map_location=device)\n    state = raw.get(\"model_state\", raw)\n    state = {k.replace(\"module.\", \"\"): v for k, v in state.items()}\n    \n    # Handle key remapping for sar_encoder -> sar_enc\n    remapped_state = {}\n    for k, v in state.items():\n        if k.startswith(\"sar_encoder.\"):\n            remapped_state[k] = v\n        else:\n            remapped_state[k] = v\n    \n    missing, unexpected = model.load_state_dict(remapped_state, strict=False)\n    if missing:\n        print(f\"  [warn] {variant}: missing keys {missing[:3]} ...\")\n    if unexpected:\n        print(f\"  [warn] {variant}: unexpected keys {unexpected[:3]} ...\")\n    \n    return model.to(device).eval()\n\n\n# ============================================================================\n# 3. PER-PATCH CONFUSION COUNTS (core bootstrap material)\n# ============================================================================\n\n@torch.no_grad()\ndef get_per_patch_confusion(model, df, features_dir, masks_dir,\n                             batch_size=8, num_workers=4, threshold=0.50,\n                             cloud_sim=False):\n    \"\"\"\n    Returns {patch_id: (tp, fp, fn, tn)} — pixel counts per patch.\n    \n    This aggregates confusion counts per patch, which avoids the \n    \"two zero-water patches force per-patch IoU to 0\" artifact\n    when using global aggregation in bootstrap resamples.\n    \"\"\"\n    ds = EvalFloodDataset(df, features_dir, masks_dir, cloud_sim=cloud_sim)\n    loader = DataLoader(ds, batch_size=batch_size, shuffle=False,\n                         num_workers=num_workers, pin_memory=True)\n    out = {}\n    \n    for x, y, pids in loader:\n        x = x.to(DEVICE, non_blocking=True)\n        with torch.amp.autocast(device_type=\"cuda\" if DEVICE.type == \"cuda\" else \"cpu\"):\n            logits = model(x)\n        \n        # Handle different output shapes\n        if logits.dim() == 4 and logits.shape[1] == 1:\n            probs = torch.sigmoid(logits).squeeze(1).float().cpu()\n        elif logits.dim() == 4 and logits.shape[1] > 1:\n            probs = torch.sigmoid(logits[:, 0, :, :]).float().cpu()\n        else:\n            probs = torch.sigmoid(logits).float().cpu()\n        \n        for i, pid in enumerate(pids):\n            p = probs[i].reshape(-1)\n            t = y[i].reshape(-1)\n            valid = t != IGNORE_INDEX\n            pb = (p[valid] > threshold)\n            tb = t[valid].bool()\n            \n            tp = (pb & tb).sum().item()\n            fp = (pb & ~tb).sum().item()\n            fn = (~pb & tb).sum().item()\n            tn = (~pb & ~tb).sum().item()\n            out[pid] = (tp, fp, fn, tn)\n    \n    return out\n\n\ndef _global_iou_from_counts(counts_dict, patch_ids):\n    \"\"\"\n    Compute global pixel IoU aggregated across patches.\n    \n    This is the SAME aggregation as Table I (global pixel IoU),\n    not a mean of per-patch IoUs.\n    \"\"\"\n    tp = fp = fn = 0\n    for pid in patch_ids:\n        c = counts_dict[pid]\n        tp += c[0]\n        fp += c[1]\n        fn += c[2]\n    return tp / (tp + fp + fn + 1e-8)\n\n\n# ============================================================================\n# 4. PAIRED BOOTSTRAP SIGNIFICANCE TEST\n# ============================================================================\n\ndef paired_bootstrap_iou_diff(counts_a, counts_b, n_boot=10000, seed=RNG_SEED):\n    \"\"\"\n    Paired patch-level bootstrap for two checkpoints on the same test set.\n    \n    Args:\n        counts_a, counts_b: {patch_id: (tp,fp,fn,tn)} over the SAME patch set\n        n_boot: Number of bootstrap resamples\n        seed: Random seed for reproducibility\n    \n    Returns:\n        dict with point estimate, 95% CI, and two-sided p-value for H0: IoU_a == IoU_b\n    \"\"\"\n    # Ensure both models have counts for the same patches\n    patch_ids = sorted(set(counts_a) & set(counts_b))\n    if len(patch_ids) != len(counts_a):\n        missing = set(counts_a) ^ set(counts_b)\n        raise ValueError(f\"Patch sets differ between models: {missing}\")\n\n    rng = np.random.default_rng(seed)\n    n = len(patch_ids)\n    \n    # Point estimates on full patch set\n    point_a = _global_iou_from_counts(counts_a, patch_ids)\n    point_b = _global_iou_from_counts(counts_b, patch_ids)\n    point_diff = point_a - point_b\n\n    # Bootstrap resampling\n    diffs = np.empty(n_boot)\n    for b in range(n_boot):\n        # Resample patches with replacement\n        sample = rng.choice(patch_ids, size=n, replace=True)\n        # Compute global IoU for both models on the same resampled patches\n        diffs[b] = _global_iou_from_counts(counts_a, sample) - _global_iou_from_counts(counts_b, sample)\n\n    # 95% confidence interval (percentile method)\n    ci_lo, ci_hi = np.percentile(diffs, [2.5, 97.5])\n    \n    # Two-sided bootstrap p-value:\n    # Proportion of resamples on the \"other side\" of zero, doubled\n    if point_diff >= 0:\n        p = 2 * min((diffs <= 0).mean(), 0.5)\n    else:\n        p = 2 * min((diffs >= 0).mean(), 0.5)\n    p = min(p, 1.0)\n\n    return {\n        \"n_patches\": n,\n        \"iou_a\": round(point_a, 4),\n        \"iou_b\": round(point_b, 4),\n        \"diff\": round(point_diff, 4),\n        \"ci95_lo\": round(ci_lo, 4),\n        \"ci95_hi\": round(ci_hi, 4),\n        \"p_value\": round(p, 4),\n        \"significant_at_0.05\": bool(p < 0.05),\n    }\n\n\n# ============================================================================\n# 5. DRIVER: RUN ALL PAPER COMPARISONS\n# ============================================================================\n\ndef run_significance_suite(\n    manifest_path: str,\n    features_dir: str,\n    masks_dir: str,\n    official_test_csv: str,\n    bolivia_csv: str,\n    checkpoint_map: Dict[str, str],  # {variant: weights_path}\n    comparisons: List[Tuple[str, str, str]],  # [(variant_a, variant_b, split)]\n    n_boot: int = 10000,\n    out_json: str = \"significance_results.json\"\n):\n    \"\"\"\n    Run bootstrap significance tests for all specified comparisons.\n    \n    Args:\n        manifest_path: Path to patch_manifest.csv\n        features_dir: Directory with feature files\n        masks_dir: Directory with mask files\n        official_test_csv: Path to official test split CSV\n        bolivia_csv: Path to Bolivia split CSV\n        checkpoint_map: Dictionary mapping variant names to checkpoint paths\n        comparisons: List of (variant_a, variant_b, split_name) tuples\n        n_boot: Number of bootstrap resamples\n        out_json: Output file for results\n    \n    Returns:\n        List of result dictionaries\n    \"\"\"\n    print(f\"\\n{'='*80}\")\n    print(\"STATISTICAL SIGNIFICANCE TESTING SUITE\")\n    print(f\"{'='*80}\")\n    print(f\"Device: {DEVICE}\")\n    print(f\"Bootstrap resamples: {n_boot}\")\n    print(f\"Comparisons: {len(comparisons)}\")\n    print(f\"{'='*80}\\n\")\n    \n    # Load split dataframes\n    print(\"Loading test splits...\")\n    test_df = get_split_df(manifest_path, official_test_csv)\n    bolivia_df = get_split_df(manifest_path, bolivia_csv)\n    split_dfs = {\"official_test\": test_df, \"bolivia\": bolivia_df}\n    print(f\"  Official test: {len(test_df)} patches\")\n    print(f\"  Bolivia: {len(bolivia_df)} patches\")\n    print()\n    \n    # Identify unique variants needed\n    needed_variants = sorted({v for pair in comparisons for v in pair[:2]})\n    print(f\"Variants to load: {needed_variants}\")\n    \n    # Load each model once and compute per-patch confusion counts\n    counts_cache = {}  # (variant, split) -> counts dict\n    \n    for variant in needed_variants:\n        print(f\"\\n{'─'*40}\")\n        print(f\"Processing: {variant}\")\n        print(f\"{'─'*40}\")\n        \n        if variant not in checkpoint_map:\n            print(f\"  ❌ Warning: {variant} not in checkpoint_map, skipping...\")\n            continue\n            \n        print(f\"  Loading checkpoint: {checkpoint_map[variant]}\")\n        model = load_checkpoint(checkpoint_map[variant], variant)\n        \n        needed_splits = {split for a, b, split in comparisons if variant in (a, b)}\n        print(f\"  Needed splits: {needed_splits}\")\n        \n        for split in needed_splits:\n            print(f\"\\n  Scoring {variant} on {split}...\")\n            counts = get_per_patch_confusion(\n                model, split_dfs[split], features_dir, masks_dir\n            )\n            counts_cache[(variant, split)] = counts\n            print(f\"    ✅ Computed confusion counts for {len(counts)} patches\")\n        \n        # Release model memory\n        del model\n        if torch.cuda.is_available():\n            torch.cuda.empty_cache()\n    \n    # Run all bootstrap comparisons\n    print(f\"\\n{'='*80}\")\n    print(\"BOOTSTRAP RESULTS\")\n    print(f\"{'='*80}\\n\")\n    \n    results = []\n    for a, b, split in comparisons:\n        print(f\"Comparison: {a} vs {b} on {split}\")\n        \n        # Check if counts are available\n        if (a, split) not in counts_cache:\n            print(f\"  ❌ Warning: {a} counts not available for {split}, skipping...\")\n            continue\n        if (b, split) not in counts_cache:\n            print(f\"  ❌ Warning: {b} counts not available for {split}, skipping...\")\n            continue\n        \n        try:\n            res = paired_bootstrap_iou_diff(\n                counts_cache[(a, split)], \n                counts_cache[(b, split)], \n                n_boot=n_boot\n            )\n            res.update({\n                \"variant_a\": a, \n                \"variant_b\": b, \n                \"split\": split,\n                \"n_boot\": n_boot\n            })\n            results.append(res)\n            \n            # Print results\n            verdict = \"✅ SIGNIFICANT\" if res[\"significant_at_0.05\"] else \"❌ NOT SIGNIFICANT\"\n            print(f\"  IoU: {res['iou_a']:.4f} vs {res['iou_b']:.4f}\")\n            print(f\"  Difference: {res['diff']:+.4f} IoU points\")\n            print(f\"  95% CI: [{res['ci95_lo']:+.4f}, {res['ci95_hi']:+.4f}]\")\n            print(f\"  p-value: {res['p_value']:.4f}\")\n            print(f\"  → {verdict}\\n\")\n            \n        except Exception as e:\n            print(f\"  ❌ Error in bootstrap: {e}\")\n            continue\n    \n    # Save results\n    print(f\"{'='*80}\")\n    with open(out_json, \"w\") as f:\n        json.dump(results, f, indent=2)\n    print(f\"✅ Results saved to: {out_json}\")\n    \n    # Summary table\n    if results:\n        print(f\"\\n{'='*80}\")\n        print(\"SUMMARY\")\n        print(f\"{'='*80}\")\n        print(f\"{'Variant A':<20} {'Variant B':<20} {'Split':<15} {'Diff':<10} {'p-value':<10} {'Significant'}\")\n        print(\"-\" * 80)\n        for r in results:\n            sig = \"✅\" if r[\"significant_at_0.05\"] else \"❌\"\n            print(f\"{r['variant_a']:<20} {r['variant_b']:<20} {r['split']:<15} \"\n                  f\"{r['diff']:+.4f}    {r['p_value']:.4f}    {sig}\")\n    \n    return results\n\n\n# ============================================================================\n# 6. MAIN EXECUTION\n# ============================================================================\n\nif __name__ == \"__main__\":\n    # ====================================================================\n    # CONFIGURATION - UPDATE THESE PATHS TO MATCH YOUR SYSTEM\n    # ====================================================================\n    \n    # Data paths\n    MANIFEST = \"./data/ml_dataset/patch_manifest.csv\"\n    FEATURES = \"./data/ml_dataset/features\"\n    MASKS = \"./data/ml_dataset/masks\"\n    OFFICIAL_TEST_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_test_data.csv\"\n    OFFICIAL_BOLIVIA_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_bolivia_data.csv\"\n    \n    # Model checkpoints - UPDATE THESE PATHS\n    checkpoint_map = {\n        \"full\": \"/kaggle/working/ablation_best_flood_model_full.pth\",\n        \"no_opt_dropout\": \"/kaggle/working/ablation_best_flood_model_no_opt_dropout.pth\",\n        \"no_optical\": \"/kaggle/working/ablation_best_flood_model_no_optical.pth\",\n        \"single_stream_sar\": \"/kaggle/working/ablation_best_flood_model_single_stream_sar.pth\",\n        \"no_cbam\": \"/kaggle/working/ablation_best_flood_model_no_cbam.pth\",\n        \"symmetric_loss\": \"/kaggle/working/ablation_best_flood_model_symmetric_loss.pth\",\n    }\n    \n    # Comparisons to test (from the paper's informal claims)\n    comparisons = [\n        (\"full\", \"no_opt_dropout\", \"bolivia\"),           # full wins by 1.6 pts on Bolivia\n        (\"full\", \"no_opt_dropout\", \"official_test\"),     # no_opt_dropout wins by 1.4 pts\n        (\"no_optical\", \"single_stream_sar\", \"official_test\"),  # architectural difference\n        (\"no_cbam\", \"full\", \"official_test\"),            # CBAM contribution\n        (\"symmetric_loss\", \"full\", \"official_test\"),     # loss function contribution\n    ]\n    \n    # ====================================================================\n    # PATH VALIDATION\n    # ====================================================================\n    \n    print(\"=\" * 80)\n    print(\"PATH VALIDATION\")\n    print(\"=\" * 80)\n    \n    for path_name, path in [\n        (\"Manifest\", MANIFEST),\n        (\"Features dir\", FEATURES),\n        (\"Masks dir\", MASKS),\n        (\"Test CSV\", OFFICIAL_TEST_CSV),\n        (\"Bolivia CSV\", OFFICIAL_BOLIVIA_CSV),\n    ]:\n        exists = os.path.exists(path)\n        print(f\"  {path_name}: {path}\")\n        print(f\"    → {'✅ EXISTS' if exists else '❌ NOT FOUND'}\")\n    \n    print(\"\\nModel checkpoints:\")\n    for name, path in checkpoint_map.items():\n        exists = os.path.exists(path)\n        print(f\"  {name}: {path}\")\n        print(f\"    → {'✅ EXISTS' if exists else '❌ NOT FOUND'}\")\n    \n    print(\"=\" * 80)\n    \n    # ====================================================================\n    # RUN THE SIGNIFICANCE TESTS\n    # ====================================================================\n    \n    try:\n        results = run_significance_suite(\n            manifest_path=MANIFEST,\n            features_dir=FEATURES,\n            masks_dir=MASKS,\n            official_test_csv=OFFICIAL_TEST_CSV,\n            bolivia_csv=OFFICIAL_BOLIVIA_CSV,\n            checkpoint_map=checkpoint_map,\n            comparisons=comparisons,\n            n_boot=10000,\n            out_json=\"significance_results.json\"\n        )\n        \n        # Final summary\n        print(f\"\\n{'='*80}\")\n        print(\"FINAL SUMMARY\")\n        print(f\"{'='*80}\")\n        print(f\"Total comparisons tested: {len(results)}\")\n        \n        if results:\n            significant = sum(1 for r in results if r[\"significant_at_0.05\"])\n            print(f\"Significant (p < 0.05): {significant}\")\n            print(f\"Not significant: {len(results) - significant}\")\n            \n            print(\"\\nInterpretation for paper:\")\n            for r in results:\n                if r[\"significant_at_0.05\"]:\n                    print(f\"  ✅ The {r['diff']:+.4f} IoU point difference between \"\n                          f\"'{r['variant_a']}' and '{r['variant_b']}' on {r['split']} \"\n                          f\"is statistically significant (p={r