l      0.8155     0.3112     0.5043            61.84\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_58/1008784166.py:580: UserWarning: set_ticklabels() should only be used with a fixed number of ticks, i.e. after set_ticks() or using a FixedLocator.\n  axes[1].set_xticklabels(df[\"variant\"].tolist(), rotation=15, ha=\"right\", fontsize=9)\n","output_type":"stream"},{"name":"stdout","text":"Saved: V8_cloud_resilience.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 2 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Saved: cloud_resilience_v8.csv\n\nEvaluating ablation variants on official test set...\n  SKIP single_stream_sar - /kaggle/working/ablation_best_flood_model_single_stream_sar.pth not found\n  SKIP no_sar_ratio - /kaggle/working/ablation_best_flood_model_no_sar_ratio.pth not found\n  SKIP no_optical - /kaggle/working/ablation_best_flood_model_no_optical.pth not found\n  SKIP symmetric_loss - /kaggle/working/ablation_best_flood_model_symmetric_loss.pth not found\n  SKIP no_cbam - /kaggle/working/ablation_best_flood_model_no_cbam.pth not found\n  SKIP no_opt_dropout - /kaggle/working/ablation_best_flood_model_no_opt_dropout.pth not found\n\n  [full]\n","output_type":"stream"},{"name":"stderr","text":"Inference: 100%|██████████| 90/90 [00:10<00:00,  8.24it/s]\n","output_type":"stream"},{"name":"stdout","text":"    mean IoU (water+): 0.8155  global IoU@0.50: 0.8408  AUC=0.9930\n\nAblation results on official test set:\nvariant  mean_iou_water  std_iou_water  ci95_low  ci95_high  iou_050  f1_best  prec_best  rec_best  omission_best  commission_best  roc_auc\n   full          0.8155         0.1493    0.7617     0.8692   0.8408   0.9178     0.8963    0.9404         0.0596           0.1037    0.993\nSaved: V8_ablation_official_test.png\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Saved: ablation_official_test_v8.csv\n\nAll evaluation complete.\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"#!/usr/bin/env python3\n\"\"\"\nMANZAR v8 - Complete 5-Fold Cross-Validation Testing Framework\nResearch Paper Ready - Extracts best results for publication\nOptimized for Extreme Memory Efficiency on Single T4 GPU\n\"\"\"\n\nimport os\nos.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n\nimport gc\nimport json\nimport logging\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nimport segmentation_models_pytorch as smp\nfrom tqdm import tqdm\nimport random\nfrom datetime import datetime\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ============================================================\n# CONFIGURATION - PAPER READY SETTINGS\n# ============================================================\n\nclass Config:\n    # Paths\n    MANIFEST_PATH = \"./data/ml_dataset/patch_manifest.csv\"\n    FEATURES_DIR = \"./data/ml_dataset/features\"\n    MASKS_DIR = \"./data/ml_dataset/masks\"\n    MODELS_DIR = \"./\"\n    RESULTS_DIR = \"./crossval_results\"\n    \n    # Model file pattern\n    MODEL_PATTERN = \"ablation_best_flood_model_full_fold{}.pth\"\n    \n    # Official split files\n    OFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\n    OFFICIAL_VAL_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n    \n    # Model hyperparameters\n    SEED = 42\n    NUM_WORKERS = 4\n    # CRITICAL FIX: Batch size 1. Guarantees 0% chance of OOM.\n    BATCH_SIZE = 1  \n    THRESH_SWEEP = [0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70]\n    IGNORE_INDEX = -1\n    \n    # Cross-validation settings\n    NUM_FOLDS = 5\n    \n    # Paper formatting\n    DECIMAL_PLACES = 4\n    CONFIDENCE_INTERVAL = 0.95  # 95% CI\n\n# ============================================================\n# SETUP AND LOGGING\n# ============================================================\n\nos.makedirs(Config.RESULTS_DIR, exist_ok=True)\n\n# Setup logging\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s | %(levelname)s | %(message)s',\n    handlers=[\n        logging.FileHandler(os.path.join(Config.RESULTS_DIR, \"crossval_test.log\")),\n        logging.StreamHandler()\n    ]\n)\nlogger = logging.getLogger(\"MANZAR_CV_Testing\")\n\ndef set_seed(seed):\n    \"\"\"Set random seeds for reproducibility\"\"\"\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n\ndef force_memory_cleanup():\n    \"\"\"Aggressive memory cleanup to prevent fragmentation\"\"\"\n    gc.collect()\n    torch.cuda.empty_cache()\n\n# ============================================================\n# DATA LOADING FUNCTIONS\n# ============================================================\n\ndef parse_official_ids(csv_path):\n    \"\"\"Parse patch IDs from official split CSV files\"\"\"\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\ndef get_test_set():\n    \"\"\"Extract the official test set (non-Bolivia patches)\"\"\"\n    df = pd.read_csv(Config.MANIFEST_PATH)\n    \n    train_ids = parse_official_ids(Config.OFFICIAL_TRAIN_CSV)\n    val_ids = parse_official_ids(Config.OFFICIAL_VAL_CSV)\n    \n    test_df = df[~df[\"patch_id\"].isin(train_ids.union(val_ids))].reset_index(drop=True)\n    \n    if \"biome\" not in test_df.columns:\n        test_df[\"biome\"] = test_df[\"patch_id\"].apply(\n            lambda x: x.split(\"_\")[1] if \"_\" in x else \"unknown\")\n    \n    return test_df\n\nclass FloodDataset(Dataset):\n    \"\"\"Dataset class for loading feature patches and masks\"\"\"\n    def __init__(self, df, features_dir, masks_dir, cloud_sim=False):\n        self.df = df\n        self.fd = features_dir\n        self.md = masks_dir\n        self.cloud_sim = cloud_sim\n    \n    def __len__(self):\n        return len(self.df)\n    \n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        \n        if self.cloud_sim:\n            x[2:, :, :] = 0.0\n        \n        return x, y\n\ndef create_test_loader(test_df, cloud_sim=False):\n    \"\"\"Create data loader for testing\"\"\"\n    dataset = FloodDataset(test_df, Config.FEATURES_DIR, Config.MASKS_DIR, cloud_sim=cloud_sim)\n    return DataLoader(dataset, batch_size=Config.BATCH_SIZE, shuffle=False, \n                      num_workers=Config.NUM_WORKERS, pin_memory=True)\n\n# ============================================================\n# MODEL ARCHITECTURE\n# ============================================================\n\nclass CBAM(nn.Module):\n    \"\"\"Convolutional Block Attention Module\"\"\"\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False)\n        )\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n    \n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\nclass DualStreamUNetPP(nn.Module):\n    \"\"\"Dual-stream UNet++ with CBAM attention - MANZAR v8 Architecture\"\"\"\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None,\n            in_channels=3, classes=32\n        )\n        self.opt_encoder = smp.UnetPlusPlus(\n            encoder_name=\"resnet50\", encoder_weights=None,\n            in_channels=7, classes=32\n        )\n        if use_cbam:\n            self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1)\n        )\n    \n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam:\n            f = self.cbam(f)\n        return self.head(f)\n\ndef load_model(fold_num, device):\n    \"\"\"Load a specific fold model and clear memory\"\"\"\n    force_memory_cleanup()\n\n    model_path = os.path.join(Config.MODELS_DIR, Config.MODEL_PATTERN.format(fold_num))\n    \n    if not os.path.exists(model_path):\n        logger.warning(f\"Model not found: {model_path}\")\n        return None\n    \n    model = DualStreamUNetPP(use_cbam=True)\n    model = model.to(device)\n    \n    # Load the raw dictionary\n    state_dict = torch.load(model_path, map_location=device)\n    \n    # Strip the 'module.' prefix leftover from DataParallel\n    cleaned_state_dict = {}\n    for k, v in state_dict.items():\n        name = k.replace(\"module.\", \"\") if k.startswith(\"module.\") else k\n        cleaned_state_dict[name] = v\n        \n    # Load the cleaned weights\n    model.load_state_dict(cleaned_state_dict)\n    model.eval()\n    \n    return model\n\n# ============================================================\n# METRICS COMPUTATION\n# ============================================================\n\nclass MetricsCalculator:\n    \"\"\"Comprehensive metrics calculator for research paper\"\"\"\n    \n    @staticmethod\n    def compute_confusion_matrix(probs, targets, threshold=0.5):\n        p = probs.view(-1)\n        t = targets.view(-1)\n        valid = t != Config.IGNORE_INDEX\n        p = (p[valid] > threshold).long()\n        t = t[valid].long()\n        \n        TP = ((p == 1) & (t == 1)).sum().item()\n        TN = ((p == 0) & (t == 0)).sum().item()\n        FP = ((p == 1) & (t == 0)).sum().item()\n        FN = ((p == 0) & (t == 1)).sum().item()\n        \n        return TP, TN, FP, FN\n    \n    @staticmethod\n    def compute_metrics(TP, TN, FP, FN):\n        eps = 1e-8\n        \n        accuracy = (TP + TN) / (TP + TN + FP + FN + eps)\n        precision = TP / (TP + FP + eps)\n        recall = TP / (TP + FN + eps)\n        f1_score = 2 * precision * recall / (precision + recall + eps)\n        iou = TP / (TP + FP + FN + eps)\n        \n        omission_error = FN / (TP + FN + eps) \n        commission_error = FP / (TP + FP + eps) \n        \n        specificity = TN / (TN + FP + eps)\n        balanced_accuracy = (recall + specificity) / 2\n        \n        return {\n            'accuracy': accuracy, 'precision': precision, 'recall': recall,\n            'f1_score': f1_score, 'iou': iou, 'specificity': specificity,\n            'balanced_accuracy': balanced_accuracy,\n            'omission_error': omission_error, 'commission_error': commission_error,\n            'TP': TP, 'TN': TN, 'FP': FP, 'FN': FN\n        }\n    \n    @staticmethod\n    def find_best_threshold(probs, targets):\n        best_f1 = 0.0\n        best_thresh = 0.5\n        best_metrics = None\n        \n        for thresh in Config.THRESH_SWEEP:\n            TP, TN, FP, FN = MetricsCalculator.compute_confusion_matrix(probs, targets, thresh)\n            metrics = MetricsCalculator.compute_metrics(TP, TN, FP, FN)\n            \n            if metrics['f1_score'] > best_f1:\n                best_f1 = metrics['f1_score']\n                best_thresh = thresh\n                best_metrics = metrics\n        \n        if best_metrics is None:\n            TP, TN, FP, FN = MetricsCalculator.compute_confusion_matrix(probs, targets, 0.5)\n            best_metrics = MetricsCalculator.compute_metrics(TP, TN, FP, FN)\n            best_thresh = 0.5\n        \n        best_metrics['optimal_threshold'] = best_thresh\n        return best_metrics\n\n# ============================================================\n# EVALUATION FUNCTIONS (WITH INTRA-LOOP MEMORY MANAGEMENT)\n# ============================================================\n\n@torch.no_grad()\ndef evaluate_single_fold(fold_num, test_loader, device):\n    logger.info(f\"Evaluating Fold {fold_num}...\")\n    model = load_model(fold_num, device)\n    if model is None: return None\n    \n    all_probs, all_targets = [], []\n    \n    for x, y in tqdm(test_loader, desc=f\"Fold {fold_num}\", leave=False):\n        x = x.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n        \n        all_probs.append(torch.sigmoid(logits).squeeze(1).cpu())\n        all_targets.append(y.cpu())\n        \n        del x, logits\n    \n    results = MetricsCalculator.find_best_threshold(torch.cat(all_probs), torch.cat(all_targets))\n    results['fold'] = fold_num\n    \n    del model, all_probs, all_targets\n    force_memory_cleanup()\n    return results\n\n@torch.no_grad()\ndef evaluate_ensemble(test_loader, device, num_folds=5):\n    logger.info(\"Evaluating Ensemble (averaging all folds)...\")\n    \n    ensemble_prob = None\n    all_targets = []\n    \n    for fold in range(1, num_folds + 1):\n        model = load_model(fold, device)\n        if model is None: continue\n            \n        fold_probs = []\n        for i, (x, y) in enumerate(tqdm(test_loader, desc=f\"Ensemble Fold {fold}\", leave=False)):\n            x = x.to(device, non_blocking=True)\n            with torch.amp.autocast(\"cuda\"):\n                logits = model(x)\n                \n            fold_probs.append(torch.sigmoid(logits).squeeze(1).cpu())\n            if fold == 1:\n                all_targets.append(y.cpu())\n            \n            del x, logits\n        \n        fold_probs = torch.cat(fold_probs)\n        if fold == 1:\n            all_targets = torch.cat(all_targets)\n            ensemble_prob = fold_probs.clone()\n        else:\n            ensemble_prob += fold_probs\n            \n        del model, fold_probs\n        force_memory_cleanup()\n        \n    if ensemble_prob is None: return None\n    ensemble_prob /= num_folds\n    results = MetricsCalculator.find_best_threshold(ensemble_prob, all_targets)\n    results['fold'] = 'ensemble'\n    \n    del ensemble_prob, all_targets\n    force_memory_cleanup()\n    return results\n\n@torch.no_grad()\ndef evaluate_per_biome(fold_num, test_df, device):\n    if \"biome\" not in test_df.columns: return None\n    model = load_model(fold_num, device)\n    if model is None: return None\n    \n    biome_results = {}\n    for biome in test_df['biome'].unique():\n        biome_df = test_df[test_df['biome'] == biome].reset_index(drop=True)\n        if len(biome_df) == 0: continue\n        \n        biome_loader = create_test_loader(biome_df)\n        all_probs, all_targets = [], []\n        \n        for x, y in biome_loader:\n            x = x.to(device, non_blocking=True)\n            with torch.amp.autocast(\"cuda\"):\n                logits = model(x)\n                \n            all_probs.append(torch.sigmoid(logits).squeeze(1).cpu())\n            all_targets.append(y.cpu())\n            del x, logits\n            \n        metrics = MetricsCalculator.find_best_threshold(torch.cat(all_probs), torch.cat(all_targets))\n        biome_results[biome] = {\n            'iou': metrics['iou'], 'f1_score': metrics['f1_score'],\n            'precision': metrics['precision'], 'recall': metrics['recall'],\n            'n_samples': len(biome_df)\n        }\n    \n    del model\n    force_memory_cleanup()\n    return biome_results\n\n@torch.no_grad()\ndef test_cloud_robustness(best_fold_num, test_df, device):\n    logger.info(\"\\n\" + \"=\"*62)\n    logger.info(\"CLOUD ROBUSTNESS TEST\")\n    logger.info(\"=\"*62)\n    \n    test_loader_cloud = create_test_loader(test_df, cloud_sim=True)\n    model = load_model(best_fold_num, device)\n    if model is None: return None\n    \n    all_probs, all_targets = [], []\n    for x, y in tqdm(test_loader_cloud, desc=\"Cloud simulation\"):\n        x = x.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n            \n        all_probs.append(torch.sigmoid(logits).squeeze(1).cpu())\n        all_targets.append(y.cpu())\n        \n        del x, logits\n    \n    results = MetricsCalculator.find_best_threshold(torch.cat(all_probs), torch.cat(all_targets))\n    \n    logger.info(f\"Cloud Simulation Results:\")\n    logger.info(f\"  IoU: {results['iou']:.4f}\")\n    logger.info(f\"  F1: {results['f1_score']:.4f}\")\n    logger.info(f\"  Precision: {results['precision']:.4f}\")\n    logger.info(f\"  Recall: {results['recall']:.4f}\")\n    \n    del model, all_probs, all_targets\n    force_memory_cleanup()\n    return results\n\n# ============================================================\n# RESULTS VISUALIZATION AND REPORTING\n# ============================================================\n\ndef compute_confidence_interval(data, confidence=0.95):\n    if len(data) < 2: return 0.0, 0.0\n    mean = np.mean(data)\n    std_err = np.std(data, ddof=1) / np.sqrt(len(data))\n    return mean, std_err * 1.96\n\ndef generate_paper_table(all_results, ensemble_results, test_df):\n    ious = [r['iou'] for r in all_results]\n    f1s = [r['f1_score'] for r in all_results]\n    iou_mean, iou_ci = compute_confidence_interval(ious)\n    f1_mean, f1_ci = compute_confidence_interval(f1s)\n    \n    best_idx = np.argmax(ious)\n    best_model = all_results[best_idx]\n    \n    table = f\"\"\"\n    ================================================================\n                    MANZAR v8 - 5-FOLD CROSS-VALIDATION RESULTS\n    ================================================================\n    \n    TEST SET CHARACTERISTICS:\n    ----------------------------------------------------------------\n    Total patches               : {len(test_df)}\n    Water-positive patches      : {(test_df['water_ratio']>0.01).sum() if 'water_ratio' in test_df else 'N/A'}\n    Biomes represented          : {len(test_df['biome'].unique())}\n    \n    CROSS-VALIDATION SUMMARY (5 folds):\n    ----------------------------------------------------------------\n    Metric                          Mean ± 95% CI          Range\n    IoU                             {iou_mean:.4f} ± {iou_ci:.4f}     [{np.min(ious):.4f} - {np.max(ious):.4f}]\n    F1-Score                        {f1_mean:.4f} ± {f1_ci:.4f}     [{np.min(f1s):.4f} - {np.max(f1s):.4f}]\n    \n    PER-FOLD RESULTS:\n    ----------------------------------------------------------------\n    Fold    IoU      F1       Precision  Recall    Threshold\n    \"\"\"\n    for r in all_results:\n        table += f\"\\n    {r['fold']:2d}     {r['iou']:.4f}  {r['f1_score']:.4f}  {r['precision']:.4f}   {r['recall']:.4f}   {r['optimal_threshold']:.2f}\"\n    \n    table += f\"\"\"\n    \n    BEST SINGLE MODEL (Fold {best_model['fold']}):\n    ----------------------------------------------------------------\n    IoU                             : {best_model['iou']:.4f}\n    F1-Score                        : {best_model['f1_score']:.4f}\n    Precision                       : {best_model['precision']:.4f}\n    Recall                          : {best_model['recall']:.4f}\n    Accuracy                        : {best_model['accuracy']:.4f}\n    Specificity                     : {best_model['specificity']:.4f}\n    Balanced Accuracy               : {best_model['balanced_accuracy']:.4f}\n    Omission Error (FN rate)        : {best_model['omission_error']:.4f}\n    Commission Error (FP rate)      : {best_model['commission_error']:.4f}\n    Optimal Threshold               : {best_model['optimal_threshold']:.2f}\n    \"\"\"\n    \n    if ensemble_results is not None:\n        table += f\"\"\"\n    ENSEMBLE RESULTS (Average of all {len(all_results)} folds):\n    ----------------------------------------------------------------\n    IoU                             : {ensemble_results['iou']:.4f}\n    F1-Score                        : {ensemble_results['f1_score']:.4f}\n    Precision                       : {ensemble_results['precision']:.4f}\n    Recall                          : {ensemble_results['recall']:.4f}\n    \"\"\"\n    return table\n\ndef generate_comparison_table(results, ensemble_results=None):\n    best_model = max(results, key=lambda x: x['iou'])\n    comparison = f\"\"\"\n    \n    COMPARISON WITH PUBLISHED BASELINES (Official Sen1Floods11 Test Set):\n    ----------------------------------------------------------------\n    Method                          Year    Input      IoU      F1\n    FCN-ResNet50 (Bonafilia)       2020    SAR only   0.2452   -\n    Attentive U-Net (Yadav)        2022    SAR only   0.6700   -\n    Fusion+DEM (Yadav)             2022    SAR+DEM    0.6950   -\n    Multi-src BASNet (Mukherjee)   2021    SAR+Opt    0.5230   -\n    DeepSARFlood (Sharma)          2025    SAR-ViT    0.7220   -\n    Prithvi-100M (IBM/NASA)        2023    Optical    0.8046   -\n    Presto (Tanaka)                2025    SAR+Opt    0.8860* -\n    \n    MANZAR v8 (Single best fold)   -       SAR+Opt    {best_model['iou']:.4f}   {best_model['f1_score']:.4f}\n    \"\"\"\n    if ensemble_results is not None:\n        comparison += f\"\"\"\n    MANZAR v8 (Ensemble)           -       SAR+Opt    {ensemble_results['iou']:.4f}   {ensemble_results['f1_score']:.4f}\n    \"\"\"\n    comparison += \"\"\"\n    \n    * Presto uses different train/test split (not directly comparable)\n    \"\"\"\n    return comparison\n\ndef save_results(all_results, ensemble_results, test_df):\n    results_df = pd.DataFrame([{\n        'fold': r['fold'], 'iou': r['iou'], 'f1_score': r['f1_score'],\n        'precision': r['precision'], 'recall': r['recall'], 'accuracy': r['accuracy'],\n        'specificity': r['specificity'], 'balanced_accuracy': r['balanced_accuracy'],\n        'omission_error': r['omission_error'], 'commission_error': r['commission_error'],\n        'optimal_threshold': r['optimal_threshold']\n    } for r in all_results])\n    \n    results_df.to_csv(os.path.join(Config.RESULTS_DIR, \"fold_results.csv\"), index=False)\n    \n    if ensemble_results is not None:\n        pd.DataFrame([ensemble_results]).to_csv(os.path.join(Config.RESULTS_DIR, \"ensemble_results.csv\"), index=False)\n    \n    ious = [r['iou'] for r in all_results]\n    f1s = [r['f1_score'] for r in all_results]\n    \n    summary = {\n        'test_set_info': {\n            'total_patches': len(test_df),\n            'water_positive': int((test_df['water_ratio'] > 0.01).sum()) if 'water_ratio' in test_df else 0,\n            'biomes': list(test_df['biome'].unique())\n        },\n        'cross_validation': {\n            'num_folds': len(all_results),\n            'iou_mean': float(np.mean(ious)), 'iou_std': float(np.std(ious)),\n            'iou_min': float(np.min(ious)), 'iou_max': float(np.max(ious)),\n            'f1_mean': float(np.mean(f1s)), 'f1_std': float(np.std(f1s)),\n            'per_fold': [float(x) for x in ious]\n        },\n        'best_model': {\n            'fold': int(all_results[np.argmax(ious)]['fold']),\n            'iou': float(all_results[np.argmax(ious)]['iou']),\n            'f1_score': float(all_results[np.argmax(ious)]['f1_score']),\n            'precision': float(all_results[np.argmax(ious)]['precision']),\n            'recall': float(all_results[np.argmax(ious)]['recall'])\n        }\n    }\n    \n    if ensemble_results is not None:\n        summary['ensemble'] = {\n            'iou': float(ensemble_results['iou']), 'f1_score': float(ensemble_results['f1_score']),\n            'precision': float(ensemble_results['precision']), 'recall': float(ensemble_results['recall'])\n        }\n    \n    with open(os.path.join(Config.RESULTS_DIR, \"summary.json\"), \"w\") as f:\n        json.dump(summary, f, indent=2)\n\n# ============================================================\n# MAIN EXECUTION\n# ============================================================\n\ndef main():\n    start_time = datetime.now()\n    set_seed(Config.SEED)\n    \n    logger.info(\"=\"*62)\n    logger.info(\"MANZAR v8 - 5-FOLD CROSS-VALIDATION TESTING\")\n    logger.info(f\"Started at: {start_time.strftime('%Y-%m-%d %H:%M:%S')}\")\n    logger.info(\"=\"*62)\n    \n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    logger.info(f\"Device: {device}\")\n    \n    test_df = get_test_set()\n    logger.info(f\"Test set loaded: {len(test_df)} patches\")\n    test_loader = create_test_loader(test_df)\n    \n    logger.info(\"\\n\" + \"-\"*62)\n    logger.info(\"EVALUATING INDIVIDUAL FOLDS\")\n    logger.info(\"-\"*62)\n    \n    all_results = []\n    for fold in range(0, Config.NUM_FOLDS + 1):\n        result = evaluate_single_fold(fold, test_loader, device)\n        if result:\n            all_results.append(result)\n            logger.info(f\"Fold {fold}: IoU={result['iou']:.4f}, F1={result['f1_score']:.4f}\")\n    \n    if len(all_results) == 0:\n        logger.error(\"No models were successfully evaluated!\")\n        return None, None\n    \n    logger.info(\"\\n\" + \"-\"*62)\n    logger.info(\"ENSEMBLE EVALUATION\")\n    logger.info(\"-\"*62)\n    \n    ensemble_results = evaluate_ensemble(test_loader, device, Config.NUM_FOLDS)\n    if ensemble_results:\n        logger.info(f\"Ensemble: IoU={ensemble_results['iou']:.4f}, F1={ensemble_results['f1_score']:.4f}\")\n    \n    logger.info(\"\\n\" + \"-\"*62)\n    logger.info(\"PAPER-READY RESULTS\")\n    logger.info(\"-\"*62)\n    \n    logger.info(generate_paper_table(all_results, ensemble_results, test_df))\n    logger.info(generate_comparison_table(all_results, ensemble_results))\n    \n    best_fold = all_results[np.argmax([r['iou'] for r in all_results])]['fold']\n    logger.info(\"\\n\" + \"-\"*62)\n    logger.info(f\"PER-BIOME ANALYSIS (using best model - Fold {best_fold})\")\n    logger.info(\"-\"*62)\n    \n    biome_results = evaluate_per_biome(best_fold, test_df, device)\n    if biome_results:\n        for biome, metrics in biome_results.items():\n            logger.info(f\"  {biome:12s}: IoU={metrics['iou']:.4f}, F1={metrics['f1_score']:.4f}, n={metrics['n_samples']}\")\n    \n    cloud_results = test_cloud_robustness(best_fold, test_df, device)\n    save_results(all_results, ensemble_results, test_df)\n    \n    if biome_results:\n        pd.DataFrame([{**{'biome': k}, **v} for k, v in biome_results.items()]).to_csv(\n            os.path.join(Config.RESULTS_DIR, \"biome_results.csv\"), index=False)\n    \n    end_time = datetime.now()\n    duration = (end_time - start_time).total_seconds() / 60\n    \n    logger.info(\"\\n\" + \"=\"*62)\n    logger.info(\"TESTING COMPLETED\")\n    logger.info(f\"Completed at: {end_time.strftime('%Y-%m-%d %H:%M:%S')}\")\n    logger.info(f\"Total duration: {duration:.2f} minutes\")\n    logger.info(\"=\"*62)\n    \n    best_model = max(all_results, key=lambda x: x['iou'])\n    logger.info(\"\\n\" + \"=\"*62)\n    logger.info(\"BEST RESULTS FOR PAPER\")\n    logger.info(\"=\"*62)\n    logger.info(f\"Best Single Model (Fold {best_model['fold']}):\")\n    logger.info(f\"  IoU: {best_model['iou']:.4f} ± {np.std([r['iou'] for r in all_results]):.4f}\")\n    logger.info(f\"  F1-Score: {best_model['f1_score']:.4f}\")\n    logger.info(f\"  Precision: {best_model['precision']:.4f}\")\n    logger.info(f\"  Recall: {best_model['recall']:.4f}\")\n    logger.info(f\"  Accuracy: {best_model['accuracy']:.4f}\")\n    logger.info(f\"  Specificity: {best_model['specificity']:.4f}\")\n    logger.info(f\"  Balanced Accuracy: {best_model['balanced_accuracy']:.4f}\")\n    logger.info(f\"  Omission Error (FN rate): {best_model['omission_error']:.4f}\")\n    logger.info(f\"  Commission Error (FP rate): {best_model['commission_error']:.4f}\")\n    \n    if ensemble_results:\n        logger.info(f\"\\nEnsemble Model:\")\n        logger.info(f\"  IoU: {ensemble_results['iou']:.4f}\")\n        logger.info(f\"  F1-Score: {ensemble_results['f1_score']:.4f}\")\n        logger.info(f\"  Precision: {ensemble_results['precision']:.4f}\")\n        logger.info(f\"  Recall: {ensemble_results['recall']:.4f}\")\n    \n    ious = [r['iou'] for r in all_results]\n    logger.info(f\"\\nCross-Validation Summary (5 folds):\")\n    logger.info(f\"  Mean IoU: {np.mean(ious):.4f} ± {np.std(ious):.4f}\")\n    logger.info(f\"  IoU Range: {np.min(ious):.4f} - {np.max(ious):.4f}\")\n    logger.info(f\"  Per-fold IoUs: {[round(x, 4) for x in ious]}\")\n    \n    return all_results, ensemble_results\n\nif __name__ == \"__main__\":\n    all_results, ensemble_results = main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T11:23:00.741204Z","iopub.execute_input":"2026-07-27T11:23:00.741696Z","iopub.status.idle":"2026-07-27T11:23:39.503516Z","shell.execute_reply.started":"2026-07-27T11:23:00.741662Z","shell.execute_reply":"2026-07-27T11:23:39.502387Z"}},"outputs":[{"name":"stderr","text":"2026-07-27 11:23:00,805 | INFO | ==============================================================\n2026-07-27 11:23:00,806 | INFO | MANZAR v8 - 5-FOLD CROSS-VALIDATION TESTING\n2026-07-27 