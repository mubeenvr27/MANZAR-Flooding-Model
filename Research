4\u001b[0;31m             \u001b[0mensemble_prob\u001b[0m \u001b[0;34m+=\u001b[0m \u001b[0mfold_probs\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m    355\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m    356\u001b[0m         \u001b[0;32mdel\u001b[0m \u001b[0mmodel\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mfold_probs\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mTypeError\u001b[0m: unsupported operand type(s) for +=: 'NoneType' and 'Tensor'"],"ename":"TypeError","evalue":"unsupported operand type(s) for +=: 'NoneType' and 'Tensor'","output_type":"error"}],"execution_count":7},{"cell_type":"code","source":"#!/usr/bin/env python3\n\"\"\"\nMANZAR v8 - Single Model Evaluation & Confusion Matrix Generator\nTarget: Flooding Detection (ablation_best_flood_model_full.pth)\n\"\"\"\n\nimport os\nos.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] = \"expandable_segments:True\"\n\nimport gc\nimport torch\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nimport segmentation_models_pytorch as smp\nfrom tqdm import tqdm\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ============================================================\n# CONFIGURATION\n# ============================================================\nclass Config:\n    MANIFEST_PATH = \"./data/ml_dataset/patch_manifest.csv\"\n    FEATURES_DIR = \"./data/ml_dataset/features\"\n    MASKS_DIR = \"./data/ml_dataset/masks\"\n    \n    # EXACT path to your model\n    MODEL_PATH = \"/kaggle/working/ablation_best_flood_model_full.pth\"\n    \n    OFFICIAL_TRAIN_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_train_data.csv\"\n    OFFICIAL_VAL_CSV = \"/kaggle/input/datasets/muhammadmubeenxt/splits-s1floods11/flood_valid_data.csv\"\n    \n    BATCH_SIZE = 4  # Memory safe\n    NUM_WORKERS = 4\n    IGNORE_INDEX = -1\n    THRESH_SWEEP = [0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70]\n\n# ============================================================\n# DATA & ARCHITECTURE (Copied from your pipeline)\n# ============================================================\ndef parse_official_ids(csv_path):\n    df = pd.read_csv(csv_path, header=None)\n    ids = set()\n    for val in df.iloc[:, 0]:\n        base = str(val).replace(\"S1Hand/\", \"\").replace(\"_S1Hand.tif\", \"\")\n        ids.add(f\"SEN1_{base}\")\n    return ids\n\ndef get_test_set():\n    df = pd.read_csv(Config.MANIFEST_PATH)\n    train_ids = parse_official_ids(Config.OFFICIAL_TRAIN_CSV)\n    val_ids = parse_official_ids(Config.OFFICIAL_VAL_CSV)\n    return df[~df[\"patch_id\"].isin(train_ids.union(val_ids))].reset_index(drop=True)\n\nclass FloodDataset(Dataset):\n    def __init__(self, df, features_dir, masks_dir):\n        self.df = df\n        self.fd = features_dir\n        self.md = masks_dir\n    def __len__(self): return len(self.df)\n    def __getitem__(self, idx):\n        pid = self.df.iloc[idx][\"patch_id\"]\n        x = torch.from_numpy(np.load(os.path.join(self.fd, f\"{pid}.npy\"))).float()\n        y = torch.from_numpy(np.load(os.path.join(self.md, f\"{pid}.npy\"))).long()\n        return x, y\n\nclass CBAM(nn.Module):\n    def __init__(self, channels, reduction=8):\n        super().__init__()\n        self.avg = nn.AdaptiveAvgPool2d(1)\n        self.max = nn.AdaptiveMaxPool2d(1)\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction, bias=False),\n            nn.ReLU(inplace=True),\n            nn.Linear(channels // reduction, channels, bias=False)\n        )\n        self.sc = nn.Conv2d(2, 1, kernel_size=7, padding=3, bias=False)\n    def forward(self, x):\n        b, c, _, _ = x.shape\n        a = self.fc(self.avg(x).view(b, c))\n        m = self.fc(self.max(x).view(b, c))\n        x = x * torch.sigmoid(a + m).view(b, c, 1, 1)\n        s = torch.cat([x.mean(1, keepdim=True), x.max(1, keepdim=True)[0]], dim=1)\n        return x * torch.sigmoid(self.sc(s))\n\nclass DualStreamUNetPP(nn.Module):\n    def __init__(self, use_cbam=True):\n        super().__init__()\n        self.use_cbam = use_cbam\n        self.sar_encoder = smp.UnetPlusPlus(encoder_name=\"resnet50\", encoder_weights=None, in_channels=3, classes=32)\n        self.opt_encoder = smp.UnetPlusPlus(encoder_name=\"resnet50\", encoder_weights=None, in_channels=7, classes=32)\n        if use_cbam: self.cbam = CBAM(64, reduction=8)\n        self.head = nn.Sequential(\n            nn.Conv2d(64, 32, 3, padding=1, bias=False),\n            nn.BatchNorm2d(32),\n            nn.ReLU(inplace=True),\n            nn.Dropout2d(p=0.15),\n            nn.Conv2d(32, 1, 1)\n        )\n    def forward(self, x):\n        sar = torch.cat([x[:, 0:2, :, :], x[:, 7:8, :, :]], dim=1)\n        opt = torch.cat([x[:, 2:7, :, :], x[:, 8:10, :, :]], dim=1)\n        f = torch.cat([self.sar_encoder(sar), self.opt_encoder(opt)], dim=1)\n        if self.use_cbam: f = self.cbam(f)\n        return self.head(f)\n\n# ============================================================\n# EVALUATION & PLOTTING LOGIC\n# ============================================================\n\ndef plot_confusion_matrix(TP, TN, FP, FN, save_path=\"flooding_confusion_matrix.png\"):\n    \"\"\"Plots and saves a professional confusion matrix matching your report style.\"\"\"\n    cm = np.array([[TN, FP], [FN, TP]])\n    \n    plt.figure(figsize=(6, 5))\n    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', cbar_kws={'label': 'Pixel Count'},\n                xticklabels=['Non-Flood (0)', 'Flood (1)'], \n                yticklabels=['Non-Flood (0)', 'Flood (1)'])\n    \n    plt.title('Confusion Matrix: Binary Flooding Detection', fontsize=14, pad=15)\n    plt.ylabel('True Label', fontsize=12)\n    plt.xlabel('Predicted Label', fontsize=12)\n    plt.tight_layout()\n    plt.savefig(save_path, dpi=300)\n    print(f\"\\n[+] Confusion matrix saved successfully as '{save_path}'\")\n    plt.show()\n\n@torch.no_grad()\ndef main():\n    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n    print(f\"Using device: {device}\")\n    \n    # 1. Load Data\n    test_df = get_test_set()\n    dataset = FloodDataset(test_df, Config.FEATURES_DIR, Config.MASKS_DIR)\n    test_loader = DataLoader(dataset, batch_size=Config.BATCH_SIZE, shuffle=False, num_workers=Config.NUM_WORKERS)\n    \n    # 2. Load Model Safely\n    model = DualStreamUNetPP(use_cbam=True).to(device)\n    state_dict = torch.load(Config.MODEL_PATH, map_location=device)\n    \n    cleaned_state_dict = {}\n    for k, v in state_dict.items():\n        name = k.replace(\"module.\", \"\") if k.startswith(\"module.\") else k\n        cleaned_state_dict[name] = v\n        \n    model.load_state_dict(cleaned_state_dict)\n    model.eval()\n    \n    # 3. Run Inference\n    all_probs, all_targets = [], []\n    for x, y in tqdm(test_loader, desc=\"Evaluating Flooding Model\"):\n        x = x.to(device, non_blocking=True)\n        with torch.amp.autocast(\"cuda\"):\n            logits = model(x)\n        \n        all_probs.append(torch.sigmoid(logits).squeeze(1).cpu())\n        all_targets.append(y.cpu())\n        \n        del x, logits\n        torch.cuda.empty_cache()\n        \n    probs = torch.cat(all_probs).view(-1)\n    targets = torch.cat(all_targets).view(-1)\n    \n    # Filter out ignore index (-1)\n    valid = targets != Config.IGNORE_INDEX\n    probs = probs[valid]\n    targets = targets[valid].long()\n    \n    # 4. Sweep for Best Threshold\n    best_f1, best_thresh = 0.0, 0.5\n    best_metrics = {}\n    \n    print(\"\\nSweeping thresholds for optimal F1-Score...\")\n    for thresh in Config.THRESH_SWEEP:\n        p = (probs > thresh).long()\n        TP = ((p == 1) & (targets == 1)).sum().item()\n        TN = ((p == 0) & (targets == 0)).sum().item()\n        FP = ((p == 1) & (targets == 0)).sum().item()\n        FN = ((p == 0) & (targets == 1)).sum().item()\n        \n        eps = 1e-8\n        prec = TP / (TP + FP + eps)\n        rec = TP / (TP + FN + eps)\n        f1 = 2 * prec * rec / (prec + rec + eps)\n        \n        if f1 > best_f1:\n            best_f1 = f1\n            best_thresh = thresh\n            best_metrics = {'TP': TP, 'TN': TN, 'FP': FP, 'FN': FN, \n                            'Precision': prec, 'Recall': rec, 'F1': f1, \n                            'Accuracy': (TP + TN) / (TP + TN + FP + FN + eps),\n                            'IoU': TP / (TP + FP + FN + eps)}\n\n    # 5. Print Results & Plot\n    print(\"\\n\" + \"=\"*50)\n    print(\"FLOODING MODEL EVALUATION RESULTS\")\n    print(\"=\"*50)\n    print(f\"Optimal Threshold : {best_thresh:.2f}\")\n    print(f\"Accuracy          : {best_metrics['Accuracy']:.4f}\")\n    print(f\"Precision         : {best_metrics['Precision']:.4f}\")\n    print(f\"Recall            : {best_metrics['Recall']:.4f}\")\n    print(f\"F1-Score          : {best_metrics['F1']:.4f}\")\n    print(f\"IoU               : {best_metrics['IoU']:.4f}\")\n    print(\"=\"*50)\n    \n    plot_confusion_matrix(best_metrics['TP'], best_metrics['TN'], \n                          best_metrics['FP'], best_metrics['FN'])\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T11:23:46.776557Z","iopub.execute_input":"2026-07-27T11:23:46.777097Z","iopub.status.idle":"2026-07-27T11:24:06.782493Z","shell.execute_reply.started":"2026-07-27T11:23:46.777063Z","shell.execute_reply":"2026-07-27T11:24:06.781719Z"}},"outputs":[{"name":"stdout","text":"Using device: cuda\n","output_type":"stream"},{"name":"stderr","text":"Evaluating Flooding Model: 100%|██████████| 27/27 [00:12<00:00,  2.20it/s]\n","output_type":"stream"},{"name":"stdout","text":"\nSweeping thresholds for optimal F1-Score...\n\n==================================================\nFLOODING MODEL EVALUATION RESULTS\n==============================